blications.europa.eu\/resource\/authority\/file-type\/HTML","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2023-10-24T12:50:35+00:00","downloadURL":"https:\/\/data.eco-counter.com\/ParcPublic\/?id=677#","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Fahrradverkehrsdaten K\u00f6ln 2015","dctModified":"2025-11-18T08:10:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EMonatsgenaue Daten der\u0026nbsp;Dauerz\u00e4hlstellen f\u00fcr Radverkehr in K\u00f6ln f\u00fcr das Jahr 2015.\u003C\/p\u003E","dctIssued":"2023-02-21T15:11:52+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Radverkehr%2520f%25C3%25BCr%2520Offene%2520Daten%2520K%25C3%25B6ln%25202015.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","hasEmail":"mailto:fahrradbeauftragter@stadt-koeln.de"}],"dctIssued":"2024-05-16T07:31:39+00:00","dctModified":"2025-11-27T15:02:56+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}]},{"identifier":"a7cf082c-c0e2-41a9-8478-962a77d4c7e9","title":"Obdachlose Personen insgesamt nach Grund der Obdachlosigkeit (bis 2006)","description":"\u003Cp\u003EObdachlose Personen insgesamt nach Grund der Obdachlosigkeit.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12911-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12911-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EObdachlosigkeit\u003C\/p\u003E\n\u003Cp\u003E1. Obdachlos im Sinne dieser Erhebung ist,\u003Cbr \/\u003E\n- wer ohne Unterkunft ist,\u003Cbr \/\u003E\n- wem der Verlust seiner st\u00e4ndigen oder vor\u00fcbergehenden\u003Cbr \/\u003E\nUnterkunft unmittelbar bevorsteht,\u003Cbr \/\u003E\n- wessen Unterkunft nach objektiven Anforderungen derart\u003Cbr \/\u003E\nunzureichend ist, dass sie keinen menschenw\u00fcrdigen Schutz\u003Cbr \/\u003E\nvor den Unbilden der Witterung bietet oder bei Benutzung\u003Cbr \/\u003E\nmit Gefahren verbunden ist und\u003Cbr \/\u003E\n- wer dabei nach seinen Einkommens-, Verm\u00f6gens- oder\u003Cbr \/\u003E\nFamilienverh\u00e4ltnissen sowie aus sonstigen Gr\u00fcnden nicht in\u003Cbr \/\u003E\nder Lage ist, sich und seinen engsten Angeh\u00f6rigen, mit\u003Cbr \/\u003E\ndenen er gew\u00f6hnlich zusammenlebt (Ehegatte, Kinder), aus\u003Cbr \/\u003E\neigenen Kr\u00e4ften eine Unterkunft zu beschaffen.\u003C\/p\u003E\n\u003Cp\u003E2. Obdachlos ist auch, wer ohne eine Wohnung zu haben,\u003Cbr \/\u003E\nin der vor\u00fcbergehenden Unterbringung dienenden (Not-)Unter-\u003Cbr \/\u003E\nk\u00fcnften der \u00f6ffentlichen Hand untergebracht oder aufgrund\u003Cbr \/\u003E\ndes \u0026amp;sect; 19 OBG in eine Normalwohnung eingewiesen worden\u003Cbr \/\u003E\nist.\u003C\/p\u003E\n\u003Cp\u003E3. Obdachlos im Sinne dieser Erhebung ist nicht,\u003Cbr \/\u003E\n- wer nicht sesshaft ist und nach seiner Lebensart auch\u003Cbr \/\u003E\nkeine Anzeichen f\u00fcr eine k\u00fcnftige Sesshaftigkeit erken-\u003Cbr \/\u003E\nnen l\u00e4sst,\u003Cbr \/\u003E\n- wer unter einem Wohnungsnotstand leidet, weil er auf-\u003Cbr \/\u003E\ngrund seines Gesundheitszustandes, seines Alters oder\u003Cbr \/\u003E\nanderer Umst\u00e4nde in Verbindung mit seiner Mittellosig-\u003Cbr \/\u003E\nkeit in den von ihm bewohnten R\u00e4umen unzureichend\u003Cbr \/\u003E\nuntergebracht ist,\u003Cbr \/\u003E\n- wer sich um politisches Asyl in der Bundesrepublik\u003Cbr \/\u003E\nDeutschland bewirbt,\u003Cbr \/\u003E\n- wer als Aussiedler vor\u00fcbergehend untergebracht ist.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Obdachlose Personen insgesamt nach Grund der Obdachlosigkeit XML","dctModified":"2025-11-10T13:17:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-15T13:51:43+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12911-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Obdachlose Personen insgesamt nach Grund der Obdachlosigkeit CSV","dctModified":"2025-11-10T13:16:04+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-15T13:52:06+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12911-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Obdachlose Personen insgesamt nach Grund der Obdachlosigkeit XLSX","dctModified":"2025-11-10T13:16:38+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-15T13:52:37+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12911-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12911-02d"],"adms:Identifier":[{"title":"12911-02d"}],"dctIssued":"2024-05-15T15:50:48+02:00","dctModified":"2025-11-27T15:52:53+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"783772dc-dc95-40c8-a7fc-52ba7e5b9bf8","title":"Einb\u00fcrgerungen von Ausl\u00e4ndern (Jahr 2000 - 2023)","description":"\u003Cp\u003EEinb\u00fcrgerungen von Ausl\u00e4ndern.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12511-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Einb\u00fcrgerungsstatistik weist j\u00e4hrlich die Zahl der\u003Cbr \/\u003E\neingeb\u00fcrgerten Personen u. a. nach Alter, Geschlecht,\u003Cbr \/\u003E\nbisheriger Staatsangeh\u00f6rigkeit und Aufenthaltsdauer nach.\u003Cbr \/\u003E\nErmittelt werden die Daten von den Einb\u00fcrgerungsbeh\u00f6rden.\u003Cbr \/\u003E\nDer regionale Nachweis der Einb\u00fcrgerungsf\u00e4lle bezieht sich\u003Cbr \/\u003E\nauf den Wohnort der eingeb\u00fcrgerten Person zum Zeitpunkt der\u003Cbr \/\u003E\nEinb\u00fcrgerung. Die Statistik bezieht sich auf diejenigen\u003Cbr \/\u003E\nPersonen, die im Laufe des Berichtsjahres die deutsche\u003Cbr \/\u003E\nStaatsb\u00fcrgerschaft durch die Einb\u00fcrgerung erworben haben.\u003Cbr \/\u003E\nDer Erwerb der deutschen Staatsangeh\u00f6rigkeit durch Geburt\u003Cbr \/\u003E\nvon im Inland geborenen Kindern ausl\u00e4ndischer Eltern (nach \u00a7\u003Cbr \/\u003E\n4 Abs. 3 StAG) ist in den Daten nicht enthalten. Die\u003Cbr \/\u003E\nErgebnisse werden j\u00e4hrlich bis auf Gemeindeebene zur\u003Cbr \/\u003E\nVerf\u00fcgung gestellt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Einb\u00fcrgerungen von Ausl\u00e4ndern XML","dctModified":"2025-11-05T15:46:22+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-15T13:29:25+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12511-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Einb\u00fcrgerungen von Ausl\u00e4ndern CSV","dctModified":"2025-11-05T15:45:44+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-15T13:30:00+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12511-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Einb\u00fcrgerungen von Ausl\u00e4ndern XLSX","dctModified":"2025-11-05T15:46:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-15T13:30:29+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12511-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12511-01i"],"adms:Identifier":[{"title":"12511-01i"}],"dctIssued":"2024-05-15T15:28:12+02:00","dctModified":"2025-11-27T15:53:14+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"dec73dac-c132-4787-8f14-b0e8d27d1854","title":"Lebendgeborene, Gestorbene, Zu-\/Fortgezogene nach Geschlecht Monat (ab 2000)","description":"\u003Cp\u003ELebendgeborene, Gestorbene, Zu-\/Fortgezogene nach Geschlecht Monat (ab 2000)\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12491-33iz\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12491-33d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EZur Bev\u00f6lkerung z\u00e4hlen grunds\u00e4tzlich alle nach den\u003Cbr \/\u003E\nmelderechtlichen Regelungen erfassten meldepflichtigen\u003Cbr \/\u003E\nPersonen. Die Z\u00e4hlung erfolgt seit 1983 in der Gemeinde, in\u003Cbr \/\u003E\nder die alleinige oder Hauptwohnung der meldepflichtigen\u003Cbr \/\u003E\nPerson liegt. Bei dem heute nicht mehr verwendeten Begriff\u003Cbr \/\u003E\nder Wohnbev\u00f6lkerung wurden bis zum Jahr 1982 die Einwohner\u003Cbr \/\u003E\nan dem Ort gez\u00e4hlt, an dem sie ihren \u00fcberwiegenden\u003Cbr \/\u003E\nAufenthalt hatten. Die Frage, ob es sich dabei um die Haupt-\u003Cbr \/\u003E\noder Nebenwohnung gehandelt hat, war hier nicht ma\u00dfgebend.\u003C\/p\u003E\n\u003Cp\u003E\nDie Bev\u00f6lkerungsfortschreibung weist die Zahl und die\u003Cbr \/\u003E\nZusammensetzung der Bev\u00f6lkerung (Geschlecht, Alter,\u003Cbr \/\u003E\nFamilienstand und Staatsangeh\u00f6rigkeit) sowie ihre\u003Cbr \/\u003E\nVer\u00e4nderungen nach. Monatlich wird eine Bilanzierung der von\u003Cbr \/\u003E\nden Standes\u00e4mtern gemeldeten Geburten (+) und Sterbef\u00e4lle\u003Cbr \/\u003E\n(-) sowie der von den Meldebeh\u00f6rden gemeldeten Zuz\u00fcge (+)\u003Cbr \/\u003E\nund Fortz\u00fcge (-) durchgef\u00fchrt, um damit die neuen\u003Cbr \/\u003E\nBev\u00f6lkerungszahlen zu ermitteln. Den Startpunkt der\u003Cbr \/\u003E\nBerechnung bildet die jeweils letzte Volksz\u00e4hlung bzw. der\u003Cbr \/\u003E\nletzte Zensus. Ferner werden Staatsangeh\u00f6rigkeitswechsel,\u003Cbr \/\u003E\nInformationen zum Nachweis des Familienstandes,\u003Cbr \/\u003E\nGebiets\u00e4nderungen sowie sonstige Bestandskorrekturen\u003Cbr \/\u003E\nber\u00fccksichtigt. F\u00fcr die Merkmale Geschlecht, Alter und\u003Cbr \/\u003E\nStaatsangeh\u00f6rigkeit (deutsch\/nicht-deutsch) liegen die\u003Cbr \/\u003E\nAngaben bis auf Gemeindeebene vor. Der Familienstand wird\u003Cbr \/\u003E\nbis zur Kreisebene ermittelt. Ergebnisse nach Geschlecht\u003Cbr \/\u003E\nwerden monatlich und nach den \u00fcbrigen Merkmalen j\u00e4hrlich zur\u003Cbr \/\u003E\nVerf\u00fcgung gestellt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Lebendgeborene, Gestorbene, Zu-\/Fortgezogene nach Geschlecht XML","dctModified":"2025-11-05T15:32:49+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-15T13:07:42+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12491-33i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Lebendgeborene, Gestorbene, Zu-\/Fortgezogene nach Geschlecht CSV","dctModified":"2025-11-05T15:32:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-15T13:08:31+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12491-33i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Lebendgeborene, Gestorbene, Zu-\/Fortgezogene nach Geschlecht XLSX","dctModified":"2025-11-05T15:32:32+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-15T13:09:12+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12491-33i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12491-33iz"],"adms:Identifier":[{"title":"12491-33iz"}],"dctIssued":"2024-05-15T15:04:26+02:00","dctModified":"2025-11-27T15:52:23+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"3c992f2b-2eff-41d7-aaea-9e40c9cbdbfd","title":"Pflegemodellrechnung 2021-2050: Pflegebed\u00fcrftige nach Art der Pflegeleistung und Geschlecht","description":"\u003Cp\u003EPflegemodellrechnung 2021-2050: Pflegebed\u00fcrftige nach Art\u003Cbr \/\u003E\nder Pflegeleistung und Geschlecht.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12421-34i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12421-34i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Bev\u00f6lkerungsvorausberechnung zeigt Entwicklungspfade f\u00fcr die zuk\u00fcnftige Entwicklung der Bev\u00f6lkerungszahl und -struktur auf. Auf der regionalen Ebene reicht der Berechnungshorizont bis zum Jahr 2050. Basis der vorliegenden Bev\u00f6lkerungsvorausberechnung ist der Bev\u00f6lkerungsstand zum 01.01.2021. Bei den Vorausberechnungen wurde die Kohorten-Komponente-Methode angewandt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Pflegemodellrechnung 2021-2050: Pflegebed\u00fcrftige nach Art der Pflegeleistung und Geschlecht XML","dctModified":"2025-11-05T15:28:34+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-15T12:51:36+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-34i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Pflegemodellrechnung 2021-2050: Pflegebed\u00fcrftige nach Art der Pflegeleistung und Geschlecht csv","dctModified":"2025-11-05T15:30:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-15T12:52:29+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.