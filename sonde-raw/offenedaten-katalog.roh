en und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Wohnungen in Wohn- und Nichtwohngeb\u00e4uden nach Anzahl der R\u00e4ume XML","dctModified":"2025-11-17T10:40:01+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T11:38:46+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31231-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Wohnungen in Wohn- und Nichtwohngeb\u00e4uden nach Anzahl der R\u00e4ume CSV","dctModified":"2025-11-17T10:39:07+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T11:39:06+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31231-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Wohnungen in Wohn- und Nichtwohngeb\u00e4uden nach Anzahl der R\u00e4ume XLSX","dctModified":"2025-11-17T10:39:32+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-12T11:39:31+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31231-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["31231-01d"],"adms:Identifier":[{"title":"31231-01d"}],"dctIssued":"2024-06-12T13:38:09+02:00","dctModified":"2025-11-27T15:54:27+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"c374d25c-a5a7-4df9-b9ff-337503010590","title":"Baufertigstellungen (Neubau): Art des Wohngeb\u00e4udes,Wohnungen in Wohngeb\u00e4uden, Nichtwohngeb\u00e4uden; Neubau und Bauma\u00dfnahmen","description":"\u003Cp\u003EBaufertigstellungen (Neubau): Art des Wohngeb\u00e4udes,Wohnungen in Wohngeb\u00e4uden, Nichtwohngeb\u00e4ude; Neubau und Bauma\u00dfnahmen.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=31121-11d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Statistik der Baufertigstellungen gibt Auskunft \u00fcber\u003Cbr \/\u003E\nalle fertig gestellten Bauvorhaben. Zum j\u00e4hrlichen\u003Cbr \/\u003E\nErhebungsprogramm geh\u00f6ren u. a. Angaben zur Art und Gr\u00f6\u00dfe\u003Cbr \/\u003E\ndes Geb\u00e4udes, Art der Baut\u00e4tigkeit, Heizungsart und\u003Cbr \/\u003E\nHeizenergie sowie veranschlagte Baukosten.\u003Cbr \/\u003E\nAb dem Jahr 2014 werden zus\u00e4tzlich Angaben zur Energie der\u003Cbr \/\u003E\nWarmwasserbereitung und nach dem EEW\u00e4rmeG ausgewiesen.\u003Cbr \/\u003E\nDie Datenbereitstellung erfolgt \u00fcber die Bau\u00e4mter.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nGemeinden.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"admsIdentifier":["31121-11d"],"adms:Identifier":[{"title":"31121-11d"}],"dctIssued":"2024-06-12T11:48:28+02:00","dctModified":"2025-11-27T15:50:23+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"57f91132-1574-49d3-ba4b-f58067db9f3c","title":"Baugenehmigungen (Neubau): Art des Wohngeb\u00e4udes, Wohnungen in Wohngeb\u00e4uden, Nichtwohngeb\u00e4uden; Neubau und Bauma\u00dfnahmen:","description":"\u003Cp\u003EBaugenehmigungen (Neubau): Art des Wohngeb\u00e4udes, Wohnungen\u003Cbr \/\u003E\nin Wohngeb\u00e4uden, Nichtwohngeb\u00e4ude; Neubau und Bauma\u00dfnahmen:.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=31111-11d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Statistik der Baugenehmigungen gibt Auskunft \u00fcber die\u003Cbr \/\u003E\nGenehmigung von genehmigungspflichtigen und ihnen\u003Cbr \/\u003E\ngleichgestellten Bauvorhaben. Zum monatlichen\u003Cbr \/\u003E\nErhebungsprogramm geh\u00f6ren u. a. Angaben zur Art und Gr\u00f6\u00dfe\u003Cbr \/\u003E\ndes Geb\u00e4udes, Art der Baut\u00e4tigkeit, Heizungsart und\u003Cbr \/\u003E\nHeizenergie sowie veranschlagte Baukosten. Seit dem Jahr\u003Cbr \/\u003E\n2012 werden zus\u00e4tzlich Angaben zur Energie der\u003Cbr \/\u003E\nWarmwasserbereitung und nach dem EEW\u00e4rmeG ausgewiesen.\u003Cbr \/\u003E\nDie Datenbereitstellung erfolgt \u00fcber die Bau\u00e4mter und\u003Cbr \/\u003E\nBauherren.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nGemeinden.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Baugenehmigungen (Neubau) XML","dctModified":"2025-11-17T08:59:24+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T09:41:03+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31111-11i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Baugenehmigungen (Neubau) CSV","dctModified":"2025-11-17T08:58:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T09:41:23+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31111-11i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Baugenehmigungen (Neubau) XLSX","dctModified":"2025-11-17T08:59:09+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-12T09:41:56+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=31111-11i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["31111-11d"],"adms:Identifier":[{"title":"31111-11d"}],"dctIssued":"2024-06-12T11:40:23+02:00","dctModified":"2025-11-27T15:51:23+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"id