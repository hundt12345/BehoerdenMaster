e":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Schiedsamtsbezirk beschriftet JSON","dctModified":"2024-10-21T15:07:15+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003ESchnittstelle zu aktuellen Daten\u003C\/p\u003E","dctIssued":"2021-11-23T07:58:00+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/basiskarten\/kgg_labeled\/MapServer\/16\/query?where=objectid_1+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;timeRelation=esriTimeRelationOverlaps\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;sqlFormat=none\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","hasEmail":"mailto:statistik-rbs@stadt-koeln.de"}],"dcatdeContributorID":[],"dctIssued":"2021-11-22T14:31:28+00:00","dctModified":"2026-09-24T09:25:03+00:00","dctRelation":[],"dcatLandingPage":[],"foafPage":[],"dctLanguage":[],"dctConformsTo":[],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/IRREG"},"provWasGeneratedBy":[],"provQualifiedAttribution":[],"dcatQualifiedRelation":[],"dctIsReferencedBy":[],"dctReferences":[],"dcathasVersion":[],"admsSample":[],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"identifier":"8b43cb5e-877d-4f12-9ec4-0347947eb37d","title":"Sperbersichtungen","description":"\u003Cp\u003E\u0026lt;p\u0026gt;\u0026amp;lt;p\u0026amp;gt;\u0026amp;amp;lt;p\u0026amp;amp;gt;Der Datensatz enth\u00e4lt  die georeferenziert Ergebnisse des Sperber-Monitorings, d.h. die georeferenziert Sichtungen von Sperbern in K\u00f6ln.\u0026amp;amp;lt;\/p\u0026amp;amp;gt;\u0026amp;lt;br \/\u0026amp;gt;\u0026lt;br \/\u0026gt;\u003Cbr \/\u003E\n\u0026amp;amp;lt;p\u0026amp;amp;gt;Mithilfe des Sperber-Monitorings m\u00f6chten die Stadt K\u00f6ln in Zusammenarbeit mit den B\u00fcrger:innen K\u00f6lns, Hinweise \u00fcber den Sperber und seine Bruterfolge ermitteln, um bei negativen Entwicklungen Schutzma\u00dfnahmen ergreifen zu k\u00f6nnen. Die Gr\u00f6\u00dfe und die Zusammensetzung der Sperber-Best\u00e4nde k\u00f6nnen Hinweise \u00fcber den Zustand der in K\u00f6ln lebenden V\u00f6gel geben.\u0026amp;amp;lt;\/p\u0026amp;amp;gt;\u0026amp;lt;br \/\u0026amp;gt;\u0026lt;br \/\u0026gt;\u003Cbr \/\u003E\n\u0026amp;amp;lt;p\u0026amp;amp;gt;Mehr zur Sperberkartierung, gibt es unter \u0026amp;amp;lt;a href=\u0026amp;amp;quot;\u0026amp;lt;a href=\u0026amp;quot;\u0026lt;a href=\u0022\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/leben-in-koeln\/umwelt-tiere\/sperberkartierung\/index.html\u0026amp;amp;quot;\u0026amp;amp;gt;https:\/\/www.stadt-koeln.de\/leben-in-koeln\/umwelt-tiere\/sperberkartierung...\u0026amp;amp;lt;\/a\u0026amp;amp;gt;\u0026amp;amp;lt;br\u0026amp;quot;\u0026amp;gt;https:\/\/www.stadt-koeln.de\/leben-in-koeln\/umwelt-tiere\/sperberkartierung...\u0026amp;lt;\/a\u0026amp;gt;\u0022\u003Ehttps:\/\/www.stadt-koeln.de\/leben-in-koeln\/umwelt-tiere\/sperberkartierung...\u003C\/a\u003E \/\u0026amp;amp;gt;\u0026amp;lt;br \/\u0026amp;gt;\u0026lt;br \/\u0026gt;\u003Cbr \/\u003E\nZur Anwendung, zwecks aktiver Teilnahme am Sperber-Monitoring geht es hier: \u0026amp;amp;lt;a href=\u0026amp;amp;quot;\u0026amp;lt;a href=\u0026amp;quot;\u0026lt;a href=\u0022\u003Ca href=\u0022https:\/\/cpoint.stadt-koeln.de\/mapapps\/resources\/apps\/sperberkartierung\/index.html?lang=de\u0026amp;amp;quot;\u0026amp;amp;gt;https:\/\/cpoint.stadt-koeln.de\/mapapps\/resources\/apps\/sperberkartierung\/i...\u0026amp;amp;lt;\/a\u0026amp;amp;gt;\u0026amp;amp;lt;\/p\u0026amp;amp;gt;\u0026amp;quot;\u0026amp;gt;https:\/\/cpoint.stadt-koeln.de\/mapapps\/resources\/apps\/sperberkartierung\/i...\u0026amp;lt;\/a\u0026amp;gt;\u0026amp;lt;\/p\u0026amp;gt;\u0022\u003Ehttps:\/\/cpoint.stadt-koeln.de\/mapapps\/resources\/apps\/sperberkartierung\/i...\u003C\/a\u003E\u003C\/p\u003E\n","keyword":["Geo"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/ENVI"}],"contactPoint":[{"fn":"Umwelt- und Verbraucherschutzamt Stadt K\u00f6ln","hasEmail":"umwelt-verbraucherschutz@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Sperbersichtungen Stadtteile K\u00f6ln","dctModified":"2022-07-26T11:04:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dctIssued":"2021-10-27T10:58:18+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/klima_umwelt_tiere\/sperber\/MapServer\/2\/query?where=objectid+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=pjson","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"}],"dctIssued":"2021-10-27T12:54:01+02:00","dctModified":"2025-11-19T11:23:18+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"dctCreator":[{"foaf_name":"Amt f\u00fcr Umwelt- und Verbraucherschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/umwelt-und-verbraucherschutzamt"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Umwelt- und Verbraucherschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/umwelt-und-verbraucherschutzamt"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Umwelt- und Verbraucherschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/umwelt-und-verbraucherschutzamt"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Umwelt- und Verbraucherschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/umwelt-und-verbraucherschutzamt"}]},{"type":"dcat:Dataset","title":"Bundestagswahl 2021 K\u00f6ln","identifier":"f756addd-9751-413f-83e7-12515176fbc4","description":"\u003Cp\u003EDer Datensatz enth\u00e4lt die Ergebnispr\u00e4sentation zur\u00a0 Deutschen Bundestagswahl 2021 in K\u00f6ln.\u003C\/p\u003E\u003Cp\u003EEs werden mehrere CSV-Schnittstellen zur Abfrage von Ergebnissen der Bundestagswahl 2021 sowie Informationen zu Wahllokalen und ein Stra\u00dfen-Verzeichnis als Open Data zur Verf\u00fcgung gestellt.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDas K\u00f6lner Stadtgebiet ist in drei Wahlkreise eingeteilt. Ein vierter Wahlkreis, der teilweise zu unserem Stadtgebiet geh\u00f6rt, ist der Stadt Leverkusen zugeordnet. Diese Wahlkreise gliedern sich wie folgt auf:\u003C\/p\u003E\u003Cp\u003EWahlkreis 93 \u2013 K\u00f6ln I\u003C\/p\u003E\u003Cp\u003EStadtbezirke Porz und Kalk sowie vom Stadtbezirk Innenstadt die Stadtteile Deutz, Altstadt\/Nord sowie Neustadt\/Nord\u003C\/p\u003E\u003Cp\u003EWahlkreis 94 \u2013 K\u00f6ln II\u003C\/p\u003E\u003Cp\u003EStadtbezirke Lindenthal und Rodenkirchen sowie vom Stadtbezirk Innenstadt die Stadtteile Altstadt\/S\u00fcd sowie Neustadt\/S\u00fcd\u003C\/p\u003E\u003Cp\u003EWahlkreis 95 \u2013 K\u00f6ln III\u003C\/p\u003E\u003Cp\u003EStadtbezirke Chorweiler, Ehrenfeld und Nippes\u003C\/p\u003E\u003Cp\u003EWahlkreis 101 \u2013 Leverkusen-K\u00f6ln IV\u003C\/p\u003E\u003Cp\u003EStadtbezirk M\u00fclheim und das Stadtgebiet Leverkusen\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDie 543 Wahlbezirke sind die kleinste wahlorganisatorische Einheit. Sie basieren auf der jeweiligen Einwohnerzahl. Jeder Wahlbezirk ist eindeutig einem Stadtteil zugeordnet.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDie Ergebnisse der Wahlkreise werden bereits am Wahlabend laufend aktualisiert und k\u00f6nnen in einem standartisierten Format vom Web-Server der Stadt K\u00f6ln aus dem Votemanger abgerufen werden.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Politik und Wahlen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/GOVE"}],"distribution":[{"type":"dcat:Distribution","title":"Bundestagswahl 2021 in K\u00f6ln","dctModified":"2022-07-26T11:32:20+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EIn der Internet-Pr\u00e4sentation werden Wahlergebnisse, sowie - bei St\u00e4dten und Gemeinden - Informationen zu Wahllokalen und ein Stra\u00dfen-Verzeichnis als Open Data zur Verf\u00fcgung gestellt.\u003C\/p\u003E\u003Cp\u003EDie Dateien sind in UTF-8 codiert. Wenn Sie diese mit Excel \u00f6ffnen wollen, zeigt dies standardm\u00e4\u00dfig die Umlaute in den Dateien nicht korrekt an. Dies k\u00f6nnen Sie wie folgt umgehen:\u003C\/p\u003E\u003Cp\u003EExcel 2003\u003Cbr\u003EW\u00e4hlen Sie \u00fcber das Men\u00fc \u0027Daten\u0027 -\u0026gt; \u0027Externe Daten importieren\u0027 den Men\u00fcpunkt \u0027Daten importieren\u0027 aus. Es \u00f6ffnet sich der Dialog \u0027Datenquelle ausw\u00e4hlen\u0027. W\u00e4hlen Sie hier die zu \u00f6ffnende Datei aus und bet\u00e4tigen Sie die \u0027\u00d6ffnen\u0027-Schaltfl\u00e4che. Im Anschluss legen Sie den Dateiursprung auf \u002765001 Unicode: (UTF-8)\u0027 fest und fahren mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Im n\u00e4chsten Dialog setzten Sie das Trennzeichen auf \u0027Semikolon\u0027 statt auf \u0027Tabstopp\u0027 und fahren erneut mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Anschlie\u00dfend w\u00e4hlen sie als Datenformat der Spalten die Option \u0027Text\u0027 aus und beenden den Assistenten mit der Schaltfl\u00e4ch \u0027Fertig stellen\u0027. Mit der Schaltfl\u00e4che \u0027OK\u0027 beenden Sie die Prozedur und die Daten werden UTF-8 codiert in Microsoft Excel angezeigt.\u003C\/p\u003E\u003Cp\u003EExcel 2010\u003Cbr\u003EW\u00e4hlen Sie \u00fcber die Karteikarte \u0027Daten\u0027 im Abschnitt \u0027Externe Daten abrufen\u0027 die Option \u0027Aus Text\u0027 aus. Es \u00f6ffnet sich der Dialog \u0027Textdatei importieren\u0027. W\u00e4hlen Sie hier die zu \u00f6ffnende Datei aus und bet\u00e4tigen Sie die \u0027\u00d6ffnen\u0027-Schaltfl\u00e4che. Im Anschluss legen Sie den Dateiursprung auf \u002765001 Unicode: (UTF-8)\u0027 fest und fahren mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Im n\u00e4chsten Dialog setzten Sie das Trennzeichen auf \u0027Semikolon\u0027 statt auf \u0027Tabstopp\u0027 und fahren erneut mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Anschlie\u00dfend w\u00e4hlen sie als Datenformat der Spalten die Option \u0027Text\u0027 aus und beenden den Assistenten mit der Schaltfl\u00e4che \u0027Fertig stellen\u0027. Mit der Schaltfl\u00e4che \u0027OK\u0027 beenden Sie die Prozedur und die Daten werden UTF-8 codiert in Microsoft Excel angezeigt.\u003C\/p\u003E","dctIssued":"2021-09-27T05:45:35+00:00","downloadURL":"https:\/\/www.stadt-koeln.de\/wahlen\/bundestagswahl\/09-2021\/praesentation\/opendata.html","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"}],"contactPoint":[{"type":"vcard:Contact","fn":"Wahlamt der Stadt K\u00f6ln","hasEmail":"mailto:wahlamt@stadt-koeln.de"}],"dctIssued":"2021-09-27T05:43:33+00:00","dctModified":"2025-11-09T11:28:15+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dctContributor":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}]},{"type":"dcat:Dataset","title":"Gefahrgutstrecken in K\u00f6ln","identifier":"d7bbabaf-4dab-43d2-b391-40d86df05efd","description":"\u003Cp\u003E\u00a0Gefahrgutstrecken in K\u00f6ln\u003C\/p\u003E\u003Cp\u003EFelder:\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003Eobjectid\u00a0( type: esriFieldTypeOID, alias: OBJECTID )\u003C\/li\u003E\u003Cli\u003Estrab_k_id\u00a0( type: esriFieldTypeDouble, alias: Stra\u00dfenabschnitt K ID )\u003C\/l