S_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2022-08-10T12:28:42+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/services\/gesellschaft_soziales_wohnen\/interkulturelle_zentren\/MapServer\/WFSServer?request=GetCapabilities\u0026amp;service=WFS","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2022-08-10T14:18:45+02:00","dctModified":"2025-11-27T15:56:51+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"dctCreator":[{"foaf_name":"Amt f\u00fcr Integration und Vielfalt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-integration-vielfalt"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Integration und Vielfalt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-integration-vielfalt"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Integration und Vielfalt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-integration-vielfalt"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Integration und Vielfalt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-integration-vielfalt"}]},{"identifier":"519c18fd-da1f-4892-a086-a025b7baaecb","title":"Stadtplan zur Geschichte der Frauen in K\u00f6ln","description":"\u003Cp\u003EK\u00f6lner Frauen Stadtplan Zur Geschichte der Frauen in K\u00f6ln\u003Cbr \/\u003E\nIm Rahmen des Internationalen Frauentags 2022 ging der K\u00f6lner Frauen*Stadtplan online, welcher die den Nutzer*innen Informationen zu historischen und zeitgen\u00f6ssischen Frauen, Frauenorganisationen sowie frauenrelevanten Orten in K\u00f6ln bereitstellt.\u003C\/p\u003E\n\u003Cp\u003EDer K\u00f6lner Frauen*Stadtplan ist ein Kooperationsprojekt der Stiftung Frauen*leben in K\u00f6ln mit dem K\u00f6lner Frauengeschichtsverein und dem Amt f\u00fcr Gleichstellung von Frauen und M\u00e4nnern der Stadt K\u00f6ln.\u003C\/p\u003E\n\u003Cp\u003EHistorische Stadtf\u00fchrung\u003Cbr \/\u003E\nGrundlage des K\u00f6lner Frauen*Stadtplans war die Historische Stadtf\u00fchrung, die in Kooperation mit dem K\u00f6lner Frauengeschichtsverein anl\u00e4sslich des Internationalen Frauentags 2021 ins Leben gerufen wurde. Mit einem Klick auf die jeweilige Station erfahren Sie das Thema, mit Klick auf den hinterlegten Link sowie weiter unten finden Sie weiterf\u00fchrende Informationen. Der Startpunkt liegt am Hauptbahnhof, der Endpunkt am westlichen Rheinufer unterhalb der Philharmonie, vor der Hohenzollernbr\u00fccke. Die Route ist etwa 2,5 Kilometer lang.\u003C\/p\u003E\n\u003Cp\u003EUnter\u00a0 \u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/leben-in-koeln\/soziales\/gleichstellung\/stadtfuehrung-zur-geschichte-der-frauen-koeln\u0022\u003Ehttps:\/\/www.stadt-koeln.de\/leben-in-koeln\/soziales\/gleichstellung\/stadtfuehrung-zur-geschichte-der-frauen-koeln\u003C\/a\u003E kann der Frauen Stadtplan angesehen werden.\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"contactPoint":[{"fn":" Amt f\u00fcr Gleichstellung von Frauen und M\u00e4nnern Stadt K\u00f6ln ","hasEmail":"gleichstellungsamt@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Frauenorganisationen","dctModified":"2022-08-10T12:29:27+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EWeitere Informationen zum Datensatz gibt es \u003Ca href=\u0022https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/gesellschaft_soziales_wohnen\/frauenstadtplan\/MapServer\/0\u0022\u003Ehier\u003C\/a\u003E\u003C\/p\u003E\n","dctIssued":"2022-08-10T11:57:29+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/gesellschaft_soziales_wohnen\/frauenstadtplan\/MapServer\/0\/query?where=projekt_id+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026am