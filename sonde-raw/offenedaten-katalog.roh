ty\/planned-availability\/STABLE"},"description":"\u003Cp\u003EMonatsgenaue Daten der\u0026nbsp;Dauerz\u00e4hlstellen f\u00fcr Radverkehr in K\u00f6ln f\u00fcr das Jahr 2009.\u003C\/p\u003E","dctIssued":"2023-02-21T15:59:49+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Radverkehr%2520f%25C3%25BCr%2520Offene%2520Daten%2520K%25C3%25B6ln%25202009.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","hasEmail":"mailto:fahrradbeauftragter@stadt-koeln.de"}],"dctIssued":"2024-05-15T07:41:46+00:00","dctModified":"2025-11-27T15:02:56+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-nachhaltige-mobilitaetsentwicklung"}]},{"identifier":"420435c4-ea5f-4f9d-a95f-d537ba20cd9a","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2049 Lebendgeborene, Gestorbene, \u00dcberschuss der Zu- bzw. Fortgezogenen nach Geschlecht","description":"\u003Cp\u003EBev\u00f6lkerungsvorausberechnung 2021 - 2049 Lebendgeborene,\u003Cbr \/\u003E\nGestorbene, \u00dcberschuss der Zu- bzw. Fortgezogenen nach Geschlecht.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12421-04d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12421-04d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Bev\u00f6lkerungsvorausberechnung zeigt Entwicklungspfade f\u00fcr die zuk\u00fcnftige Entwicklung der Bev\u00f6lkerungszahl und -struktur auf. Auf der regionalen Ebene reicht der Berechnungshorizont bis zum Jahr 2050. Basis der vorliegenden Bev\u00f6lkerungsvorausberechnung ist der Bev\u00f6lkerungsstand zum 01.01.2021. Bei den Vorausberechnungen wurde die Kohorten-Komponente-Methode angewandt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2049 Lebendgeborene, Gestorbene, \u00dcberschuss der Zu- bzw. Fortgezogenen nach Geschlecht  XML","dctModified":"2025-11-17T08:44:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T12:15:58+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-04i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2049 Lebendgeborene, Gestorbene, \u00dcberschuss der Zu- bzw. Fortgezogenen nach Geschlecht  CSV","dctModified":"2025-11-17T08:43:05+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T12:16:58+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-04i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2049 Lebendgeborene, Gestorbene, \u00dcberschuss der Zu- bzw. Fortgezogenen nach Geschlecht  XLSX","dctModified":"2025-11-17T08:43:19+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T12:17:40+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-04i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12421-03d"],"adms:Identifier":[{"title":"12421-03d"}],"dctIssued":"2024-05-14T14:14:42+02:00","dctModified":"2025-11-27T15:51:32+01:00","dctLanguage":