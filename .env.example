# Referenz, wird NICHT automatisch geladen. Lokal exportieren; auf Render unter Environment setzen.
# Keine Zugangsdaten ins Repository schreiben. Die unten gezeigte Projekt-Kontaktadresse steht
# bewusst öffentlich im Code (behoerdenmaster/config.py: PROJEKT_KONTAKT): Sie ist keine
# Zugangsdaten, sondern die Absenderangabe im Crawler-User-Agent.
BEHOERDEN_DB=data/behoerdenmaster.sqlite
BEHOERDEN_CONFIG_DIR=config/cities

# Beispieldaten nur für den Offline-Test; auf Render ausgeschaltet.
BEHOERDEN_DEMO=false

# Automatischer Hintergrundabruf. Voreinstellung: aktiv, mit der im Repository hinterlegten
# Projekt-Kontaktadresse. "false" schaltet ab; ein leer gesetztes BEHOERDEN_KONTAKT verzichtet
# bewusst auf die Voreinstellung (dann bleibt der Abruf aus). Ohne jede Kontaktadresse meldet
# der Webdienst das in /api/status und auf der Startseite (kein Absturz, keine stille Leere).
BEHOERDEN_SYNC_ENABLED=true
BEHOERDEN_KONTAKT=behordenkontakt123@posteo.de
# Alle Quellen der Stadt Köln: Ratsinformation (OParl), öffentliche Bekanntmachungen,
# Beteiligungsliste „Meinung für Köln“ sowie die beiden RSS-Feeds. Kommagetrennte IDs.
# Reihenfolge = Abrufreihenfolge je Etappe: kleine Quellen zuerst, die große
# Ratsinformation zuletzt (siehe docs/render.md).
BEHOERDEN_SYNC_QUELLEN=koeln:bekanntmachungen,koeln:beteiligung,koeln:ris-rss,koeln:presse-rss,koeln:ris
# Erstabruf-Fenster: "90" = rollierend die letzten 90 Tage, alternativ ein festes Datum YYYY-MM-DD.
# Leer = Wert aus config/cities/<stadt>.toml.
BEHOERDEN_SYNC_SEIT=90
BEHOERDEN_SYNC_INTERVALL=21600
BEHOERDEN_SYNC_MAX_ANFRAGEN=120
# Zeitfenster je Quelle und Etappe in Sekunden (mindestens 30). Nach Ablauf wird die Quelle
# unterbrochen und beim nächsten Mal an ihrem Cursor fortgesetzt, damit eine große Quelle die
# übrigen nicht blockiert.
BEHOERDEN_SYNC_ZEITBUDGET=240
BEHOERDEN_SYNC_STARTVERZOEGERUNG=15
PORT=8000
