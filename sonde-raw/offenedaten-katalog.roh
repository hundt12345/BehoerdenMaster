dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Zentrale Vergabestelle Stadt K\u00f6ln","hasEmail":"mailto:submissionsdienst-vergabe@stadt-koeln.de"}],"dctIssued":"2015-09-24T08:51:35+00:00","dctModified":"2025-11-27T15:04:04+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}]},{"identifier":"49c5fece-d4da-4700-a4e3-535757ec1056","title":"Reanimationsregister 2014","description":"\u003Cp align=\u0022left\u0022\u003EDer K\u00f6lner Rettungsdienst nimmt am Deutschen Reanimationsregister teil. Zus\u00e4tzlich beteiligten sich die Not\u00e4rzte an der EuReCa ONE Studie des European Registry of Cardiac arrest.\u003C\/p\u003E\n\u003Cp align=\u0022left\u0022\u003EUm die Forschung im Bereich der Reanimation auf eine gemeinsame europ\u00e4ische Datenbasis zu stellen und dadurch auch langfristig das \u00dcberleben nach einem au\u00dferklinischen Herzkreislaufstillstand zu verbessern, starteten [\u2026] 27 europ\u00e4ische Nationen eine gemeinsame Studie, die EuReCaONE Studie.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Soziales"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","hasEmail":"feuerwehr@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz"},"distribution":[{"