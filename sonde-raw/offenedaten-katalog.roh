tteil, Stra\u00dfe und Hausnummer), eine Bezeichnung, das Datum des Eintrags als Denkmal gem\u00e4\u00df Nordrhein-westf\u00e4lisches Denkmalschutzgesetz (DSchG NRW) und die Denkmallistennummer.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"WFS Denkmalliste","dctModified":"2024-11-07T08:53:29+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WFS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-10-10T08:54:03+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/wss\/service\/denkmalliste_wfs\/guest?request=GetCapabilities\u0026amp;service=WFS","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"WMS Denkmalliste","dctModified":"2024-11-07T08:53:58+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WMS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-10-10T08:55:26+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/wss\/service\/denkmalliste_wms\/guest?request=GetCapabilities\u0026amp;service=WMS","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Geoportal Stadt K\u00f6ln ","hasEmail":"mailto:cc-gis@stadt-koeln.de"}],"dctIssued":"2024-10-10T08:47:40+00:00","dctModified":"2025-11-27T14:55:32+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[{"dct_standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Denkmalschutz und Denkmalpflege","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtkonservator-amt-fuer-denkmalschutz-denkmalpflege"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Denkmalschutz und Denkmalpflege","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtkonservator-amt-fuer-denkmalschutz-denkmalpflege"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Denkmalschutz und Denkmalpflege","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtkonservator-amt-fuer-denkmalschutz-denkmalpflege"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Denkmalschutz und Denkmalpflege","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtkonservator-amt-fuer-denkmalschutz-denkmalpflege"}]},{"identifier":"e09044c1-fb75-4b33-90bb-b2b07dd5d70d","title":"Sponsoring-Daten 2023","description":"\u003Cp\u003EDie im Jahr 2023 \u00fcberarbeitete und neu formulierte Sponsoringrichtlinie regelt die allgemeinen Rahmenbedingungen f\u00fcr Sponsoringleistungen im Bereich der Stadtverwaltung K\u00f6ln und sieht eine j\u00e4hrliche Berichterstattung \u00fcber Sponsoringvertr\u00e4ge vor.\u003C\/p\u003E\n\u003Cp\u003EDer hiesige\u00a0Datensatz enth\u00e4lt Informationen zu den Sponsoren, der Art der von Ihnen bereitgestellten\u00a0Leistung sowie zur gef\u00f6rderten Verwaltungsma\u00dfnahme.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"temporalmigrate":{"type":"dct:PeriodOfTime"},"distribution":[{"type":"dcat:Distribution","title":"Sponsoringbericht Stadt K\u00f6ln 2023","dctModified":"2024-10-09T14:54:15+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-10-09T14:50:53+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Sponsoringbericht%2520Stadt%2520K%25C3%25B6ln%25202023_0.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/2.0\/spec\/"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-10-09T16:33:24+02:00","dctModified":"2025-11-27T16:07:38+01:00"},{"identifier":"fa1786d1-e142-45cc-9df0-fa27270c5d0f","title":"Vornamen 2023","description":"\u003Cp\u003EEine Auflistung aller f\u00fcr die jeweiligen Jahre vergebenen Vornamen. Der Datensatz wird sukzessive um vergangene und zuk\u00fcnftige Jahre erweitert.\u003Cbr \/\u003E\nDie Spalte Anzahl beschreibt, wie oft der Name im jeweiligen Jahr vergeben wurde.\u003C\/p\u003E\n\u003Cp\u003EDie Datenressource Vornamen 2023 enth\u00e4lt das Parameter \u0027Namensposition\u0027, d.h. ob es sich bei dem Namen um den Erstnamen oder Zweitnamen handelt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"temporalmigrate":{"type":"dct:PeriodOfTime"},"distribution":[{"type":"dcat:Distribution","title":"Vornamenstatistik 2023","dctModified":"2024-08-15T10:52:59+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-08-15T10:52:59+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Vornamenstatistik_2023.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-08-15T12:50:12+02:00","dctModified":"2025-11-09T11:57:01+01:00"},{"type":"dcat:Dataset","title":"Strukturdatenerhebung","identifier":"8da2f1a1-df86-4b68-a19c-20c2083a8a05","description":"\u003Cp\u003EDie Strukturdatenerhebung 2023 der Stadt K\u00f6ln ermittelt planungs- und steuerungsrelevante Strukturinformationen zur K\u00f6lner Bev\u00f6lkerung und zu den K\u00f6lner Haushalten, die aus im Verwaltungsvollzug und amtlich vorliegenden Daten nicht entnommen werden k\u00f6nnen.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EMethodologie\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EErhebungszeitraum:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E15.05.2023 bis 3.7.2023\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EUntersuchungsgebiet:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EK\u00f6lner Stadtgebiet\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EGrundgesamtheit:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EPersonen (Deutsche und Ausl\u00e4nder*innen) mit Wohnort im K\u00f6lner Stadtgebiet, die zum Zeitpunkt der Stichprobenziehung (M\u00e4rz 2023) in Privathaushalten lebten (Haupt- und Nebenwohnsitz) und zwischen 18 und 80 Jahre alt waren (ohne Heimbewohner*innen).\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EAuswahlverfahren:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EWahrscheinlichkeitsauswahl - Proportional geschichtete Zufallsauswahl\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EZeitliches Forschungsdesign:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EQuerschnitt\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EErhebungsmodus:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003ESelbstausf\u00fcller: CAWI (Computerunterst\u00fctztes Web-Interview) | Selbstausf\u00fcller: Papier\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EWeitere Hinweise:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDie Daten werden ungewichtet zur Verf\u00fcgung gestellt. Vor der Analyse m\u00fcssen die Daten entweder personen- oder haushaltsgewichtet werden (siehe hierzu Dokument \u0022\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistik-umfragen\/strukturdatenerhebung_2023_methodendokumentation.pdf\u0022\u003EStrukturdatenerhebung in Koeln 2023 - Methodenbericht\u003C\/a\u003E\u0022, S. 22ff.)\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EDer Datensatz ist im Portal der GESIS - Leibniz-Institut f\u00fcr Sozialwissenschaften ver\u00f6ffentlicht.\u00a0Die Daten sind unter eingeschr\u00e4nktem Zugang verf\u00fcgbar, um einen verantwortungsvollen Umgang mit den teilweise sensiblen Umfragedaten sicherzustellen.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003E\u0022Eingeschr\u00e4nkter Zugang: \u003C\/strong\u003EDie Forschungsdaten sind nur eingeschr\u00e4nkt verf\u00fcgbar. W\u00fcnschen Nutzende einen Zugang zu Forschungsdaten mit dieser Zugangsklasse, m\u00fcssen sie die Zustimmung der Datengebenden einholen. GESIS holt dazu schriftlich die Genehmigung unter Angabe des Benutzers*der Benutzerin und des Auswertungszweckes ein.\u0022\u00a0(siehe\u00a0GESIS\u00a0\u003Ca href=\u0022https:\/\/data.gesis.org\/sharing\/#!TermsOfUse\u0022\u003ENutzungsbedingungen\u003C\/a\u003E)\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen","Soziales"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"distribution":[{"type":"dcat:Distribution","title":"Link zum Datensatz im GESIS-Portal ","dctModified":"2025-10-01T06:16:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/HTML","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-07-15T11:05:05+00:00","downloadURL":"https:\/\/search.gesis.org\/research_data\/SDN-10.7802-2706","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/by-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Stadtentwicklung und Statistik - Berichte, Analysen, Umfragen","hasEmail":"mailto:umfragen@stadt-koeln.de"}],"dctIssued":"2024-07-15T10:59:47+00:00","dctModified":"2025-11-27T15:06:49+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[{"dct_standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Berichte, Analysen, Umfragen","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Berichte, Analysen, Umfragen","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}]},{"identifier":"94a10e85-d9d3-44f0-a1ea-52d92bcc464d","title":"Bestand an Kraftfahrzeugen nach Kraftfahrzeugarten (Stichtag)","description":"\u003Cp\u003EBestand an Kraftfahrzeugen nach Kraftfahrzeugarten (Stichtag).\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=46251-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Statistik gibt Auskunft \u00fcber den Kraftfahrzeug- und\u003Cbr \/\u003E\nAnh\u00e4ngerbestand. Die Datenbereitstellung erfolgt durch das\u003Cbr \/\u003E\nKraftfahrtbundesamt. R\u00e4umlich differenziert sind die Daten\u003Cbr \/\u003E\nbis auf die Ebene der Gemeinden.\u003C\/p\u003E\n","keyword":["Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bestand an Kraftfahrzeugen nach Kraftfahrzeugarten XML","dctModified":"2025-11-17T13:19:23+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-18T09:19:00+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=46251-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bestand an Kraftfahrzeugen nach Kraftfahrzeugarten  CSV","dctModified":"2025-11-17T13:18:56+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-18T09:19:28+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=46251-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bestand an Kraftfahrzeugen nach Kraftfahrzeugarten XLSX","dctModified":"2025-11-17T13:19:10+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-18T09:19:48+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=46251-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["46251-02d"],"adms:Identifier":[{"title":"46251-02d"}],"dctIssued":"2024-06-18T11:17:48+02:00","dctModified":"2025-11-27T15:50:50+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"92fa664e-d255-452a-8677-b008b7b487c3","title":"Monatserhebung im Tourismus: Ank\u00fcnfte, \u00dcbernachtungen und durchschnittliche Aufenthaltsdauer nach Herkunftskontinent der G\u00e4ste","description":"\u003Cp\u003EMonatserhebung im Tourismus: Ank\u00fcnfte, \u00dcbernachtungen und durchschnittliche Aufenthaltsdauer nach Herkunftskontinent der G\u00e4ste.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=45412-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Monatserhebung im Tourismus gibt Auskunft \u00fcber die\u003Cbr \/\u003E\nEntwicklung des Reiseverkehrs in Nordrhein-Westfalen. Die\u003Cbr \/\u003E\nMerkmale G\u00e4steank\u00fcnfte und G\u00e4ste\u00fcbernachtungen sowie\u003Cbr \/\u003E\nangebotene Schlafgelegenheiten werden monatlich bei\u003Cbr \/\u003E\nBeherbergungsbetrieben und Campingpl\u00e4tzen (ohne\u003Cbr \/\u003E\nDauercamping) erhoben. Die r\u00e4umliche Differenzierung erfolgt\u003Cbr \/\u003E\nbis auf die Ebene der Gemeinden.\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Ank\u00fcnfte, \u00dcbernachtungen und durchschnittliche Aufenthaltsdauer nach Herkunftskontinent der G\u00e4ste XML","dctModified":"2025-11-17T13:17:39+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-18T09:01:05+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-14i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Ank\u00fcnfte, \u00dcbernachtungen und durchschnittliche Aufenthaltsdauer nach Herkunftskontinent der G\u00e4ste CSV","dctModified":"2025-11-17T13:17:04+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-18T09:01:34+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-14i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Ank\u00fcnfte, \u00dcbernachtungen und durchschnittliche Aufenthaltsdauer nach Herkunftskontinent der G\u00e4ste XLSX","dctModified":"2025-11-17T13:17:21+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-18T09:02:47+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-14i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["45412-14d"],"adms:Identifier":[{"title":"45412-14d"}],"dctIssued":"2024-06-18T10:59:56+02:00","dctModified":"2025-11-27T15:53:04+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"8e9261b0-3e3b-4e63-89fb-53b0f7f7ac8e","title":"Monatserhebung im Tourismus: Betriebe, ge\u00f6ffnete Beherbergungsbetriebe, Betten, angebotene Betten, Ank\u00fcnfte und \u00dcbernachtungen nach Betriebsarten","description":"\u003Cp\u003EMonatserhebung im Tourismus: Betriebe, ge\u00f6ffnete Beherbergungsbetriebe, Betten, angebotene Betten, Ank\u00fcnfte und \u00dcbernachtungen nach Betriebsarten.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=45412-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Monatserhebung im Tourismus gibt Auskunft \u00fcber die\u003Cbr \/\u003E\nEntwicklung des Reiseverkehrs in Nordrhein-Westfalen. Die\u003Cbr \/\u003E\nMerkmale G\u00e4steank\u00fcnfte und G\u00e4ste\u00fcbernachtungen sowie\u003Cbr \/\u003E\nangebotene Schlafgelegenheiten werden monatlich bei\u003Cbr \/\u003E\nBeherbergungsbetrieben und Campingpl\u00e4tzen (ohne\u003Cbr \/\u003E\nDauercamping) erhoben. Die r\u00e4umliche Differenzierung erfolgt\u003Cbr \/\u003E\nbis auf die Ebene der Gemeinden.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErl\u00e4uterung:\u003C\/strong\u003E\u003Cbr \/\u003E\nAb Januar 2012: Beherbergungsbetriebe ab 10 Betten, einschlie\u00dflich Campingpl\u00e4tzen (Touristik-Camping)\u003Cbr \/\u003E\nab 10 Stellpl\u00e4tzen; vorher: Beherbergungsbetriebe mit 9 und mehr G\u00e4stebetten sowie ab 2004\u003Cbr \/\u003E\nCampingpl\u00e4tze ohne Dauercamping. F\u00fcr Campingpl\u00e4tze werden Anzahl der Betten nicht ermittelt.\u003Cbr \/\u003E\nBoardinghouses: bis 2003 den Hotels garnis zugeordnet, ab 2004 werden sie mit den Erholungs-, Ferien\u003Cbr \/\u003E\nund Schulungsheimen dargestellt. zu \u0022Betriebe\u0022, \u0022ge\u00f6ffnete Beherbergungsbetriebe\u0022, \u0022Bettenbestand\u0022 und\u003Cbr \/\u003E\n\u0022angebotene Betten\u0022: Stichtag 31.12.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen","Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Betriebe, ge\u00f6ffnete Beherbergungsbetriebe, Betten, angebotene Betten, Ank\u00fcnfte und \u00dcbernachtungen nach Betriebsarten XML","dctModified":"2025-11-17T13:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-18T08:42:57+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebe, ge\u00f6ffnete Beherbergungsbetriebe, Betten, angebotene Betten, Ank\u00fcnfte und \u00dcbernachtungen nach Betriebsarten CSV","dctModified":"2025-11-17T13:14:46+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-18T08:43:19+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebe, ge\u00f6ffnete Beherbergungsbetriebe, Betten, angebotene Betten, Ank\u00fcnfte und \u00dcbernachtungen nach Betriebsarten XLSX","dctModified":"2025-11-17T13:15:01+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-18T08:43:54+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=45412-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"dctIssued":"2024-06-18T10:4