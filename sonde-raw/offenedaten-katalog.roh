/default\/files\/uploaded_resources\/sloc-04_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Standorttabelle s11","dctModified":"2026-04-30T11:25:50+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2026-04-30T11:26:05+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/uploaded_resources\/sloc-11_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","hasEmail":"mailto:ordnungsamt@stadt-koeln.de"}],"dctIssued":"2026-04-30T11:27:05+00:00","dctModified":"2026-04-30T11:27:11+00:00","dctLanguage":[{"type":"dcterms:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}]},{"type":"dcat:Dataset","title":"Trinkwasserbrunnen in K\u00f6ln","identifier":"e372e761-220b-4d5a-8a2e-f29d8ac835ff","description":"\u003Cp\u003EDarstellung der Standorte bestehender Trinkwasserbrunnen in K\u00f6ln.\u003C\/p\u003E\u003Cp\u003ETrinkwasserbrunnen sind ein wesentlicher Bestandteil einer guten Hitzevorsorge in der Stadt.\u003C\/p\u003E\u003Cp\u003EDie K\u00f6lner Trinkwasserbrunnen werden j\u00e4hrlich w\u00e4hrend der w\u00e4rmeren Monate von April bis Oktober an den aufgef\u00fchrten Standorten aufgestellt. Aktuell werden 16 Trinkwasserbrunnen w\u00e4hrend der warmen Monate im K\u00f6lner Stadtgebiet betrieben. Sie sind als Dauerl\u00e4ufer konzipiert, das hei\u00dft es l\u00e4uft stetig frisches Trinkwasser, das kostenlos in eine selbst mitgebrachte Trinkflasche abgef\u00fcllt werden kann. W\u00e4hrend der Wintermonate werden die Brunnen abgebaut und eingelagert, bzw. bei Bedarf instandgesetzt etc. Der Betrieb der K\u00f6lner Trinkwasserbrunnen erfolgt in Zusammenarbeit mit der RheinEnergie.\u00a0\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003ETrinkwasserbrunnen nach Stadtbezirk\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EChorweiler:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EIm Park an der Sportanlage Weichselring\u003C\/li\u003E\u003Cli\u003EWasserwerk Weiler\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003EEhrenfeld:\u00a0\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003ESubbelrather Stra\u00dfe, H\u00f6he Takufeld\u003C\/li\u003E\u003Cli\u003EBl\u00fccherpark\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003EInnenstadt:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EAgrippinaufer\u003C\/li\u003E\u003Cli\u003EBonner Stra\u00dfe\u003C\/li\u003E\u003Cli\u003EDeutzer Freiheit vor\u00a0St.\u00a0Heribert\u003C\/li\u003E\u003Cli\u003EEigelsteintorburg\u003C\/li\u003E\u003Cli\u003EKurt-Hackenberg-Platz\u003C\/li\u003E\u003Cli\u003EZeppelinstra\u00dfe\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003EKalk:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EBarcelona-Allee, B\u00fcrgerpark\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003ELindenthal:\u00a0\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EJahnwiese, H\u00f6he Adenauer-Weiher\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003EM\u00fclheim:\u00a0\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EJan-Wellem-Stra\u00dfe, s\u00fcdlicher Teil des M\u00fclheimer Stadtgartens\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003ENippes:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EAm neuen Sportpark, H\u00f6he Merheimer Stra\u00dfe\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003EPorz:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EBahnhofstra\u00dfe, Fu\u00dfg\u00e4ngerzone\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u003Cstrong\u003ERodenkirchen:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EMaternusplatz\u003C\/li\u003E\u003C\/ul\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Soziales","Infrastruktur","Umwelt und Klima","Gesundheit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/HEAL"}],"dcatAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[6.8529397319055,51.082056200978],[6.8529419374532,51.082003950333],[6.8529772029547,51.081524176405],[6.8530115297498,51.081287860856],[6.8530505830735,51.08105235972],[6.8531615393036,51.080583362115],[6.8531710881043,51.080549233766],[6.853184190258,51.080503211772],[6.8531978409653,51.080456813124],[6.8535870147001,51.079439656843],[6.8541319916778,51.078463517117],[6.854737665366,51.077651616964],[6.8548329625448,51.077528258632],[6.8548868700139,51.07746070003],[6.8550266560839,51.077304602722],[6.8551769294369,51.0771381877],[6.8553144065849,51.076996408818],[6.85546