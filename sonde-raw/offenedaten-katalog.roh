groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=kmz","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Stadtplanungsamt Stadt  K\u00f6ln","hasEmail":"mailto:stadtplanungsamt@stadt-koeln.de"}],"dctIssued":"2024-05-08T11:15:55+00:00","dctModified":"2025-11-27T15:02:13+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Stadtplanungsamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtplanungsamt"}],"dctContributor":[{"foaf_name":"Stadtplanungsamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtplanungsamt"}],"dcatdeOriginator":[{"foaf_name":"Stadtplanungsamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtplanungsamt"}],"dcatdeMaintainer":[{"foaf_name":"Stadtplanungsamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stadtplanungsamt"}]},{"type":"dcat:Dataset","title":"Fl\u00e4chennutzungsplan Web Zweckbestimmung","identifier":"9d2bf466-06e1-4c55-b68e-e5d55616dfbb","description":"\u003Cp\u003EDer Fl\u00e4chennutzungsplan stellt die Art der Bodennutzung f\u00fcr das gesamte Stadtgebiet in Grundz\u00fcgen dar. Er dient also der st\u00e4dtebaulichen Zielplanung der Stadt, indem er sowohl die bereits vorhandenen als auch die l\u00e4ngerfristig beabsichtigten Nutzungen von Grundst\u00fccken darstellt.\u003C\/p\u003E\u003Cp\u003EWelche Informationen enth\u00e4lt der Fl\u00e4chennutzungsplan?\u003Cbr \/\u003EAus unserem Fl\u00e4chennutzungsplan k\u00f6nnen Sie insbesondere ablesen, welche Fl\u00e4chen welchen Nutzen haben sollen. Hier einige Beispiele:\u00a0\u003C\/p\u003E\u003Cp\u003EWohnbaufl\u00e4chen\u003Cbr \/\u003Egemischte Baufl\u00e4chen\u003Cbr \/\u003EGewerbe- und Industriefl\u00e4chen\u003Cbr \/\u003EGemeinbedarfsfl\u00e4chen\u003Cbr \/\u003EGr\u00fcnfl\u00e4chen\u003Cbr \/\u003EFl\u00e4chen f\u00fcr die Landwirtschaft und Verkehrsfl\u00e4chen\u003Cbr \/\u003EDar\u00fcber hinaus k\u00f6nnen Sie sich geplante Einrichtungen und Zweckbestimmungen anzeigen lassen.\u003C\/p\u003E\u003Cp\u003EDiese sind zum Beispiel:\u003C\/p\u003E\u003Cp\u003EAlteneinrichtungen\u003Cbr \/\u003EFeuerwehren\u003Cbr \/\u003EFriedh\u00f6fe\u003Cbr \/\u003ESpielpl\u00e4tze\u003Cbr \/\u003EMit dem Fl\u00e4chennutzungsplan treffen wir eine verbindliche Vorentscheidung f\u00fcr die zuk\u00fcnftige st\u00e4dtebauliche Entwicklung K\u00f6lns. Unmittelbare rechtliche Wirkungen f\u00fcr die B\u00fcrger*innen entfaltet der Fl\u00e4chennutzungsplan hingegen nicht. Allein aus den Darstellungen des Fl\u00e4chennutzungsplanes k\u00f6nnen Sie daher kein Baurecht f\u00fcr Ihr Grundst\u00fcck herleiten. Eine verbindliche Konkretisierung erfolgt erst durch die Aufstellung von nachfolgenden Bebauungspl\u00e4nen.\u003C\/p\u003E\u003Cp\u003EUnser derzeit geltender Fl\u00e4chennutzungsplan ist seit 1982 wirksam und wird stets aktualisiert.\u003C\/p\u003E\u003Cp\u003EDieser Datensatz zeigt die vorgesehenen Fl\u00e4chennutzungen nach Zweckbestimmungen auf dem K\u00f6lner Stadtgebiet\u003C\/p\u003E\u003Cp\u003EDie komplette Auflistung findet man hier: \u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechennutzungsplan\u0022\u003Ehttp:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechenn..\u003C\/a\u003E\u00a0\u00a0unter \u0022Filtern nach Einrichtungen und Zweckbestimmungen\u0022\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"Fl\u00e4chennutzungsplan K\u00f6ln"},"keyword":["Geo"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"distribution":[{"type":"dcat:Distribution","title":"ArcGIS REST API FNP Signets","dctModified":"2025-11-18T08:06:23+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EListe und Position einzelner Zweckbestimmungen. Die komplette Auflistung findet man hier:\u0026nbsp;\u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechennutzungsplan\u0022\u003Ehttp:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechenn...\u003C\/a\u003E unter \u0022Filtern nach EInrichtungen und Zweckbestimmungen\u0022\u003C\/p\u003E","dctIssued":"2016-07-12T10:09:28+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/planen_und_bauen\/flaechennutzungsplan\/