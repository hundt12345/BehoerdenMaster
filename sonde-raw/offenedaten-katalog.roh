 Besch\u00e4ftigte, Entgelte, Auftragseing\u00e4nge,\u003Cbr \/\u003E\ngeleistete Arbeitsstunden sowie Umsatz werden monatlich\u003Cbr \/\u003E\nerfragt. Die r\u00e4umliche Differenzierung erfolgt bis auf die\u003Cbr \/\u003E\nEbene der kreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Baugewerblicher Umsatz nach Bauarten XML","dctModified":"2025-11-17T12:52:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-18T08:13:10+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=44111-03i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Baugewerblicher Umsatz nach Bauarten CSV","dctModified":"2025-11-17T12:52:25+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-18T08:13:58+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=44111-03i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Baugewerblicher Umsatz nach Bauarten XLSX","dctModified":"2025-11-17T12:52:38+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publica