# Referenz, wird NICHT automatisch geladen. Lokal exportieren; auf Render unter Environment setzen.
# Keine echten Kontakt- oder Zugangsdaten ins Repository schreiben.
BEHOERDEN_DB=data/behoerdenmaster.sqlite
BEHOERDEN_CONFIG_DIR=config/cities

# Beispieldaten nur für den Offline-Test; auf Render ausgeschaltet.
BEHOERDEN_DEMO=false

# Automatischer Hintergrundabruf. Ohne BEHOERDEN_KONTAKT bleibt er ausgeschaltet und der
# Webdienst meldet das in /api/status und auf der Startseite (kein Absturz, keine stille Leere).
BEHOERDEN_SYNC_ENABLED=true
BEHOERDEN_KONTAKT=kontakt@ihre-organisation.example
BEHOERDEN_SYNC_QUELLEN=koeln:ris
# Erstabruf-Fenster: "90" = rollierend die letzten 90 Tage, alternativ ein festes Datum YYYY-MM-DD.
# Leer = Wert aus config/cities/<stadt>.toml.
BEHOERDEN_SYNC_SEIT=90
BEHOERDEN_SYNC_INTERVALL=21600
BEHOERDEN_SYNC_MAX_ANFRAGEN=120
BEHOERDEN_SYNC_STARTVERZOEGERUNG=15
PORT=8000
