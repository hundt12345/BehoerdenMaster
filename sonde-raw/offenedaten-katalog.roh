:"mailto:statistik-rbs@stadt-koeln.de"}],"dcatdeContributorID":[],"dctIssued":"2013-06-26T10:12:45+00:00","dctModified":"2026-09-24T07:30:24+00:00","dctRelation":[{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/stadtgebiet-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/stadtbezirke-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/stadtteile-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/stadtviertel-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/statistische-quartiere-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/blockseiten-koeln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/adressen-koeln"}],"dcatLandingPage":[],"foafPage":[],"dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"provWasGeneratedBy":[],"provQualifiedAttribution":[],"dcatQualifiedRelation":[],"dctIsReferencedBy":[],"dctReferences":[],"dcathasVersion":[],"admsSample":[],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"@type":"dcat:Dataset","title":"Adressen K\u00f6ln","identifier":"c2f2e522-00c5-4c0c-9168-d60e716020a3","description":"\u003Cp\u003EEine Adresse ist Teil der Kommunalen Gebietsgliederung. Dieses hierarchische System gliedert das K\u00f6lner Stadtgebiet auf verschiedenen Ebenen in eine Stadtstruktur und Blockstruktur. Weitere Bestandteile sind eine Stra\u00dfenstruktur und Adressen.\u00a0Die gesamte Kommunale Gebietsgliederung wird in dieser \u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003E\u003Cstrong\u003EVer\u00f6ffentlichung\u003C\/strong\u003E\u003C\/a\u003E erl\u00e4utert.\u003Cbr \/\u003EDefinition: Geb\u00e4ude werden \u00fcber Adressen verschl\u00fcsselt und lokalisiert. Der Aufbau der Geb\u00e4udeadressen basiert auf einer Empfehlung des Deutschen St\u00e4dtetages. Adressen sind die einzigen Ortsangaben, anhand derer\u003Cbr \/\u003E\u00a0\u00a0 - sich jedermann leicht orientieren kann,\u003Cbr \/\u003E\u00a0\u00a0 - die amtlich vergeben werden,\u003Cbr \/\u003E\u00a0\u00a0 - die in der \u00d6rtlichkeit angebracht und\u003Cbr \/\u003E\u00a0\u00a0 - in Kartenwerken nachgewiesen werden.\u003Cbr \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003C\/p\u003E\u003Cp\u003EDie Attribute \u201eGeb\u00e4ude ID ALKIS\u201c und \u201eNutzung (Geb\u00e4udefunktion)\u201c stammen aus dem Amtliches Liegenschaftskataster-Informationssystem (Stadt K\u00f6ln - Amt f\u00fcr Liegenschaften, Vermessung und Kataster). Die Geodaten dazu enth\u00e4lt der Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/amtliches-liegenschaftskataster-koeln\u0022\u003E\u003Cstrong\u003EAmtliches Liegenschaftskataster-Informationssystem Koeln\u003C\/strong\u003E\u003C\/a\u003E.\u003C\/p\u003E\u003Cp\u003EDas \u003Ca href=\u0022https:\/\/offenedaten-koeln.de\/dataset\/koelner-strassenverzeichnis\u0022\u003E\u003Cstrong\u003EK\u00f6lner Stra\u00dfenverzeichnis\u003C\/strong\u003E\u003C\/a\u003E gibt einen \u00dcberblick \u00fcber alle geltenden Stra\u00dfennamen und Adressen. Es wird etwa halbj\u00e4hrig und vor jeder Wahl aktualisiert.\u00a0\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten und weitere Gebietsgliederungen enth\u00e4lt der Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-koeln\u0022\u003E\u003Cstrong\u003EGeopackage Raumbezugssystem K\u00f6ln\u003C\/strong\u003E\u003C\/a\u003E\u003Cstrong\u003E.\u003C\/strong\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.85027633864