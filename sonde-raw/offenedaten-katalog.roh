ps:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Geoportal Stadt K\u00f6ln","hasEmail":"mailto:e-government@stadt-koeln.de"}],"dctIssued":"2017-02-16T14:45:31+00:00","dctModified":"2025-11-27T15:03:51+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dctContributor":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}]},{"type":"dcat:Dataset","title":"Statistik Ordungsamt Koeln 2016","identifier":"f8192fb5-46b1-4f5e-b1cb-43f527c32713","description":"\u003Cp\u003EDer Ordnungs- und Verkehrsdienst des Amtes f\u00fcr \u00f6ffentliche Ordnung legt seine vorl\u00e4u-fige Statistik f\u00fcr das Jahr 2016 vor. Die Zahlen und Daten sind aus der beigef\u00fcgten Da-tei, getrennt nach den Angaben f\u00fcr den Verkehrsdienst und den Ordnungsdienst, ersichtlich.\u003C\/p\u003E\u003Cp\u003EDie Statistik basiert auf den Fallzahlen zum 30. November 2016. Die Zahlen f\u00fcr Dezem-ber wurden anhand der Dezemberwerte aus den Vorjahren prognostiziert. Bei den An-gaben zu den Einnahmen handelt es sich um die Betr\u00e4ge, die nach dem aktuellen Stand der Verfahren erwartet werden k\u00f6nnen. Hier sind st\u00e4ndige Anpassungen durch einge-stellte oder rechtskr\u00e4ftig abgeschlossene Verfahren notwendig.\u003C\/p\u003E\u003Cp\u003EWeitere Informationen finden Sie hier: \u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/presse\/mehr-personaleinsatz-und-praeventivarbeit\u0022\u003Ehttp:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/presse\/mehr-personaleinsatz-und-praeventivarbeit\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Haushalt und Steuern"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/GOVE"}],"distribution":[{"type":"dcat:Distribution","title":"Jahresstatistik Ordnungsamt 2016","dctModified":"2022-07-26T09:27:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 30.12.2016\u003C\/p\u003E","dctIssued":"2017-01-04T13:33:02+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20161230_Ordnungsamt_Jahresstatistik.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status