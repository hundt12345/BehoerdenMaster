],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"type":"dcat:Dataset","title":"Historische Karten","identifier":"7ea838de-481e-4aba-96f9-30d13906c175","description":"\u003Cp\u003E\u00a0historische Stadtkarten K\u00f6lns als wms.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Historische Stadtkarten","dctModified":"2023-03-06T10:51:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WMS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EDie Datenressource enth\u00e4lt den wms Dienst zu den historischen Stadtkarten K\u00f6lns.\u003C\/p\u003E","dctIssued":"2023-02-02T08:50:26+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/wss\/service\/historische_stadtkarten\/guest?SERVICE=WMS\u0026amp;Request=GetCapabilities","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Geoportal Stadt K\u00f6ln ","hasEmail":"mailto:cc-gis@stadt-koeln.de"}],"dctIssued":"2023-02-02T08:40:35+00:00","dctModified":"2025-11-27T14:55:30+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dctContributor":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}]},{"type":"dcat:Dataset","title":"K\u00f6lner Strassenverzeichnis","identifier":"3fea34d4-1ebe-441e-a99d-5dab3d984c78","description":"\u003Cp\u003EDie Stadt K\u00f6ln gibt auf Beschluss der Bezirksvertretungen allen Stra\u00dfen, Wegen und Pl\u00e4tzen einen amtlichen Stra\u00dfennamen. F\u00fcr diesen wird vom Amt f\u00fcr Stadtentwicklung und Statistik ein eindeutiger Stra\u00dfenschl\u00fcssel vergeben.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EEntsprechend der gesetzlichen Grundlage, wird seit dem 1.9.2022 bei einer amtlichen Stra\u00dfenumbenennung ein neuer Stra\u00dfenschl\u00fcssel vergeben. Ab den Stra\u00dfenverzeichnissen Stand 15.10.2025 werden alle hiervon betroffenen F\u00e4lle im Tabellenblatt \u0022Stra\u00dfenumbenennungen\u0022 aufgelistet. Der WFS Stra\u00dfenumbenennung zeigt alle durch eine Umbenennung g\u00fcltigen Stra\u00dfen und Adressen, sobald die Bezeichnung rechtkr\u00e4ftig ist. Weiterhin werden f\u00fcr die ung\u00fcltigen Stra\u00dfen und Adressen Tabellen zur Umschl\u00fcsselung bereitgestellt.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDas K\u00f6lner Stra\u00dfenverzeichnis gibt einen \u00dcberblick \u00fcber alle geltenden Stra\u00dfennamen und -schl\u00fcssel. Durch verschiedene Phasen der Eingemeindung, wie die Kommunale Gebietsreform im Jahre 1975, erweiterte sich der K\u00f6lner Stra\u00dfenbestand um Stra\u00dfen, deren Namen im Stadtgebiet bereits vorhanden waren. Von einer Umbenennung wurde abgesehen, um der betroffenen Bev\u00f6lkerung die dadurch anfallenden Kosten zu ersparen. Doppelte Stra\u00dfennamen k\u00f6nnen anhand des eindeutigen Stra\u00dfenschl\u00fcssels unterschieden werden. Im Stra\u00dfenverzeichnis ist den eingemeindeten Stra\u00dfen der Stadtbezirk in Klammern angeh\u00e4ngt.\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Standard)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E und \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden ohne Hausnummernbereich angegeben. Das Stra\u00dfenverzeichnis wird etwa halbj\u00e4hrig aktualisiert (In der Regel zum Stichtag 1. April und 1. Oktober).\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Quartier)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E, \u003Cstrong\u003EStatistischem Quartier\u003C\/strong\u003E und \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden nicht angegeben. Das Stra\u00dfenverzeichnis wird etwa halbj\u00e4hrig aktualisiert.\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Wahlen)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E, \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E, \u003Cstrong\u003EStimmbezirk\u003C\/strong\u003E, \u003Cstrong\u003EKommunalwahlbezirk\u003C\/strong\u003E, \u003Cstrong\u003ELandtagswahlkreis\u003C\/strong\u003E, \u003Cstrong\u003EBundestagswahlkreis\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden nicht angegeben. Das Stra\u00dfenverzeichnis wird vor jeder Wahl aktualisiert.\u003C\/p\u003E\u003Cp\u003E\u00dcber das Portal Offene Daten K\u00f6ln werden alle dem Stra\u00dfenverzeichnis zugrunde liegenden Geodaten der Kommunalen Gebietsgliederung ver\u00f6ffentlicht, z. B. \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/strassen-k%C3%B6ln\u0022\u003EStrassen K\u00f6ln\u003C\/a\u003E. Die gesamte Kommunale Gebietsgliederung wird in dieser\u00a0\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdfhttps:\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003EVer\u00f6ffentlichung\u00a0\u003C\/a\u003Eerl\u00e4utert.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Infrastruktur"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.