ienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dcatdeMaintainer":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}]},{"identifier":"a390cdf6-f803-4e50-901d-f279e410daa3","title":"Jugendfeuerwehr K\u00f6ln Personalzahlen 2014","description":"\u003Cp align=\u0022left\u0022\u003EDie Jugendfeuerwehr K\u00f6ln ist der Zusammenschluss aller Jugendgruppen der Einheiten der FF. Jedes Kind und jeder Jugendliche im Alter von 10 bis 18 Jahren kann Mitglied einer Jugendgruppe werden. Insgesamt gibt es derzeit 24 Jugendgruppen, d.h. lediglich zwei Einheiten der FF haben keine Jugendgruppe. Jede Jugendgruppe wird von einem ernannten Jugendwart und mindestens einem Stellvertreter geleitet.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","hasEmail":"feuerwehr@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz"},"distribution":[{"type":"dcat:Distribution","title":"Einheiten 2014","dctModified":"2022-07-26T09:53:44+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2015-09-18T10:40:53+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Jugend_FW_Einheiten_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2015-09-18T12:40:13+02:00","dctModified":"2025-11-27T16:04:35+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dctContributor":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dcatdeOriginator":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dcatdeMaintainer":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}]},{"identifier":"0a0cc7d3-e1db-4cbf-a6d3-9806035db9b4","title":"Freiwillige Feuerwehr K\u00f6ln Personalzahlen 2014","description":"\u003Cp align=\u0022left\u0022\u003EHistorisch bedingt hat die FF als Grundaufgabe die Sicherstellung des Brandschutzes in ihrem jeweiligen Wachgebiet. Dabei wird sie im Ereignisfall entsprechend ihrem Leistungsverm\u00f6gen zeitgleich mit der Berufsfeuerwehr alarmiert. Sie arbeitet das Schadensereignis gemeinsam mit den Kr\u00e4ften der Berufsfeuerwehr ab. Dar\u00fcber hinaus werden Eins\u00e4tze auch selbstst\u00e4ndig ohne Mitwirkung der Berufsfeuerwehr durchgef\u00fchrt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","hasEmail":"feuerwehr@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz"},"distribution":[{"type":"dcat:Distribution","title":"Personalzahlen Gesamt 2014","dctModified":"2022-07-26T09:57:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2015-09-18T10:31:01+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Freiwillige_FW_Gesamt_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\