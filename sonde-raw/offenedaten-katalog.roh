uropa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 31.12.2015\u003C\/p\u003E","dctIssued":"2016-11-15T15:27:10+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Schulen_Gebaeudewirtschaft_Koeln.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Kindertagesstaetten Alter Gebaeudewirtschaft Koeln","dctModified":"2022-07-26T09:27:17+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 31.12.2015\u003C\/p\u003E","dctIssued":"2016-11-15T15:30:33+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Kindertagesstaetten_Gebaeudewirtschaft_Koeln.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Geb\u00e4udewirtschaft der Stadt K\u00f6ln","hasEmail":"mailto:gebaeudewirtschaft@stadt-koeln.de"}],"dctIssued":"2016-11-15T15:23:29+00:00","dctModified":"2025-11-27T15:05:02+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Geb\u00e4udewirtschaft der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/gebaeudewirtschaft-der-stadt-koeln"}],"dctContributor":[{"foaf_name":"Geb\u00e4udewirtschaft der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/gebaeudewirtschaft-der-stadt-koeln"}],"dcatdeOriginator":[{"foaf_name":"Geb\u00e4udewirtschaft der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/gebaeudewirtschaft-der-stadt-koeln"}],"dcatdeMaintainer":[{"foaf_name":"Geb\u00e4udewirtschaft der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/gebaeudewirtschaft-der-stadt-koeln"}]},{"type":"dcat:Dataset","title":"Haushaltsplan 2016 2017 Stadt Koeln","identifier":"e33d7a78-4e85-413a-ad89-34da1807372c","description":"\u003Cp\u003EDer Haushaltsplan stellt die Grundlage der Haushaltswirtschaft der Stadt K\u00f6ln dar. Er besteht aus dem Ergebnisplan und dem Finanzplan inkusive Anlagen und ist unterteilt in Teilpl\u00e4ne. Diese sind produktorientiert.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EEine Visualisierung der unten angef\u00fcgten\u00a0Daten kann unter \u003C\/strong\u003E\u003Ca href=\u0022http:\/\/haushaltsplan.koeln\/\u0022\u003E\u003Cstrong\u003Ehttp:\/\/haushaltsplan.koeln\/\u003C\/strong\u003E\u003C\/a\u003E\u003Cstrong\u003E aufgerufen werden.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EIm Ergebnisplan sind alle voraussichtlich eingehenden Ertr\u00e4ge und die zu leistenden Aufwendungen eines Jahres aufgef\u00fchrt. Im Finanzplan ist festgelegt, welche Ein- und Auszahlungen die Stadt t\u00e4tigen will. In ihm sind insbesondere die Investitionen und ihre Finanzierung dargelegt.\u003C\/p\u003E\u003Cp\u003EDer NKF-Haushalt weist dar\u00fcber hinaus Ziele und Leistungsvorgaben auf, die festlegen, wof\u00fcr die Ressourcen eingesetzt werden sollen.\u003C\/p\u003E\u003Cp\u003EDamit betrifft der K\u00f6lner Haushalt alle Bewohnerinnen und Bewohner der Stadt. Der Haushaltsplan basiert auf einem Entwurf der Verwaltung und wird nach Vorberatung in den Bezirksvertretungen und im Finanzausschuss vom Rat beschlossen. Der Haushaltsplan gilt jeweils f\u00fcr den Zeitraum vom 1. Januar bis zum 31. Dezember des entsprechenden Jahres. Der Haushalt muss grunds\u00e4tzlich ausgeglichen sein. Das bedeutet, dass die Ertr\u00e4ge mindestens so hoch sein m\u00fcssen wie die Aufwendungen. Kann diese Vorgabe nicht eingehalten werden, muss sich die Stadt oder die Gemeinde besonderen Sparvorgaben unterwerfen, um den Haushaltsausgleich wieder herzustellen.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Haushalt und Steuern"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Erlaeuterungen Haushaltsplan 2016 Koeln","dctModified":"2022-07-26T09:26:31+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2016-10-24T08:07:31+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/uploaded_resources\/Erlaeuterungen.zip","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dc