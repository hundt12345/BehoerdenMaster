u00e4tze im Zusammenhang mit Unwettern abarbeiten.\u003C\/p\u003E\n","dctIssued":"2015-09-18T10:35:39+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Freiwillige_FW_Einsaetze_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2015-09-18T12:29:45+02:00","dctModified":"2025-11-27T16:04:43+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dctContributor":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dcatdeOriginator":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuerschutz-rettungsdienst-und-bevo"}],"dcatdeMaintainer":[{"foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/berufsfeuerwehr-amt-fuer-feuer