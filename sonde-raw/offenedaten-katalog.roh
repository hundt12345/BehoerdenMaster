operation=result\u0026amp;code=42131-01d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EIn der Viertelj\u00e4hrlichen Produktionserhebung wird die\u003Cbr \/\u003E\nHerstellung von G\u00fctern in den Betrieben des Verarbeitenden\u003Cbr \/\u003E\nGewerbes nach Menge und Wert erhoben. Sie umfasst die\u003Cbr \/\u003E\nHerstellung von Erzeugnissen sowie die industriellen\u003Cbr \/\u003E\nDienstleistungen wie Reparatur- und Instandhaltungsarbeiten,\u003Cbr \/\u003E\nInstallations- und Montagearbeiten sowie Veredlungsarbeiten.\u003Cbr \/\u003E\nAngegeben werden Jahresergebnisse f\u00fcr das Land sowie die\u003Cbr \/\u003E\nkreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Viertelj\u00e4hrliche Produktionserh. im Verarb. Gewerbe: Wert, Betriebe der zum Absatz bestimmten Produktion XML","dctModified":"2025-11-17T12:06:24+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-17T09:28:47+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42131-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Viertelj\u00e4hrliche Produktionserh. im Verarb. Gewerbe: Wert, Betriebe der zum Absatz bestimmten Produktion CSV","dctModified":"2025-11-17T12:05:58+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-17T09:29:10+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42131-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Viertelj\u00e4hrliche Produktionserh. im Verarb. Gewerbe: Wert, Betriebe der zum Absatz bestimmten Produktion XLSX","dctModified":"2025-11-17T12:06:11+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-17T09:29:37+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42131-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["42131-01d"],"adms:Identifier":[{"title":"42131-01d"}],"dctIssued":"2024-06-17T11:28:15+02:00","dctModified":"2025-11-27T15:53:16+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"d6a794fa-aaf9-40b6-9efc-7ee01a95333c","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe, Besch\u00e4ftigte, geleistete Arbeitsstunden, Bruttoentgelte, Umsatz und Auslandsumsatz (Monat ab 2008)","description":"\u003Cp\u003EBergbau und Verarbeitendes Gewerbe: Betriebe, Besch\u00e4ftigte, geleistete Arbeitsstunden, Bruttoentgelte, Umsatz und Auslandsumsatz (Monat ab 2008).\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=42111C-1d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDer Monatsbericht f\u00fcr Betriebe im Bergbau und im\u003Cbr \/\u003E\nVerarbeitenden Gewerbe gibt Auskunft \u00fcber die konjunkturelle\u003Cbr \/\u003E\nEntwicklung der nordrhein-westf\u00e4lischen Industrie. Die\u003Cbr \/\u003E\nMerkmale Anzahl Betriebe, Besch\u00e4ftigte, geleistete\u003Cbr \/\u003E\nArbeitsstunden, Entgelte, Umsatz und Auslandsumsatz werden\u003Cbr \/\u003E\nmonatlich bei Betrieben mit 50 und mehr Besch\u00e4ftigten\u003Cbr \/\u003E\nerhoben. Die r\u00e4umliche Differenzierung erfolgt bis\u003Cbr \/\u003E\nauf die Ebene der kreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe, Besch\u00e4ftigte, geleistete Arbeitss