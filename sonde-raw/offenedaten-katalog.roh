003E\n\u003Cp\u003E\u003Ca href=\u0022http:\/\/www.toiletten.koeln\/\u0022\u003Ewww.toiletten.koeln\u003C\/a\u003E\u00a0ist das Informationsportal f\u00fcr alle \u00f6ffentlichen Toiletten der Stadt K\u00f6ln in Zusammenarbeit mit der AWB K\u00f6ln GmbH.\u003C\/p\u003E\n","keyword":["Geo","Kultur","Freizeit","Sport und Tourismus","Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/ENVI"}],"contactPoint":[{"fn":"AWB K\u00f6ln","hasEmail":"kundenberatung@awbkoeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"AWB K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Toiletten Koeln","dctModified":"2022-07-15T08:12:44+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003E\u00d6ffentliche Toiletten in K\u00f6ln\u003C\/p\u003E\n\n\u003Cp\u003E\u003Cstrong\u003EInformation\u003C\/strong\u003E\u003C\/p\u003E\n\n\u003Cp\u003EErkl\u00e4rung zu infrastucture:\u003Cbr \/\u003E\n1 = Barrierefrei\u003Cbr \/\u003E\n2 = 24 h ge\u00f6ffnet\u003Cbr \/\u003E\n3 = Baby-Wickeltisch\u003Cbr \/\u003E\n4 = Urinal\u003Cbr \/\u003E\n5 = City-Toilette\u003Cbr \/\u003E\n6 = Toilette in \u00f6ffentlichen Einrichtungen\u003Cbr \/\u003E\n7 = HappyToilet K\u00f6ln\u003Cbr \/\u003E\n8 = Toilette in Gr\u00fcnanlagen\u003Cbr \/\u003E\n9 = Kostenpflichtig\u003Cbr \/\u003E\n10 = Euro WC-Schl\u00fcssel\u003Cbr 