ef\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Einsatzgeschehen Feuerwehr Koeln 2014","dctModified":"2022-07-26T09:49:29+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EDie Gesamteinsatzzahl von Feuerwehr und Rettungsdienst der Stadt K\u00f6ln sowie der Hilfsorganisationen bel\u00e4uft sich f\u00fcr das Jahr 2014 auf 133.593 Eins\u00e4tze. Der Rettungsdienst hat hierbei den weitaus gr\u00f6\u00dften Anteil und z\u00e4hlte 119.509 Eins\u00e4tze. Die Feuerwehr r\u00fcckte 71.231 mal aus. Dabei haben die Br\u00e4nde lediglich einen Anteil von 2,5%.\u003C\/p\u003E","dctIssued":"2015-09-18T09:47:00+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Einsatzgeschehen_2014.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Einsatzgeschehen Notrufe 2014","dctModified":"2022-07-26T09:49:35+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2015-09-18T