_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Orgastruktur","dctModified":"2022-07-26T09:26:21+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2016-10-24T07:54:34+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Koeln_HH_Orgastruktur.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"K\u00e4mmerei Stadt K\u00f6ln","hasEmail":"mailto:kaemmerei@stadt-koeln.de"}],"dctIssued":"2016-10-24T07:10:49+00:00","dctModified":"2025-11-27T15:05:13+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"K\u00e4mmerei Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/kaemmerei"}],"dctContributor":[{"foaf_name":"K\u00e4mmerei Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/kaemmerei"}],"dcatdeOriginator":[{"foaf_name":"K\u00e4mmerei Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/kaemmerei"}],"dcatdeMaintainer":[{"foaf_name":"K\u00e4mmerei Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/kaemmerei"}]},{"type":"dcat:Dataset","title":"KFZ Zaehlstellen und Werte K\u00f6ln","identifier":"4d76cef2-39dd-44a3-9910-736bfa9370ff","description":"\u003Cp\u003E\u00dcberblick der KFZ Z\u00e4hlstellen der Jahrg\u00e4nge\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003E2010 bis 2016 (1. Halbjahr).\u003C\/li\u003E\u003Cli\u003E2016 \u00a0bis 2019\u003C\/li\u003E\u003Cli\u003ECorona bedingt haben 2020 und 2021 keine umfangreiche Z\u00e4hlungen stattgefunden.\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDie Z\u00e4hldaten werden an einem repr\u00e4sentativen Stichtag (Montag - Freitag, nicht an Feiertagen und au\u00dferhalb von Schulferien) als Knotenstromz\u00e4hlungen erhoben.\u003C\/p\u003E\u003Cp\u003ESo werden z.B. an einem 4-armigen Knotenpunkt 12 Knotenstr\u00f6me (Abbieger) erfasst. Die Z\u00e4hlung wird mit einer extra angebrachten Videokamera durchgef\u00fchrt.\u003C\/p\u003E\u003Cp\u003EDie Auswertung der Verkehrsz\u00e4hlung erfolgt in 3 Zeitbl\u00f6cken (6-10 Uhr, 11-14 Uhr und 15-19 Uhr). Aus den Zeitbl\u00f6cken wird, \u00fcber spezifische Faktoren, der Tagesverkehr hochgerechnet.\u003C\/p\u003E\u003Cp\u003EDie Werte sind analog\u00a0dem Fachbegriff DTVw (Durchschnittlicher t\u00e4glicher Verkehr werktags)\u00a0zu sehen. Die Einheit ist KFZ\/24h. Aus den Werten ergeben sich die Streckenbelastungen an den zum jeweiligen Knotenpunkt zulaufenden Stra\u00dfen.\u003C\/p\u003E\u003Cp\u003EZiel ist es, dass sukzessive alle Strecken im Haupstra\u00dfennetz aufgenommen werden. Strecken ohne Werte wurden von 2010 bis 2016 nicht gez\u00e4hlt.\u003C\/p\u003E\u003Cp\u003EFelder Verkehrsz\u00e4hlung Strecken:\u003C\/p\u003E\u003Cp\u003E1) Strecke hin \u2013 Richtung:\u003Cbr \/\u003ENO: Streckennummer\u003Cbr \/\u003EFROMNODENO: von Knotennummer\u003Cbr \/\u003ETONODENO: zu Knotennummer\u00a0\u003Cbr \/\u003ELENGTH: L\u00e4nge der Strecke\u003Cbr \/\u003EK_2016_24H: DTVw-Belastung 2016 auf betreffender Strecke\u003Cbr \/\u003EK_2017_24H: DTVw-Belastung 2017 auf betreffender Strecke\u003Cbr \/\u003EK_2018_24H: DTVw-Belastung 2018 auf betreffender Strecke\u003Cbr \/\u003EK_2019_24H: DTVw-Belastung 2019 auf betreffender Strecke\u003Cbr \/\u003ESTR_NAME: Stra\u00dfenname\u003C\/p\u003E\u003Cp\u003E2) Strecke gegen\/r\u00fcck \u2013 Richtung:\u003Cbr \/\u003ER_NO: Streckennummer\u003Cbr \/\u003ER_FROMNO~1: von Knotennummer\u003Cbr \/\u003ER_TONODENO: zu Knotennummer\u00a0\u003Cbr \/\u003ER_LENGTH: L\u00e4nge der Strecke\u003Cbr \/\u003ER_K_2016~2: DTVw-Belastung 2016 auf betreffender Strecke\u003Cbr \/\u003ER_K_2017~3: DTVw-Belastung 2017 auf betreffender Strecke\u003Cbr \/\u003ER_K_2018~4: DTVw-Belastung 2018 auf betreffender Strecke\u003Cbr \/\u003ER_K_2019~5: DTVw-Belastung 2019 auf betreffender Strecke\u003Cbr \/\u003ER_STR_NAME: Stra\u00dfenname\u003C\/p\u003E\u003Cp\u003EBeispiel:\u003Cbr \/\u003EAuf der Strecke 2071 wurden 2016 vom Knoten 16545002 zum Knoten 16545007 in eine Richtung 18.504 Kfz\/24h erhoben. Dieser Streckenabschnitt der Aachener Stra\u00dfe weist im Verkehrsmodell eine L\u00e4nge von 173 Meter auf.\u003Cbr \/\u003EIn die entgegensetzte Richtung verkehren auf der gleichen Strecke (2071, vom Knoten 16545007 zum Knoten 16545002) 22.153 Kfz\/24h.\u003C\/p\u003E\u003Cp\u003EFelder Verkehrsz\u00e4hlung Knotenpunkte:\u003Cbr \/\u003ENO: Knotennumer\u003Cbr \/\u003EXCOORD: X-Koordinate des Knotens im Gau\u00df-Kr\u00fcger-System\u003Cbr \/\u003EYCOORD:\u00a0 Y-Koordinate des Knotens im Gau\u00df-Kr\u00fcger-System\u003C\/p\u003E\u003Cp\u003EDie Ressource \u0022Messlinien 2010 - 2016\u0022 zeigt die in diesem Zeitraum gez\u00e4hlten Knotenpunkte.\u003C\/p\u003E\u003Cp\u003EAufgrund ihres Alters, sind diese Daten nicht f\u00fcr aktuelle L\u00e4rm- und Immissions-Berechnungen geeignet.\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Messlinien 2010 - 2016","dctModified":"2022-07-26T11:31:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/PDF","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EMesslinien 2010 - 2016 (erstes Halbjahr)\u003C\/p\u003E","dctIssued":"2016-10-12T12:41:26+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Z%25C3%25A4hlwerte%25202010-2016_14102016_1300.pdf","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Zaehldaten 2010 - 2016","dctModified":"2022-07-26T11:31:49+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EZ\u00e4hldaten von 2010 - 2016 (erstes Halbjahr) zwischen den gemessenen Knotenpunkten.\u003C\/p\u003E","dctIssued":"2016-10-12T12:51:59+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Zaehldaten_2010_2016_link.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Zaehldaten 2010 - 2016 Knoten","dctModified":"2022-07-26T11:31:52+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EAuflistung der einzelnen Knoten inklusive Geo Referenz\u003C\/p\u003E","dctIssued":"2016-10-12T12:56:09+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Zaehldaten_2010_2016_node.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Knotenpunkte Linien KFZ Zaehldaten ","dctModified":"2022-07-26T11:31:55+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/