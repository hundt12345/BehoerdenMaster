ver\/WMSServer?request=GetCapabilities\u0026amp;service=WMS","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2017-07-18T13:32:47+02:00","dctModified":"2025-11-27T16:05:08+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}]},{"type":"dcat:Dataset","title":"Fahrrad F\u00f6rderung K\u00f6ln","identifier":"de22950c-82ec-42dd-9549-2de8b3844f53","description":"\u003Cp\u003EDie F\u00f6rderung des Radverkehrs in K\u00f6ln umfasst mehr als die zeitgem\u00e4\u00dfe Anpassung und den Ausbau der bestehenden Radverkehrsinfrastruktur. Daneben bilden auch B\u00fcrgerservice und \u00d6ffentlichkeitsarbeit sowie die Verbesserung der Parkm\u00f6glichkeiten f\u00fcr Radfahrerinnen und Radfahrer wichtige Schwerpunkte unserer Arbeit. Seit 2009 ver\u00f6ffentlichen wir jedes Jahr einen Ma\u00dfnahmenbericht. Darin werden jeweils sowohl die einzelnen Ma\u00dfnahmen dargestellt, als auch die Rahmenbedingungen und Grund\u00fcberlegungen beschrieben, die unseren Aktivit\u00e4ten zugrunde liegen.\u003C\/p\u003E\u003Cp\u003EHier stellen wir\u00a0Ihnen die Ma\u00dfnahmen vor, die wir seit 2007 umgesetzt haben, um den Anteil des Radverkehrs weiter auszubauen und das Radfahren sicherer zu machen.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Transport und Verkehr","Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Fahrrad Foerderung Koeln","dctModified":"2022-07-26T11:32:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EInformationen zu: Fahrradparken;\u0026nbsp;Radwegsanierung; Schutzstreifen und Markierungen; Verbesserung Radinfrastruktur; \u00d6ffentlichkeitstermine\u003C\/p\u003E","dctIssued":"2017-06-30T08:39:41+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/verkehr\/fahrradverkehr_massnahmen\/MapServer\/0\/query?where=objectid+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Fahrradbeauftragter Stadt K\u00f6ln","hasEmail":"mailto:fahrradbeauftragter@stadt-koeln.de"}],"dctIssued":"2017-06-30T08:37:22+00:00","dctModified":"2025-11-27T14:56:32+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Fahrradbeauftragter Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/verkehr\/radfahren\/index.html"}],"dctContributor":[{"foaf_name":"Fahrradbeauftragter Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/verkehr\/radfahren\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Fahrradbeauftragter Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/verkehr\/radfahren\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Fahrradbeauftragter Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/verkehr\/radfahren\/index.html"}]},{"identifier":"5cd8d774-4a2f-4391-8776-4016e805d297","title":"B\u00e4der K\u00f6ln","description":"\u003Cp\u003EStand 31.05.2017\u003C\/p\u003E\n\u003Cp\u003EAm 1. Januar 1998 \u00fcbernahm die neu gegr\u00fcndete K\u00f6lnB\u00e4der GmbH den Betrieb der st\u00e4dtischen B\u00e4der in K\u00f6ln. Heute h\u00e4lt das Unternehmen mit insgesamt 13 attraktiven Schwimmb\u00e4dern, sieben abwechslungsreichen Saunalandschaften, zwei modernen Fitnessbereichen sowie einer europaweit einmaligen Eisarena mit spektakul\u00e4rer Eishochbahn ein breites Freizeitangebot f\u00fcr die B\u00fcrgerinnen und B\u00fcrger bereit - von M\u00fcngersdorf bis Vingst und von Chorweiler bis Z\u00fcndorf.\u003C\/p\u003E\n\u003Cp\u003EAnteilseigner sind zu 74 Prozent die Stadtwerke K\u00f6ln GmbH und zu 26 Prozent die Stadt K\u00f6ln. Das Unternehmen z\u00e4hlt rund 260 Besch\u00e4ftigte. Ziel der K\u00f6lnB\u00e4der GmbH ist es, die Rahmenbedingungen f\u00fcr die Entwicklung der Hallen-, Kombi- und Freib\u00e4der hin zu modernen Sport- und Freizeiteinrichtungen weiter auszubauen.\u003C\/p\u003E\n\u003Cp\u003EVertraglich hat sich die K\u00f6lnB\u00e4der GmbH dazu verpflichtet, allen K\u00f6lner B\u00fcrgern ein bezahlbares Schwimmangebot zu garantieren und Schul- und Vereinsport zu f\u00f6rdern.\u003C\/p\u003E\n\u003Cp\u003EAktuelle Informationen unter: \u003Ca href=\u0022https:\/\/www.koelnbaeder.de\/home.html\u0022\u003Ehttps:\/\/www.koelnbaeder.de\/home.html\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EHinweis\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDas Kart\u00e4userwallbad ist nicht \u00f6ffentlich: Das Bad wird ausschlie\u00dflich f\u00fcr Schul- und Vereinsschwimmen genutzt.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"contactPoint":[{"fn":"K\u00f6ln B\u00e4der","hasEmail":"info@koelnbaeder.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"K\u00f6ln B\u00e4der"},"distribution":[{"type":"dcat:Distribution","title":"Baeder Standorte Koeln","dctModified":"2022-07-26T08:58:29+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-31T13:07:43+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Baeder_Standort_Koeln.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2017-05-31T15:05:58+02:00","dctModified":"2025-11-27T16:04:43+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"K\u00f6ln B\u00e4der","foaf_homepage":"https:\/\/www.koelnbaeder.de\/"}],"dctContributor":[{"foaf_name":"K\u00f6ln B\u00e4der","foaf_homepage":"https:\/\/www.koelnbaeder.de\/"}],"dcatdeOriginator":[{"foaf_name":"K\u00f6ln B\u00e4der","foaf_homepage":"https:\/\/www.koelnbaeder.de\/"}],"dcatdeMaintainer":[{"foaf_name":"K\u00f6ln B\u00e4der","foaf_homepage":"https:\/\/www.koelnbaeder.de\/"}]},{"type":"dcat:Dataset","title":"Landtagswahl K\u00f6ln 2017","identifier":"77cdbe9b-4209-4791-83dc-40f278c441f1","description":"\u003Cp\u003EBei der Landtagswahl werden die Abgeordneten des nordrhein-westf\u00e4lischen Landtags gew\u00e4hlt. Die Wahl findet am 14. Mai 2017 statt. Wahlberechtigt ist, wer am Wahltag Deutsche oder Deutscher im Sinne des Artikels 116 Absatz 1 des Grundgesetzes ist, das 18. Lebensjahr vollendet hat und mindestens seit dem 16. Tag vor der Wahl in Nordrhein-Westfalen seine Wohnung, bei mehreren Wohnungen seinen Hauptwohnsitz hat oder sich sonst gew\u00f6hnlich aufh\u00e4lt und keine Wohnung au\u00dferhalb des Landes hat.\u003C\/p\u003E\u003Cp\u003EDie Ergebnisse k\u00f6nnen bereits am Wahlabend laufend und aktuell in einem standardisierten Format von diesem Web-Server abgerufen werden, z. B. um automatisch weiterverarbeitet zu werden.\u003Cbr \/\u003EEine Beh\u00f6rde kann zur Pr\u00e4sentation des Wahlergebnisses verschiedene Gebiets-Ebenen einrichten, von der untersten Ebene (Stimmbezirke) \u00fcber Wahlbezirke und Ortsteile bis hin zur Ebene der Stadt bzw. Gemeinde, des Kreises und des Wahlkreises. Dabei sind jedoch nicht alle Ebenen f\u00fcr jeden Wahltyp notwendig. F\u00fcr jede der Gebiets-Ebenen, die eine Beh\u00f6rde eingerichtet hat, gibt es eine Datei mit der \u00dcbersicht derjenigen Gebiete mit bereits eingegangenen Schnellmeldungen. Folgende Dateien stehen am Wahlabend f\u00fcr Stadt K\u00f6ln zur Verf\u00fcgung:\u003C\/p\u003E\u003Cp\u003EDie Dateien sind in UTF-8 codiert. Excel zeigt standardm\u00e4\u00dfig die Umlaute in den Dateien nicht korrekt an. Dies k\u00f6nnen Sie wie folgt umgehen:\u003C\/p\u003E\u003Cp\u003EExcel 2003\u003Cbr \/\u003EW\u00e4hlen Sie \u00fcber das Men\u00fc \u0027Daten\u0027 -\u0026gt; \u0027Externe Daten importieren\u0027 den Men\u00fcpunkt \u0027Daten importieren\u0027 aus. Es \u00f6ffnet sich der Dialog \u0027Datenquelle ausw\u00e4hlen\u0027. W\u00e4hlen Sie hier die zu \u00f6ffnende Datei aus und bet\u00e4tigen Sie die \u0027\u00d6ffnen\u0027-Schaltfl\u00e4che. Im Anschluss legen Sie den Dateiursprung auf \u002765001 Unicode: (UTF-8)\u0027 fest und fahren mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Im n\u00e4chsten Dialog setzten Sie das Trennzeichen auf \u0027Semikolon\u0027 statt auf \u0027Tabstopp\u0027 und fahren erneut mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Anschlie\u00dfend w\u00e4hlen sie als Datenformat der Spalten die Option \u0027Text\u0027 aus und beenden den Assistenten mit der Schaltfl\u00e4ch \u0027Fertig stellen\u0027. Mit der Schaltfl\u00e4che \u0027OK\u0027 beenden Sie die Prozedur und die Daten werden UTF-8 codiert in Microsoft Excel angezeigt.\u003C\/p\u003E\u003Cp\u003EExcel 2010\u003Cbr \/\u003EW\u00e4hlen Sie \u00fcber die Karteikarte \u0027Daten\u0027 im Abschnitt \u0027Externe Daten abrufen\u0027 die Option \u0027Aus Text\u0027 aus. Es \u00f6ffnet sich der Dialog \u0027Textdatei importieren\u0027. W\u00e4hlen Sie hier die zu \u00f6ffnende Datei aus und bet\u00e4tigen Sie die \u0027\u00d6ffnen\u0027-Schaltfl\u00e4che. Im Anschluss legen Sie den Dateiursprung auf \u002765001 Unicode: (UTF-8)\u0027 fest und fahren mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Im n\u00e4chsten Dialog setzten Sie das Trennzeichen auf \u0027Semikolon\u0027 statt auf \u0027Tabstopp\u0027 und fahren erneut mit der Schaltfl\u00e4che \u0027weiter\u0027 fort. Anschlie\u00dfend w\u00e4hlen sie als Datenformat der Spalten die Option \u0027Text\u0027 aus und beenden den Assistenten mit der Schaltfl\u00e4che \u0027Fertig stellen\u0027. Mit der Schaltfl\u00e4che \u0027OK\u0027 beenden Sie die Prozedur und die Daten werden UTF-8 codiert in Microsoft Excel angezeigt.\u003C\/p\u003E\u003Cp\u003EFolgende Felder sind in der Datei vorhanden (Felder f\u00fcr Zweitstimmen nat\u00fcrlich nur bei entsprechenden Wahlen):\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003ENr: Nummer des Wahlbezirks)\u003C\/li\u003E\u003Cli\u003EName: (Bezeichnung des Wahlbezirks)\u003C\/li\u003E\u003Cli\u003EMaxSchnellmeldungen: (maximale Anzahl der Schnellmeldungen)\u003C\/li\u003E\u003Cli\u003EAnzSchnellmeldungen: (Anzahl der bereits erfassten Schnellmeldungen)\u003C\/li\u003E\u003Cli\u003EWahlberechtigte: (Anzahl der Wahlberechtigten)\u003C\/li\u003E\u003Cli\u003Eabgegeben: (Anzahl der abgegebenen Stimmzettel)\u003C\/li\u003E\u003Cli\u003EWahlbeteiligung: (Wahlbeteiligungen in den jeweiligen Ansichtsebenen)\u003C\/li\u003E\u003Cli\u003Eg\u00fcltigeStimmzettel: (Anzahl der g\u00fcltig abgegebenen Stimmzettel)\u003C\/li\u003E\u003Cli\u003Eg\u00fcltig: (Anzahl der g\u00fcltig abgegebenen Erststimmen)\u003C\/li\u003E\u003Cli\u003Eung\u00fcltigeStimmzettel: (Anzahl der ung\u00fcltig abgegebenen Stimmzettel)\u003C\/li\u003E\u003Cli\u003Eung\u00fcltig: (Anzahl der ung\u00fcltig abgegebenen Erststimmen)\u003C\/li\u003E\u003Cli\u003Eg\u00fcltig2: (Anzahl der g\u00fcltig abgegebenen Zweitstimmen)\u003C\/li\u003E\u003Cli\u003Eung\u00fcltig2: (Anzahl der ung\u00fcltig abgegebenen Zweitstimmen)\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003EZus\u00e4tzlich sind f\u00fcr jede Partei folgende Felder vorhanden (Beispiel f\u00fcr eine Partei namens \u0027A-Partei\u0027 - Felder f\u00fcr Zweitstimmen nat\u00fcrlich nur bei entsprechenden Wahlen):\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EA-Partei\u003C\/li\u003E\u003Cli\u003EA-Partei_Proz\u003C\/li\u003E\u003Cli\u003EZ_A-Partei\u003C\/li\u003E\u003Cli\u003EZ_A-Partei_Proz\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003EWahl\u00a0Ebene\u00a0Dateiname\u003Cbr \/\u003ELandtagswahl\u00a0Gemeinde\u00a0Landtagswahl_NRW373.csv\u003Cbr \/\u003ELandtagswahl\u00a0Wahlkreis\u00a0Landtagswahl_NRW3710.csv\u003Cbr \/\u003ELandtagswahl\u00a0Stadtbezirk\u00a0Landtagswahl_NRW378.csv\u003Cbr \/\u003ELandtagswahl\u00a0Stadtteil\u00a0Landtagswahl_NRW3711.csv\u003Cbr \/\u003ELandtagswahl\u00a0Stimmbezirk\u00a0Landtagswahl_NRW376.csv\u003C\/p\u003E\u003Cp\u003EHTML-Code f\u00fcr das Einbinden einer Mini-Grafik des Gesamtergebnisses in eine Homepage\u003Cbr \/\u003EWahl\u00a0Html-Code (Muster)\u003Cbr \/\u003ELandtagswahl\u003Cbr \/\u003E(Erststimme)\u00a0\u0026lt;iframe src=\u0027\u003Ca href=\u0022http:\/\/wahlen.stadt-koeln.de\/prod\/LTW2017\/05315000\/html5\/LandtagswahlErgebnisGrafik.html\u0022\u003Ehttp:\/\/wahlen.stadt-koeln.de\/prod\/LTW2017\/05315000\/html5\/LandtagswahlErg...\u003C\/a\u003E\u0027 frameborder=0 hspace=0 vspace=0 marginwidth=0 marginheight=0 scrolling=no width=500 height=400 frameborder=0\u0026gt; \u0026lt;\/iframe\u0026gt;\u003C\/p\u003E\u003Cp\u003ELandtagswahl\u003Cbr \/\u003E(Zweitstimme)\u00a0\u0026lt;iframe src=\u0027\u003Ca href=\u0022http:\/\/wahlen.stadt-koeln.de\/prod\/LTW2017\/05315000\/html5\/LandtagswahlErgebnisGrafikZ.html\u0022\u003Ehttp:\/\/wahlen.stadt-koeln.de\/prod\/LTW2017\/05315000\/html5\/LandtagswahlErg...\u003C\/a\u003E\u0027 frameborder=0 hspace=0 vspace=0 marginwidth=0 marginheight=0 scrolling=no width=500 height=400 frameborder=0\u0026gt; \u0026lt;\/iframe\u0026gt;\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Politik und Wahlen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/GOVE"}],"distribution":[{"type":"dcat:Distribution","title":"Landtagswahl Koeln 2017 Gemeinde","dctModified":"2022-07-29T15:37:05+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-14T13:31:00+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/wahlen\/landtagswahl\/05-2017\/Landtagswahl_NRW373.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Landtagswahl Koeln 2017 Wahlkreis","dctModified":"2022-07-29T15:37:15+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-14T13:32:42+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/wahlen\/landtagswahl\/05-2017\/Landtagswahl_NRW3710.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Landtagswahl Koeln 2017 Stadtbezirk","dctModified":"2022-07-29T15:37:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-14T13:33:42+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/wahlen\/landtagswahl\/05-2017\/Landtagswahl_NRW378.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Landtagswahl Koeln 2017 Stadtteil","dctModified":"2022-07-29T15:37:38+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-14T13:34:32+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/wahlen\/landtagswahl\/05-2017\/Landtagswahl_NRW3711.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Landtagswahl Koeln 2017 Stimmbezirk","dctModified":"2022-07-29T15:37:50+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-05-14T13:35:26+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/wahlen\/landtagswahl\/05-2017\/Landtagswahl_NRW376.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Wahlamt der Stadt K\u00f6ln","hasEmail":"mailto:wahlamt@stadt-koeln.de"}],"dctIssued":"2017-05-14T13:29:47+00:00","dctModified":"2025-11-19T10:21:30+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dctContributor":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}]},{"identifier":"8466ca22-93b8-4829-9999-922580a87847","title":"VRS Verkehrsdaten GTFS","description":"\u003Cp class=\u0022bodytext\u0022\u003EF\u00fcr komplexere Anwendungen sind zug\u00e4ngliche und maschinenlesbare Verkehrsdaten erforderlich. Daf\u00fcr hat sich das von Google entwickelte Format GTFS (General Transport Feed Specification) durchgesetzt. Die \u003Cstrong\u003EVRS GmbH \u003C\/strong\u003Estellt Fahrplandatendaten in diesem Format zur Verf\u00fcgung.\u003C\/p\u003E\n\u003Cp class=\u0022bodytext\u0022\u003EGTFS-Daten eignen sich f\u00fcr Dienste auf Solldatenbasis um das generelle Fahrplan-Grundangebot anzuzeigen. Sie k\u00f6nnen die Daten nutzbringend mit Mehrwert-Diensten kombinieren (z.B. Umgebungssuchen zu Wohnst\u00e4tten oder \u00c4rzten mit \u00d6V-Erreichbarkeit; touristische Informationen).\u003C\/p\u003E\n\u003Cp class=\u0022bodytext\u0022\u003E\u003Cstrong\u003EInformation\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp class=\u0022bodytext\u0022\u003EDie GTFS-Datens\u00e4tze werden t\u00e4glich zwischen 0 und 1 Uhr aktualisiert.\u00a0\u003C\/p\u003E\n\u003Cp class=\u0022bodytext\u0022\u003E\u003Cstrong\u003EQuelle VRS: \u003Ca href=\u0022https:\/\/www.vrsinfo.de\/fahrplan\/oepnv-daten-fuer-webentwickler.html\u0022\u003Ehttps:\/\/www.vrsinfo.de\/fahrplan\/oepnv-daten-fuer-webentwickler.html\u003C\/a\u003E\u00a0Hier finden Sie zus\u00e4tzliche Informationen und die Nutzungsvereinbarungen\u003C\/strong\u003E\u003C\/p\u003E\n","keyword":["Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"contactPoint":[{"fn":"VRS","hasEmail":"info@vrs.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Verkehrsdaten GTFS","dctModified":"2022-07-15T08:28:05+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by\/4.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dctIssued":"2017-04-06T11:17:01+00:00","downloadURL":"http:\/\/download.vrsinfo.de\/gtfs\/GTFS_VRS_mit_SPNV.zip","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Verkehrsdaten GTFS basierend auf DHID","dctModified":"2022-07-15T08:27:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by\/4.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"description":"\u003Cp\u003EF\u00fcr komplexere Anwendungen sind zug\u00e4ngliche und maschinenlesbare Verkehrsdaten erforderlich. Daf\u00fcr hat sich das von Google entwickelte Format GTFS (General Transport Feed Specification) durchgesetzt. Die\u00a0\u003Cstrong\u003EVRS GmbH\u00a0\u003C\/strong\u003Estellt Fahrplandaten in diesem Format mit Referenzierung auf Global-IDs (deutschlandweit einheitliche Haltestellennummern -\u0026gt; DHID) zur Verf\u00fcgung.\u003Cbr \/\u003E\nGTFS-Daten eignen sich f\u00fcr Dienste auf Solldatenbasis um das generelle Fahrplan-Grundangebot anzuzeigen. Sie k\u00f6nnen die Daten nutzbringend mit Mehrwert-Diensten kombinieren (z.B. Umgebungssuchen zu Wohnst\u00e4tten oder \u00c4rzten mit \u00d6V-Erreichbarkeit; touristische Informationen).\u003Cbr \/\u003E\n\u003Cstrong\u003EInformation\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EQuelle VRS:\u00a0\u003Ca href=\u0022https:\/\/www.vrsinfo.de\/fahrplan\/oepnv-daten-fuer-webentwickler.html\u0022\u003Ehttps:\/\/www.vrsinfo.de\/fahrplan\/oepnv-daten-fuer-webentwickler.html\u003C\/a\u003E\u00a0Hier finden Sie zus\u00e4tzliche Informationen und die Nutzungsvereinbarungen\u003C\/strong\u003E\u003C\/p\u003E\n","dctIssued":"2019-09-02T10:04:15+00:00","downloadURL":"http:\/\/download.vrsinfo.de\/gtfs\/GTFS_VRS_mit_SPNV_hID_GlobalID.zip","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2017-04-06T13:15:44+02:00","dctModified":"2025-11-27T16:03:59+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom VRS erstellt"}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"dctCreator":[{"foaf_name":"VRS","foaf_homepage":"https:\/\/www.vrs.de\/"}],"dctContributor":[{"foaf_name":"VRS","foaf_homepage":"https:\/\/www.vrs.de\/"}],"dcatdeOriginator":[{"foaf_name":"VRS","foaf_homepage":"https:\/\/www.vrs.de\/"}],"dcatdeMaintainer":[{"foaf_name":"VRS","foaf_homepage":"https:\/\/www.vrs.de\/"}]},{"identifier":"4e2a6d81-7123-41d4-919f-f53e9bd8e5de","title":"Kriminalstatistik Stadtgebiet K\u00f6ln 2016","description":"\u003Cp\u003EAuf dieser Seite stellt Ihnen die Polizei K\u00f6ln die Zahlen zur Polizeilichen Kriminalstatistik 2015 f\u00fcr das Stadtgebiet K\u00f6ln als Rohdatenbestand zur Verf\u00fcgung.\u003C\/p\u003E\n\u003Cp\u003EEine grafische Aufbereitung und weitere Statistiken k\u00f6nnen Sie hier abrufen:\u003Cbr \/\u003E\u003Ca href=\u0022http:\/\/www.polizei.nrw.de\/koeln\/kategorie__60.html\u0022\u003Ehttp:\/\/www.polizei.nrw.de\/koeln\/kategorie__60.html\u003C\/a\u003E\u00a0\u003Cbr \/\u003E\u003Ca href=\u0022http:\/\/www.koeln.polizei.nrw.de\/\u0022\u003Ewww.koeln.polizei.nrw.de\u003C\/a\u003E\u003Cbr \/\u003E\n\u00a0\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EInformation:\u003C\/strong\u003E\u003Cbr \/\u003E\nDie gelisteten Rohdaten entstammen folgender Datei:\u00a0\u003Ca href=\u0022http:\/\/www.polizei.nrw.de\/media\/Dokumente\/Behoerden\/Koeln\/pks-2015-koeln.pdf\u0022\u003Ehttp:\/\/www.polizei.nrw.de\/media\/Dokumente\/Behoerden\/Koeln\/pks-2015-koeln.pdf\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EQuelle: Polizei Nordrhein-Westfalen\u003C\/strong\u003E\u00a0\u003Ca href=\u0022http:\/\/www.polizei.nrw.de\/koeln\/index.html\u0022\u003Ehttp:\/\/www.polizei.nrw.de\/koeln\/index.html\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EAltersstruktur:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EKinder \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 bis zur Vollendung des 14. Lebensjahres (es z\u00e4hlt als Stichtag f\u00fcr die Strafm\u00fcndigkeit der 14. Geburtstag)\u003C\/p\u003E\n\u003Cp\u003EJugendliche\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 15 bis unter 18 Jahre\u003C\/p\u003E\n\u003Cp\u003EHeranwachsende \u00a0\u00a0\u00a0\u00a0\u00a0 18 bis unter 21 Jahre\u003C\/p\u003E\n\u003Cp\u003EErwachsene\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 21 bis unter 60 Jahre\u003C\/p\u003E\n\u003Cp\u003ESenioren\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 60+\u003C\/p\u003E\n","keyword":["Gesetze und Justiz"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"contactPoint":[{"fn":"Polizei K\u00f6ln","hasEmail":"poststelle.koeln@polizei.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Polizei K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Altersgruppenverteilung Tatverdaechtige Diebstahl aus KFZ Koeln 2016","dctModified":"2022-07-26T09:35:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-04-05T12:48:21+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Altersgruppenverteilung_Tatverdaechtige_Diebstahl_aus_KFZ_Koeln_2016.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Altersgruppenverteilung Tatverdaechtige Koeln 2016","dctModified":"2022-07-26T09:35:43+00:00","dct_li