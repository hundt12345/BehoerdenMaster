\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2023-03-22T13:36:08+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Unfallstatistik%2520K%25C3%25B6ln%25202018.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2023-03-21T15:57:53+01:00","dctModified":"2025-11-27T16:04:47+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Polizei K\u00f6ln","foaf_homepage":"https:\/\/koeln.polizei.nrw\/service"}],"dctContributor":[{"foaf_name":"Polizei K\u00f6ln","foaf_homepage":"https:\/\/koeln.polizei.nrw\/service"}],"dcatdeOriginator":[{"foaf_name":"Polizei K\u00f6ln","foaf_homepage":"https:\/\/koeln.polizei.nrw\/service"}],"dcatdeMaintainer":[{"foaf_name":"Polizei K\u00f6ln","foaf_homepage":"https:\/\/koeln.polizei.nrw\/service"}]},{"type":"dcat:Dataset","title":"Soziale Erhaltungssatzungen K\u00f6ln","identifier":"f6eb4018-21a9-4433-ae10-8e78e7c1aa21","description":"\u003Cp\u003EDieser Datensatz enth\u00e4lt die Geodaten zu den rechtskr\u00e4ftigen beziehungsweise derzeit in Aufstellung befindlichen Sozialen Erhaltungsgebieten.\u003C\/p\u003E\u003Cp\u003ESoziale Erhaltungssatzungen haben das Ziel, die Wohnbev\u00f6lkerung des Satzungsgebietes vor Verdr\u00e4ngungsprozessen zu sch\u00fctzen. Das Baugesetzbuch gibt St\u00e4dten die M\u00f6glichkeit, f\u00fcr bestimmte Gebiete Soziale Erhaltungssatzungen zu erlassen, um die Zusammensetzung der Wohnbev\u00f6lkerung zu erhalten (\u00a7 172 Absatz 1 Satz 1 Nummer 2 Baugesetzbuch).\u003C\/p\u003E\u003Cp\u003EBei Bauvorhaben sind vor allem die Auswirkungen auf die Struktur des Wohnungsbestandes, zum Beispiel die Gr\u00f6\u00dfe der Wohnungen, die Anzahl der R\u00e4ume, die Ausstattung des vorhandenen Wohnraums sowie die daraus resultierende Mieth\u00f6he entscheidend.\u00a0\u003C\/p\u003E\u003Cp\u003EWeitere Informationen zu den rechtskr\u00e4ftigen bzw. derzeit in Aufstellung befindlichen Sozialen Erhaltungsgebieten finden Sie hier:\u00a0\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/stadtentwicklung\/soziale-erhaltungssatzungen\/\u0022\u003E\u003Cstrong\u003ESoziale Erhaltungssatzungen - Stadt K\u00f6ln\u003C\/strong\u003E\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003EAuf\u00a0dieser Seite finden Sie auch eine WebGIS Karte um zu pr\u00fcfen, ob Ihr Grundst\u00fcck oder Geb\u00e4ude in einem Gebiet mit einer Sozialen Erhaltungssatzung liegt:\u00a0\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/stadtentwicklung\/soziale-erhaltungssatzungen\/karte\/index.html\u0022\u003E\u003Cstrong\u003EGebiete mit Sozialen Erhaltungssatzungen - Stadt K\u00f6ln\u003C\/strong\u003E\u003C\/a\u003E.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"distribution":[{"type":"dcat:Distribution","title":"Gebiete Soziale Erhaltungssatzungen Shapefile","dctModified":"2025-10-14T14:54:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003EStadt K\u00f6ln -\u00a0Amt f\u00fcr Stadtentwicklung und Statistik\u003C\/p\u003E\r\n","description":"\u003Cp\u003EStand: 05\/2025\u003C\/p\u003E","dctIssued":"2023-02-07T13:48:01+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Soziale_Erhaltungssatzung_2.zip","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"},{"type":"dcat:Distribution","title":"Gebiete Soziale Erhaltungssatzungen WFS","dctModified":"2023-10-16T11:31:43+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WFS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EGeodatendienst (Web Feature Service)\u003C\/p\u003E","dctIssued":"2023-10-16T11:01:02+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/services\/politik_und_verwaltung\/soziale_erhaltungssatzung\/MapServer\/WFSServer?request=GetCapabilities\u0026amp;service=WFS","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"},{"type":"dcat:Distribution","title":"Gebiete Soziale Erhaltungssatzungen WMS","dctModified":"2023-10-16T11:32:05+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WMS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EGeodatendienst (Web Map Service)\u003C\/p\u003E","dctIssued":"2023-10-16T10:58:54+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/services\/politik_und_verwaltung\/soziale_erhaltungssatzung\/MapServer\/WMSServer?request=GetCapabilities\u0026amp;service=WMS","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"},{"type":"dcat:Distribution","title":"Gebiete Soziale Erhaltungssatzungen","dctModified":"2023-03-08T09:42:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2023-03-08T09:42:28+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/politik_und_verwaltung\/soziale_erhaltungssatzung\/MapServer?f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/DEVELOP"}],"contactPoint":[{"type":"vcard:Contact","fn":"Stadt K\u00f6ln - Amt f\u00fcr Stadtentwicklung und Statistik","hasEmail":"mailto:soziale.erhaltungssatzung@stadt-koeln.de"}],"dctIssued":"2023-02-07T13:45:23+00:00","dctModified":"2025-11-09T10:51:42+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/IRREG"},"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik (Raumbezogene Statistik)","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}]},{"@type":"dcat:Dataset","title":"GeoPackage Raumbezugssystem K\u00f6ln","identifier":"da2b1d97-57de-4aa8-9002-25d39c4b5117","description":"\u003Cp\u003EDas GeoPackage enth\u00e4lt die im Raumbezugssystem der kommunalen Statistikstelle verwalteten Geodaten in aktueller Version:\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EAlle Ebenen der Kommunalen Gebietsgliederung (Adresse, Stra\u00dfenstruktur, Blockstruktur, Statistisches Quartier, Stadtviertel, Stadtteil, Stadtbezirk, Stadtgebiet)\u003C\/li\u003E\u003Cli\u003EWahlorganisatorische Einheiten (Stimmbezirk, Kommunalwahlbezirk, Landtagswahlkreis, Bundestagswahlkreis)\u003C\/li\u003E\u003Cli\u003EWeitere Gebietsgliederungen (Sozialraum, Postleitzahlgebiet, Schiedsamtsbezirk)\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003EAlle Attribute werden im dem ZIP beigef\u00fcgtem\u00a0PDF erl\u00e4utert. Die gesamte Kommunale Gebietsgliederung wird in dieser\u00a0\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003E\u003Cstrong\u003EVer\u00f6ffentlichung\u003C\/strong\u003E\u003C\/a\u003E\u003Cstrong\u003E\u00a0\u003C\/strong\u003Eerl\u00e4utert.\u003C\/p\u003E\u003Cp\u003EDie Attribute \u201eGeb\u00e4ude ID ALKIS\u201c und \u201eNutzung (Geb\u00e4udefunktion)\u201c der Adressen (siehe Attributbeschreibung) stammen aus dem Amtliches Liegenschaftskataster-Informationssystem (Stadt K\u00f6ln - Amt f\u00fcr Liegenschaften, Vermessung und Kataster). Die Geodaten dazu enth\u00e4lt der Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/amtliches-liegenschaftskataster-koeln\u0022\u003E\u003Cstrong\u003EAmtliches Liegenschaftskataster-Informationssystem Koeln\u003C\/strong\u003E\u003C\/a\u003E\u003Cstrong\u003E.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EUnter Verwandte Ressource sind alle Einzeldatens\u00e4tze in diesem Portal verlinkt.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EGeodatendienste\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDie Adressen der Kommunalen Gebietsgliederung werden auf Grund des gro\u00dfen Umfangs in einem nach Stadtteilen unterteilten Geodatendienst bereitgestellt. Siehe Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/adressen-k%C3%B6ln\u0022\u003EAdresse K\u00f6ln\u003C\/a\u003E.\u003C\/p\u003E\u003Cp\u003EAlle weiteren Ebenen der Kommunalen Gebietsgliederung werden \u00fcber Sammeldienste (WFS und WMS) bereitgestellt. Der WMS ist mit und ohne Beschriftung aufrufbar.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Politik und Wahlen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[6.8529397319055,51.082056200978],[6.8529419374532,51.082003950333],[6.8529772029547,51.081524176405],[6.8530115297498,51.081287860856],[6.8530505830735,51.08105235972],[6.8531615393036,51.080583362115],[6.8531710881043,51.080549233766],[6.853184190258,51.080503211772],[6.8531978409653,51.080456813124],[6.8535870147001,51.079439656843],[6.8541319916778,51.078463517117],[6.8547376653