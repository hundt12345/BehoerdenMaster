name] =\u0026gt; name - Bsp:G\u00fcrtel - A 57 - Ausfahrt Ehrenfeld bis Aachener Stra\u00dfe\u003C\/li\u003E\u003Cli\u003E[auslastung] =\u0026gt; auslastung - Bsp. (0,1 oder 2) 0 = frei 1 = z\u00e4hflie\u00dfend 2 = Stau 16 = keine Anzeige, vermutlich wegen defekter Sensoren 32 = zus\u00e4tzlicher Hinweis im Feld Link (etwa bei Gro\u00dfveranstaltungen)\u003C\/li\u003E\u003Cli\u003E[link] =\u0026gt; link - Bsp. Link zu weiteren Informationen\u003C\/li\u003E\u003Cli\u003E[geometryType] =\u0026gt; esriGeometryPolyline [spatialReference] =\u0026gt; stdClass Object\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDie Aktualisierungszeiten betragen in etwa 5 bis 10 Minuten.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Verkehrskalender der Stadt K\u00f6ln","dctModified":"2023-02-14T14:03:25+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/EXPERIMENTAL"},"dctIssued":"2013-01-25T13:19:34+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/externe-dienste\/open-data\/traffic.php","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\