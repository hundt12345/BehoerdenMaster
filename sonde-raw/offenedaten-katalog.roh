886%2C50.943219\u0026amp;bboxSR=4326\u0026amp;layers=\u0026amp;layerDefs=\u0026amp;size=500%2C500\u0026amp;imageSR=\u0026amp;format=png\u0026amp;transparent=true\u0026amp;dpi=\u0026amp;time=\u0026amp;layerTimeOptions=\u0026amp;dynamicLayers=\u0026amp;gdbVersion=\u0026amp;mapScale=\u0026amp;rotation=\u0026amp;f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","hasEmail":"mailto:liegenschaften-vermessung-kataster@stadt-koeln.de"}],"dctIssued":"2024-05-08T08:43:10+00:00","dctModified":"2025-11-27T15:02:21+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}]},{"identifier":"4a75abc9-6779-400e-920c-06511bfe21d2","title":"Sirenenstandorte K\u00f6ln 2019","description":"\u003Cp\u003ETabellarische \u00dcbersicht der Sirenen in K\u00f6ln.\u003C\/p\u003E\n\u003Cp\u003EBei den Sirenen 1 bis 3, 5 und 6 handelt es sich um pneumatische Sirenen, bei der Sirene 83 um eine mechanische Sirene. Alle anderen Sirenen sind elektronische Sirenen.\u003C\/p\u003E\n\u003Cp\u003EEine Erfassung der L\u00e4ngen- und Breitengrade der Sirenen ist nicht erfolgt.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EWichtig:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EDer gr\u00f6\u00dfte Teil der Sirenen steht auf Grundst\u00fccken und Wohngeb\u00e4uden, bei denen das Betreten durch unbefugte Personen nicht erlaubt ist.\u003C\/strong\u003E\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","hasEmail":"feuerwehr@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Sirenenstandorte Koeln 2019","dctModified":"2025-11-18T07:55:06+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand: 06\/2019\u003C\/p\u003E\n","dctIssued":"2019-06-05T12:19:36+00:00","downloadURL":"https:\/\/w