.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}]},{"type":"dcat:Dataset","title":"Corona Fallzahlen K\u00f6ln ","identifier":"4064ce61-48ae-46c4-a81b-0ec019349279","description":"\u003Cp\u003EDem Datensatz \u003Cstrong\u003ECorona Fallzahlen Koeln \u003C\/strong\u003Ek\u00f6nnen Sie entnehmen wie die Corona-Fallzahlen je K\u00f6lner Stadtteil ausfallen. Der jeweilige Stand ist als Attribut zu jedem Stadtteil hinterlegt. Die Daten werden w\u00f6chentlich aktualisiert.\u00a0\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EErkl\u00e4rung der Attribute:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003Eanzahl_7t:\u00a0 \u00a0 \u00a0 \u00a0Positiv Getestete in den letzten 7 Tagen\u003C\/p\u003E\u003Cp\u003Eanzahl_7t_100k:\u00a0 7-Tage-Inzidenz\u003C\/p\u003E\u003Cp\u003Eanzahl_gesamt:\u00a0 \u00a0Positiv Getestete gesamt\u003C\/p\u003E\u003Cp\u003Eanzahl_aktiv:\u00a0 \u00a0 Positiv Getestete in Quarant\u00e4ne\u003C\/p\u003E\u003Cp\u003Eeinwohner:\u00a0 \u00a0 \u00a0 \u00a0Einwohnerzahl des Stadtteils\u003C\/p\u003E\u003Cp\u003Estand:\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0Stand der Daten\u003C\/p\u003E\u003Cp\u003EAls \u201ePositiv Getestete\u201c gelten Personen,\u00a0bei denen ein\u00a0Covid-19\u00a0PCR-Test mit positivem Ergebnis\u00a0und Adressdaten\u00a0vorliegt. Schnelltests werden nicht ber\u00fccksichtigt.\u00a0\u003C\/p\u003E\u003Cp\u003EDie Daten werden im w\u00f6chentlichen Rhythmus aktualisiert.\u00a0Es kann gelegentlich zu Meldeverz\u00f6gerungen kommen.\u003C\/p\u003E\u003Cp\u003EQuelle Fallzahlen:\u003Cbr \/\u003EGesundheitsamt der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003E\u00a0Quelle Einwohnerzahlen:\u003Cbr \/\u003EAmt f\u00fcr Stadtentwicklung und Statistik der Stadt K\u00f6ln, Stand 31.12.2020\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Geo","Gesundheit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/HEAL"}],"distribution":[{"type":"dcat:Distribution","title":"Corona Fallzahlen Koeln","dctModified":"2022-07-26T10:59:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003E\u0026lt;p\u0026gt;\u0026lt;span\u0026gt;Datenquelle: Stadt K\u00f6ln \u2013 offenedaten-koeln.de\u0026lt;\/span\u0026gt;\u0026lt;\/p\u0026gt;\u003C\/p\u003E\r\n","dctIssued":"2021-05-05T09:30:28+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/politik_und_verwaltung\/covid_stadtteile\/MapServer\/1\/query?where=id+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Redaktion offenedaten-koeln (https:\/\/www.offenedaten-koeln.de\/impressum)","hasEmail":"mailto:e-government@stadt-koeln.de"}],"dctIssued":"2021-05-05T09:23:02+00:00","dctModified":"2025-11-27T15:03:51+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/UPDATE_CONT"},"dctCreator":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dctContributor":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dcatdeOriginator":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dcatdeMaintainer":[{"foaf_name":"Redaktion offenedaten-koeln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}]},{"type":"dcat:Dataset","title":"OParl API Koeln","identifier":"f7dc20a8-8ec9-4e33-9c02-f34ab853d8ad","description":"\u003Cp\u003EDie OParl API erm\u00f6glicht den offenen und maschinenlesbaren Zugriff auf das K\u00f6lner Ratsinformationssystem\u00a0\u003Ca href=\u0022https:\/\/ratsinformation.stadt-koeln.de\/\u0022\u003Ehttps:\/\/ratsinformation.stadt-koeln.de\/\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EInformation (www. oparl.org):\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EOParl ist eine Initiative zur Standardisierung des offenen Zugriffs auf parlamentarische Informationssysteme in Deutschland. Das Ziel von OParl ist die Schaffung einer Standard-API f\u00fcr den Zugang zu \u00f6ffentlichen Inhalten in kommunalen Ratsinformationssystemen, damit die Inhalte daraus im Sinne von Open Data f\u00fcr m\u00f6glichst viele verschiedene Zwecke eingesetzt werden k\u00f6nnen.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003ESpezifikation:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003Ca href=\u0022https:\/\/oparl.org\/spezifikation\/\u0022\u003Ehttps:\/\/oparl.org\/spezifikation\/\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Politik und Wahlen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/GOVE"}],"distribution":[{"type":"dcat:Distribution","title":"OParl API Koeln","dctModified":"2022-07-26T10:56:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003E\u0026lt;p\u0026gt;Die Namensnennung der Stadt K\u00f6ln als Rechteinhaber hat in folgender Weise zu erfolgen:\u0026amp;nbsp; \u201cDatenquelle: Stadt K\u00f6ln \u2013 offenedaten-koeln.de\u201d\u0026lt;\/p\u0026gt;\u003C\/p\u003E\r\n","description":"\u003Cp\u003EDer Soft-Standard OParl ist darauf ausgelegt, schnell und einfach Anwendungen auf Basis der Daten zu entwickeln. OParl beschreibt eine JSON-Schnittstelle und folgt vielen REST-Prinzipien.\u003C\/p\u003E","dctIssued":"2021-05-03T05:40:13+00:00","downloadURL":"https:\/\/buergerinfo.stadt-koeln.de\/oparl\/bodies","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"offenedaten-koeln.de","hasEmail":"mailto:e-government@stadt-koeln.de"}],"dctIssued":"2021-05-03T05:37:02+00:00","dctModified":"2025-11-27T15:03:46+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[{"dct_standard":"https:\/\/oparl.org\/spezifikation\/"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"dctCreator":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dctContributor":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dcatdeOriginator":[{"foaf_name":"Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}],"dcatdeMaintainer":[{"foaf_name":"Redaktion offenedaten-koeln","foaf_homepage":"https:\/\/www.offenedaten-koeln.de\/impressum"}]},{"@type":"dcat:Dataset","title":"Statistische Quartiere K\u00f6ln","identifier":"4b4d73a9-5a45-4c1d-8b01-cefb0fd8d319","description":"\u003Cp\u003EEin Statistisches Quartier ist Teil der Kommunalen Gebietsgliederung. Dieses hierarchische System gliedert das K\u00f6lner Stadtgebiet auf verschiedenen Ebenen in eine Stadtstruktur und Blockstruktur. Weitere Bestandteile sind eine Stra\u00dfenstruktur und Adressen. Die Statistischen Quartiere wurden im Jahr 2020 als Nachfolger der Stadtviertel f\u00fcr kleinr\u00e4umige statistische Auswertung in die Kommunalen Gebietsgliederung aufgenommen, da diese nicht mehr ge\u00e4nderte datenschutzrechtliche Anforderungen erf\u00fcllten.\u00a0Die gesamte Kommunale Gebietsgliederung wird in dieser \u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003EVer\u00f6ffentlichung\u003C\/a\u003E erl\u00e4utert.\u003Cbr \/\u003EDefinition: Statistische Quartiere sind durch Teilung, Zusammenf\u00fcgen oder Beibehalten von Stadtvierteln mit dem Ziel entstanden, homogenere demografische Strukturen zu bilden, indem die Bev\u00f6lkerungszahl eines Gebietes zwischen 1000 und 3000 liegen sollte. Als weiteres Ziel wurde die Zuordnung aller bewohnten K\u00f6lner Adressen formuliert.\u00a0\u003Cstrong\u003EDie Statistischen Quartiere sind seit Mai 2025 fl\u00e4chendeckende Geometrien. Entsprechend gibt es keine Exklaven mehr.\u003C\/strong\u003E\u003Cbr \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003Cbr \/\u003EKoordinatensystem\u00a0KMZ \u0026amp; JSON:\u00a0WGS 1984\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten und weitere Gebietsgliederungen enth\u00e4lt der Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-koeln\u0022\u003ERaumbezugssystem Geopackage\u003C\/a\u003E.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[6.8529397319055,51.082056200978],[6.8529419374532,51.082003950333],[6.8529772029547,51.081524176405],[6.8530115297498,51.081287860856],[6.8530505830735,51.08105235972],[6.8531615393036,51.080583362115],[6.8531710881043,51.080549233766],[6.853184190258,51.080503211772],[6.8531978409653,51.080456813124],[6.8535870147001,51.079439656843],[6.8541319916778,51.078463517117],[6.854737665366,51.077651616964],[6.8548329625