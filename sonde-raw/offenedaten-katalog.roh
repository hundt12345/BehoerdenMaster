ch bitte an Tobias Escher unter \u003Ca href=\u0022mailto:escher@diid.hhu.de\u0022\u003Eescher@diid.hhu.de\u003C\/a\u003E .\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Ehrenfeld_Beitraege_20180130_oeffentlich","dctModified":"2022-07-11T10:21:12+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2018-02-07T10:56:27+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Ehrenfeld%2520Beitraege%252020180130%2520oeffentlich.json","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/by-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Ehrenfeld_Kommentare_20180130_oeffentlich","dctModified":"2022-07-26T11:21:36+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/