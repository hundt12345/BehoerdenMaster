iticalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Ruhige Orte","dctModified":"2024-06-13T09:23:01+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T09:23:01+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/167\/export\/posts\/export_dialog_posts_167_ruhige_gebiete.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T09:22:31+00:00","dctModified":"2025-11-27T14:54:59+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: Pilotprojekt Schulstra\u00dfen","identifier":"16c989a4-b751-4b17-bc62-c47c84e6cfff","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EViele Autos vor Schulen bringen viele Gefahren mit sich. Deswegen m\u00f6chten wir mit 4 Schulen sogenannte Schulstra\u00dfen als Pilotprojekt testen. Daf\u00fcr wird die Stra\u00dfe vor der Schule vor Schulbeginn und je nach Standort nach Schulende f\u00fcr einen kurzen Zeitraum f\u00fcr Autos gesperrt. Es gibt dann ein Einfahrtsverbot f\u00fcr motorisierten Verkehr.\u003C\/p\u003E\u003Cp\u003EWir testen das Pilotprojekt seit Anfang 2023 bereits mit zwei Schulen im Stadtbezirk Ehrenfeld. Seit\u00a0Beginn des Schuljahres 2023\/2024 nehmen auch die Rosenmaarschule und die Gemeinschaftsgrundschule Diesterwegstra\u00dfe in den rechtsrheinischen Stadtteilen H\u00f6henhaus und Br\u00fcck teil. Hier ist die Verkehrssituation anders, was uns neue Erkenntnisse liefert: Die beiden neuen Schulstra\u00dfen liegen an Einbahnstra\u00dfen. Zudem handelt es sich um Einfamilienhaussiedlungen.\u00a0An allen vier Schulen gibt es ein besonders hohes Aufkommen an sogenannten Elterntaxis und teilweise auch einen hohen Durchgangsverkehr. Eltern und Schulvertretungen haben an dem Konzept f\u00fcr die Schulstra\u00dfe mitgewirkt.\u003C\/p\u003E\u003Cp\u003EF\u00fcr Einsatz- und Rettungsfahrzeuge ist ein uneingeschr\u00e4nktes Befahren selbstverst\u00e4ndlich erlaubt.\u00a0\u003C\/p\u003E\u003Cp\u003EAnlieger*innen d\u00fcrfen in dem bestimmten Zeitraum von ihrem Grundst\u00fcck, ihrer Garage oder einem Parkplatz lediglich ausfahren.\u00a0\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/87\u0022\u003EOnline-Dialog: Pilotprojekt Schulstra\u00dfen | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Pilotprojekt Schulstra\u00dfen","dctModified":"2024-06-13T09:19:54+00:00","dct_license