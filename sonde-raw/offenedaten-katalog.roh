ps:\/\/www.landesdatenbank.nrw.de"}]},{"type":"dcat:Dataset","title":"Abfallentsorgung: Abfallaufkommen nach Arten von Abfall","identifier":"f1bdd3f6-ca37-416e-be35-53fa9d1955f5","description":"\u003Cp\u003EAbfallentsorgung: Abfallaufkommen nach Arten von Abfall.\u003C\/p\u003E\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32121-02i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDie Erhebung erfasst die bei den Haushalten angefallenen und den \u00f6ffentlich-rechtlichen Entsorgungstr\u00e4gern (\u00f6rE) \u00fcberlassenen Haushaltsabf\u00e4lle einschlie\u00dflich Verpackungen der Dualen Systeme sowie l\u00e4nderspezifisch Haushaltsabf\u00e4lle aus privaten und gemeinn\u00fctzigen Sammlungen bzw. f\u00fcr die Erhebung \u00fcber Eigenkompostierung die bei den \u00f6ffentlich-rechtlichen Entsorgungstr\u00e4gern vorliegenden Angaben \u00fcber die Anzahl an Anfallstellen von Bioabf\u00e4llen aus Haushalten. 1.2 Statistische Einhe\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"keyword":["Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Abfallaufkommen nach Arten von Abfall XML","dctModified":"2025-11-17T11:10:00+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T12:54:07+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32121-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}},{"type":"dcat:Distribution","title":"Abfallaufkommen nach Arten von Abfall CSV","dctModified":"2025-11-17T11:09:22+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T12:54:37+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32121-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}},{"type":"dcat:Distribution","title":"Abfallaufkommen nach Arten von Abfall XLSX","dctModified":"2025-11-17T11:09:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-12T12:55:04+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32121-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Landesdatenbank NRW","hasEmail":"mailto:statistik-info@it.nrw.de"}],"admsIdentifier":["32121-02i"],"dctIssued":"2024-06-12T12:53:45+00:00","dctModified":"2025-11-27T14:52:00+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"864b8a0f-745f-4eb6-b614-2ff3ad81e736","title":"Abfallentsorgung: Entsorgungs- und Behandlungsanlagen, Abfallmenge","description":"\u003Cp\u003EAbfallentsorgung:\u003Cbr \/\u003E\nEntsorgungs- und Behandlungsanlagen, Abfallmenge.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32111-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erhebung der Abfallentsorgung gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nbehandelten Abf\u00e4lle in Abfallentsorgungsanlagen. Hierbei\u003Cbr \/\u003E\nsind Art, Menge, Beschaffenheit, Herkunft und Verbleib der\u003Cbr \/\u003E\nbehandelten Abf\u00e4lle Kernmerkmale der Erhebung. Die Statistik\u003Cbr \/\u003E\nwird j\u00e4hrlich erhoben. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\ndie Betreiber von zulassungsbed\u00fcrftigen Abfallentsorgungs-\u003Cbr \/\u003E\nanlagen.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nkreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n","keyword":["Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Abfallentsorgung: Entsorgungs- und Behandlungsanlagen, Abfallmenge XML","dctModified":"2025-11-17T11:08:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T12:43:38+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32111-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Abfallentsorgung: Entsorgungs- und Behandlungsanlagen, Abfallmenge CSV","dctModified":"2025-11-17T11:08:10+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T12:43:58+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32111-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Abfallentsorgung: Entsorgungs- und Behandlungsanlagen, Abfallmenge XLSX","dctModified":"2025-11-17T11:08:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-12T12:44:23+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32111-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"dctIssued":"2024-06-12T14:43:08+02:00","dctModified":"2025-11-27T15:50:56+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"35e7edfb-8866-4860-8a00-b50aa32daa52","title":"Entgelt f\u00fcr die Trink- und Abwasserversorgung privater Haushalte nach Art des Entgelts","description":"\u003Cp\u003EEntgelt f\u00fcr die Trink- und Abwasserversorgung privater Haushalte nach Art des Entgelts.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32271-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Ch3 class=\u0022h3-section mb-3\u0022\u003E\u003Cstrong\u003EErl\u00e4uterung\u003C\/strong\u003E\u003C\/h3\u003E\n\u003Cp\u003EIn den F\u00e4llen, in denen pro Gemeinde mehrere Unternehmen mit\u003Cbr \/\u003E\nunterschiedlichen Entgelten t\u00e4tig sind, wird ein gewichtetes\u003Cbr \/\u003E\nDurchschnittsentgelt auf Gemeindeebene berechnet. Dabei\u003Cbr \/\u003E\nwerden die Entgelte mit der Anzahl der angeschlossenen Ein-\u003Cbr \/\u003E\nwohner gewichtet. Oberhalb der Gemeindeebene wird das\u003Cbr \/\u003E\nDurchschnittsentgelt als gewichtetes Mittel auf der\u003Cbr \/\u003E\nGrundlage der Einwohnerzahl insgesamt ermittelt. Bei der\u003Cbr \/\u003E\nGewichtung werden generell alle Einwohner einbezogen, d.h.\u003Cbr \/\u003E\nauch die Einwohner, die kein verbrauchsabh\u00e4ngiges bzw.\u003Cbr \/\u003E\n-unabh\u00e4ngiges Entgelt bezahlen. Es handelt sich um\u003Cbr \/\u003E\nBrutto-Angaben (einschlie\u00dflich Mehrwertsteuer, soweit\u003Cbr \/\u003E\nerhoben).\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Entgelt f\u00fcr die Trink- und Abwasserversorgung privater Haushalte nach Art des Entgelts XML","dctModified":"2025-11-17T11:22:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T12:37:05+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32271-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Entgelt f\u00fcr die Trink- und Abwasserversorgung privater Haushalte nach Art des Entgelts CSV","dctModified":"2025-11-17T11:22:19+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T12:37:31+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32271-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Entgelt f\u00fcr die Trink- und Abwasserversorgung privater Haushalte nach Art des Entgelts XLSX","dctModified":"2025-11-17T11:22:32+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-12T12:38:01+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32271-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"dctIssued":"2024-06-12T14:36:41+02:00","dctModified":"2025-11-27T15:54:25+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"f70497e2-391a-4c9b-8c61-4ff188e1fe5d","title":"Wasserversorg.\/Abwasserbeseit. im Verarbeitenden Gewerbe: Wasseraufkommen nach Eigengewinnung und Wasserarten bzw. nach Fremdbezug ","description":"\u003Cp\u003EWasserversorg.\/Abwasserbeseit. im Verarbeitenden Gewerbe: Wasseraufkommen nach Eigengewinnung und Wasserarten bzw. nach Fremdbezug.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32231-04d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erhebung der Wasserversorgung und Abwasserbeseitigung im\u003Cbr \/\u003E\nBergbau, bei der Gewinnung von Steinen und Erden und im\u003Cbr \/\u003E\nVerarbeitenden Gewerbe gibt einen \u00dcberblick \u00fcber die\u003Cbr \/\u003E\nGesamtsituation der gewerblichen Wasserversorgung und\u003Cbr \/\u003E\nAbwasserbeseitigung. Die Wassergewinnung und -verwendung der\u003Cbr \/\u003E\nBetriebe nach Einsatzbereichen, die Wasser- und\u003Cbr \/\u003E\nKl\u00e4rschlammbehandlung sowie die Zahl der t\u00e4tigen Personen\u003Cbr \/\u003E\nsind Kernmerkmale, die dreij\u00e4hrig erhoben werden. Die\u003Cbr \/\u003E\nDatenerhebung erfolgt bei Betrieben in den o. g.\u003Cbr \/\u003E\nWirtschaftsbereichen, die Wasser gewinnen oder ein\u003Cbr \/\u003E\nWasseraufkommen von j\u00e4hrlich mindestens 10.000 Kubikmeter\u003Cbr \/\u003E\nhaben oder Abwasser aus betriebseigenen Anlagen direkt \u00fcber\u003Cbr \/\u003E\neigene Kanalisationen in ein Gew\u00e4sser oder den Untergrund\u003Cbr \/\u003E\neinleiten. R\u00e4umlich differenziert sind die Daten bis auf die\u003Cbr \/\u003E\nEbene der kreisfreien St\u00e4dte und Kreise.\u003Cbr \/\u003E\nDie Erhebung wurde in dieser Form letztmalig im Jahr 2004\u003Cbr \/\u003E\ndurchgef\u00fchrt.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Wasserversorg.\/Abwasserbeseit. im Verarbeitenden Gewerbe: Wasseraufkommen nach Eigengewinnung und Wasserarten bzw. nach Fremdbezug  XML","dctModified":"2025-11-17T11:19:07+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T12:16:40+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32231-04i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Wasserversorg.\/Abwasserbeseit. im Verarbeitenden Gewerbe: Wasseraufkommen nach Eigengewinnung und Wasserarten bzw. nach Fremdbezug  CSV","dctModified":"2025-11-17T11:17:21+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-12T12:17:14+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32231-04i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["32231-04d"],"adms:Identifier":[{"title":"32231-04d"}],"dctIssued":"2024-06-12T14:13:58+02:00","dctModified":"2025-11-27T15:54:07+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"2883ef47-8acc-4b72-b4f0-1367f12469d4","title":"Fortschr. Wohngeb\u00e4ude- u. Wohnungsbestand: Wohngeb\u00e4ude, Wohnungen und Wohnfl\u00e4che nach Anzahl der Wohnungen","description":"\u003Cp\u003EFortschr. Wohngeb\u00e4ude- u. Wohnungsbestand: Wohngeb\u00e4ude, Wohnungen und Wohnfl\u00e4che nach Anzahl der Wohnungen.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=31231-03d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Fortschreibung der Wohngeb\u00e4ude- und Wohnungsbest\u00e4nde\u003Cbr \/\u003E\nerfolgt jeweils zwischen den Geb\u00e4ude- und Wohnungsz\u00e4hlungen.\u003Cbr \/\u003E\nAls Anfangsbestand findet das jeweils letzte\u003Cbr \/\u003E\nZ\u00e4hlungsergebnis Verwendung, das bis zur n\u00e4chsten Z\u00e4hlung\u003Cbr \/\u003E\nmit den j\u00e4hrlichen Ergebnissen der Baufertigstellungs- und\u003Cbr \/\u003E\nBauabgangsstatistik fortgeschrieben wird. Gegenstand der\u003Cbr \/\u003E\nFortschreibung des Wohnungsbestandes sind die Merkmale\u003Cbr \/\u003E\nAnzahl der Wohnungen, untergliedert nach der Anzahl der\u003Cbr \/\u003E\nR\u00e4ume, Gesamtzahl der R\u00e4ume und die Wohnfl\u00e4che sowie die\u003Cbr \/\u003E\nAnzahl der Wohngeb\u00e4ude in der Untergliederung nach Ein-,\u003Cbr \/\u003E\nZwei- und Mehrfamilienh\u00e4usern sowie Wohnheimen. R\u00e4umlich\u003Cbr \/\u003E\ndifferenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nGemeinden.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Wohngeb\u00e4ude, Wohnungen und Wohnfl\u00e4che nach Anzahl der Wohnungen XML","dctModified":"2025-11-17T11:05:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de