\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22518-07i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["22518-07i"],"adms:Identifier":[{"title":"22518-07i"}],"dctIssued":"2024-05-21T10:59:06+02:00","dctModified":"2025-11-27T15:53:12+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"c66477ce-06e4-4dd4-b9f2-7a15e4c5a1b7","title":"Statistik der erzieherischen Hilfen: In Anspruch genommene und begonnene Hilfen\/Beratungen nach Art der Hilfe und Alter","description":"\u003Cp\u003EStatistik der erzieherischen Hilfen: In Anspruch genommene und begonnene Hilfen\/Beratungen nach Art der Hilfe und Alter.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=22517-07i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=22517-07i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003E\u00dcber alle ambulanten, teilstation\u00e4ren und station\u00e4ren\u003Cbr \/\u003E\nerzieherischen Hilfen sowie \u00fcber die Eingliederungshilfen\u003Cbr \/\u003E\nf\u00fcr seelisch behinderte junge Menschen sowie die Hilfen f\u00fcr\u003Cbr \/\u003E\njunge Vollj\u00e4hrige nach dem SGB VIII wird bei allen\u003Cbr \/\u003E\n\u00f6rtlichen Tr\u00e4gern der \u00f6ffentlichen Jugendhilfe\u003Cbr \/\u003E\n(Jugend\u00e4mtern) j\u00e4hrlich eine Totalerhebung durchgef\u00fchrt.\u003Cbr \/\u003E\nMit den Erziehungsberatungsstellen (\u00a7 28 SGB VIII) werden\u003Cbr \/\u003E\nauch die Beratungsstellen eines Tr\u00e4gers der freien\u003Cbr \/\u003E\nJugendhilfe in die statistische Erhebung mit einbezogen.\u003Cbr \/\u003E\nDie Zahlen beinhalten die beendeten und andauernden Hilfen\u003Cbr \/\u003E\n(Inanspruchnahmen), die gem\u00e4\u00df den \u00a7\u00a7 27 - 35a sowie 41 SGB\u003Cbr \/\u003E\nVIII innerhalb eines Kalenderjahres gew\u00e4hrt werden.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nJugendamtsbezirke.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Statistik der erzieherischen Hilfen: In Anspruch genommene und begonnene Hilfen\/Beratungen nach Art der Hilfe und Alter XML","dctModified":"2025-11-12T15:05:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-21T08:27:15+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22517-07i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Statistik der erzieherischen Hilfen: In Anspruch genommene und begonnene Hilfen\/Beratungen nach Art der Hilfe und Alter CSV","dctModified":"2025-11-12T15:05:01+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-21T08:27:46+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22517-07i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Statistik der erzieherischen Hilfen: In Anspruch genommene und begonnene Hilfen\/Beratungen nach Art der Hilfe und Alter XLSX","dctModified":"2025-11-12T15:05:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-21T08:28:20+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22517-07i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["22517-07i"],"adms:Identifier":[{"title":"22517-07i"}],"dctIssued":"2024-05-21T10:26:14+02:00","dctModified":"2025-11-27T15:52:33+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"b0759784-f7a3-4209-96ec-cad77c5ad79f","title":"Station\u00e4re Pflegeeinrichtungen: Pflegebed\u00fcrftige in Pflegeheimen nach Pflegegrad und Art der Pflegeleistung (bis 2021)","description":"\u003Cp\u003EStation\u00e4re Pflegeeinrichtungen: Pflegebed\u00fcrftige in Pflegeheimen nach Pflegegrad und Art der\u003Cbr \/\u003E\nPflegeleistung.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=22412-02i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=22412-02i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErl\u00e4uterung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EErhoben werden Daten \u00fcber die Pflegeeinrichtungen, deren\u003Cbr \/\u003E\nPersonal sowie \u00fcber die von den Einrichtungen betreuten\u003Cbr \/\u003E\nPflegebed\u00fcrftigen. Die Statistik bietet den L\u00e4ndern und\u003Cbr \/\u003E\nKreisen eine wichtige Entscheidungsgrundlage f\u00fcr ihre\u003Cbr \/\u003E\nPlanungen zur pflegerischen Versorgungsstruktur\u003Cbr \/\u003E\nentsprechend \u00a7 9 des SGB XI. Um Entwicklungen in der\u003Cbr \/\u003E\npflegerischen Versorgung und in der Nachfrage nach\u003Cbr \/\u003E\npflegerischen Angeboten rechtzeitig erkennen und angemessen\u003Cbr \/\u003E\nreagieren zu k\u00f6nnen, ist eine aussagekr\u00e4ftige Datenbasis\u003Cbr \/\u003E\nunerl\u00e4sslich. Dabei werden erg\u00e4nzend, um ein statistisches\u003Cbr \/\u003E\nGesamtbild \u00fcber die h\u00e4usliche Nachfrage nach\u003Cbr \/\u003E\nPflegeleistungen zu erhalten, auch die Daten der Statistik\u003Cbr \/\u003E\nder Pflegegeldempf\u00e4nger\/-innen herangezogen.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Station\u00e4re Pflegeeinrichtungen: Pflegebed\u00fcrftige in Pflegeheimen nach Pflegegrad und Art der Pflegeleistung  XML","dctModified":"2025-11-12T15:03:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-17T10:29:04+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22412-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Station\u00e4re Pflegeeinrichtungen: Pflegebed\u00fcrftige in Pflegeheimen nach Pflegegrad und Art der Pflegeleistung CSV","dctModified":"2025-11-12T15:03:23+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-17T10:29:45+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=22412-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Station\u00e4re Pflegeeinrichtungen: Pflegebed\u00fcrftige in Pflegeheimen nach Pflegegrad und Art der Pflegeleistung XLSX","dctModified":"2025-11-12T15:03:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-17T10:30:07+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/onlin