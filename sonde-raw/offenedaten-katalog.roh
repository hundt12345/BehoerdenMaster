l\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Freie Idee REK Liebigquartier","dctModified":"2024-06-13T08:43:15+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T08:43:15+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/155\/export\/posts\/export_dialog_posts_155_freie_idee_rek_liebigquartier.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T08:42:50+00:00","dctModified":"2025-11-27T14:54:36+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: Erneuerung der Stra\u00dfenbeleuchtung in der Alteburger Stra\u00dfe in Bayenthal","identifier":"5f303b50-15a4-4454-b254-05626cbf27bc","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV Format.\u003C\/p\u003E\u003Cp\u003EIn der Alteburger\u003Cstrong\u003E\u00a0\u003C\/strong\u003EStra\u00dfe\u003Cstrong\u003E\u00a0\u003C\/strong\u003Em\u00fcssen im Abschnitt zwischen der Bahnunterf\u00fchrung\/Kyllstra\u00dfe bis zum Bayenthalg\u00fcrtel die Stra\u00dfenleuchten erneuert werden. Die vorhandene Stra\u00dfenbeleuchtung besteht derzeit aus Peitschenmasten und Normmasten mit Langfeldleuchten sowie Peitschenmasten mit Kofferleuchten. Die Beleuchtungsanlage ist \u00fcber 50 Jahre alt, sanierungsbed\u00fcrftig und entspricht auch nicht mehr den aktuellen Richtlinien zur Stra\u00dfen- und Wegebeleuchtung.\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/KAG\/26052K\u0022\u003EErneuerung der Stra\u00dfenbeleuchtung in der Alteburger Stra\u00dfe in Bayenthal (26052K) | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Erneuerung der Stra\u00dfenbeleuchtung in der Alteburger Stra\u00dfe in Bayenthal","dctModified":"2025-11-17T11:48:39+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T08:36:51+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/130\/export\/posts\/export_dialog_posts_130_erneuerung_der_strassenbeleuch.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T08:35:19+00:00","dctModified":"2025-11-27T14:54:45+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: Bewegungsstation in Merkenich","identifier":"1c670563-f643-4a52-9e0f-b305f4847540","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV Format.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EWie soll die neue Bewegungsstation in Merkenich hei\u00dfen?\u003Cbr \/\u003EBitte beachten Sie, dass der Name f\u00fcr die Bewegungsstation folgende Kriterien erf\u00fcllen muss:\u003C\/p\u003E\u003Cp\u003E1. Bezug zum Sport oder Bewegung,\u003C\/p\u003E\u003Cp\u003E2. Erkennungsmerkmal des Ortes und\u003C\/p\u003E\u003Cp\u003E3. Identit\u00e4tsstiftend\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/223\u0022\u003EBewegungsstation in Merkenich | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Bewegungsstation in Merkenich","dctModified":"2025-10-01T06:33:17+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T08:30:35+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/223\/export\/posts\/export_dialog_posts_223_bewegungsstation_in_merkenich.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T08:27:27+00:00","dctModified":"2025-11-27T14:54:56+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: Alte Stra\u00dfe in Worringen","identifier":"47c201f0-a37d-48fd-a8be-f471ae5d6086","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EIn der Alte Stra\u00dfe in Worringen m\u00fcssen die Stra\u00dfenleuchten erneuert werden. Die vorhandene Stra\u00dfenbeleuchtung besteht derzeit haupts\u00e4chlich aus Peitschenmasten mit Langfeldleuchten bzw. Normmasten mit Kofferleuchten und ist teilweise 45 Jahre alt. Die Beleuchtungsanlage ist u. a. aufgrund von Rostbefall dringend sanierungsbed\u00fcrftig und entspricht auch nicht mehr den aktuellen Richtlinien zur Stra\u00dfen- und Wegebeleuchtung. Sie soll durch 6 Meter hohe Normmasten mit Aufsatzleuchten vom Typ Iridium-4 LED (siehe Bild unter \u201eDownloadservice\u201c) ersetzt werden. In der Alte Stra\u00dfe sollen drei Maste, die bereits erneuert wurden, bestehen bleiben. Dort findet lediglich ein Leuchtenwechsel statt, ein Mast wird zudem versetzt.\u003C\/p\u003E\u003Cp\u003EDurch diese Erneuerungsma\u00dfnahme wird sich die Ausleuchtung der Stra\u00dfe erheblich verbessern. Bei den zur Verwendung vorgesehenen Leuchten handelt es sich um die Standardleuchte aus dem Leuchtenkatalog f\u00fcr die Stadt K\u00f6ln f\u00fcr Stra\u00dfentypen entsprechend der Alte Stra\u00dfe.\u003C\/p\u003E\u003Cp\u003EDie Ma\u00dfnahme wird von der RheinEnergie AG geplant und ausgef\u00fchrt, da diese nach dem Stra\u00dfenbeleuchtungsvertrag aus Juni 2015 die Dienstleistung \u201eBeleuchtete Stadt\u201c f\u00fcr die Stadt K\u00f6ln erbringt.\u003C\/p\u003E\u003Cp\u003EIn der Alte Stra\u00dfe soll in Zukunft auch eine Erneuerung der Fahrbahn erfolgen. Die Sanierung ist notwendig, da die Fahrbahn altersbedingt erhebliche Sch\u00e4den aufweist. Die Erneuerung der Fahrbahn wurde am 20.08.2020 von der Bezirksvertretung Chorweiler und am 07.09.2020 vom Finanzausschuss der Stadt K\u00f6ln beschlossen (\u003Ca href=\u0022https:\/\/ratsinformation.stadt-koeln.de\/vo0050.asp?__kvonr=96141\u0026amp;voselect=21547\u0022\u003ELink zur Beschlussvorlage\u003C\/a\u003E). Aktuell ist davon auszugehen, dass die Arbeiten an der Fahrbahn fr\u00fchestens 2025 beginnen werden.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u00a0\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/KAG\/22946K\u0022\u003EAlte Stra\u00dfe in Worringen | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Alte Stra\u00dfe in Worringen","dctModified":"2024-06-13T08:38:11+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T08:25:19+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/183\/export\/posts\/export_dialog_posts_183_alte_strasse_in_worringen.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T08:24:26+00:00","dctModified":"2025-11-27T14:54:51+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"identifier":"449300af-af2c-4f4f-8687-36325bca28fa","title":"Erzeuger von prim\u00e4r nachgewiesene Abfallmengen, Abgegebene Abfallmenge an Entsorger und nach Verbleib der \u00fcberwachungs- bed\u00fcrftigen Abf\u00e4llen","description":"\u003Cp\u003EErzeuger von prim\u00e4r nachgewiesene Abfallmengen, Abgegebene Abfallmenge an Entsorger und nach Verbleib der \u00fcberwachungs- bed\u00fcrftigen Abf\u00e4llen.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32151-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erhebung der gef\u00e4hrlichen Abf\u00e4lle gibt Auskunft \u00fcber die\u003Cbr \/\u003E\nArt, Menge und Herkunft der gef\u00e4hrlichen Abf\u00e4lle, \u00fcber die\u003Cbr \/\u003E\nNachweise gef\u00fchrt werden m\u00fcssen. Die Statistik wird j\u00e4hrlich\u003Cbr \/\u003E\nerhoben. Die Datenbereitstellung erfolgt von den f\u00fcr die\u003Cbr \/\u003E\n\u00dcberwachung der Entsorgung gef\u00e4hrlicher Abf\u00e4lle zust\u00e4ndigen\u003Cbr \/\u003E\nLandesbeh\u00f6rden. R\u00e4umlich differenziert sind die Daten bis\u003Cbr \/\u003E\nauf die Ebene der kreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Erzeuger von prim\u00e4r nachgewiesene Abfallmengen, Abgegebene Abfallmenge an Entsorger und nach Verbleib der \u00fcberwachungs- bed\u00fcrftigen Abf\u00e4llen XML","dctModified":"2025-11-17T11:15:10+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-12T13:04:23+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32151-01i\u0026amp;option=xml\u0026amp;zeit