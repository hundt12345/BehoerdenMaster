Geocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Diversity Kalender 2025","dctModified":"2025-11-18T07:45:56+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-11-26T11:16:39+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Diversity%2520Kalender%25202025_2.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/2.0\/spec\/"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"B\u00fcro f\u00fcr Diversity-Management Stadt K\u00f6ln","hasEmail":"mailto:diversity@stadt-koeln.de"}],"dctIssued":"2024-11-26T11:15:42+00:00","dctModified":"2025-11-27T15:02:52+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"B\u00fcro f\u00fcr Diversity-Management Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/buero-fuer-diversity-management"}],"dctContributor":[{"foaf_name":"B\u00fcro f\u00fcr Diversity-Management Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/buero-fuer-diversity-management"}],"dcatdeOriginator":[{"foaf_name":"B\u00fcro f\u00fcr Diversity-Management Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/buero-fuer-diversity-management"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Integration und Vielfalt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/buero-fuer-diversity-management"}]},{"identifier":"3114b14d-5ee5-483e-86ab-6b3eeea230e7","title":"Jugendfeuerwehr K\u00f6ln Personalzahlen 2023","description":"\u003Cp\u003EDie Jugendfeuerwehr K\u00f6ln ist der Zusammenschluss aller Jugendgruppen der Einheiten der FF. Jedes Kind und jeder Jugendliche im Alter von 10 bis 18 Jahren kann Mitglied einer Jugendgruppe werden. Insgesamt gibt es derzeit 24 Jugendgruppen, d.h. lediglich zwei Einheiten der FF haben keine Jugendgruppe. Jede Jugendgruppe wird von einem ernannten Jugendwart und mindestens einem Stellvertreter geleitet.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz","hasEmail":"feuerwehr@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Berufsfeuerwehr, Amt f\u00fcr Feuerschutz, Rettungsdienst und Bev\u00f6lkerungsschutz"},"distribution":[{"type":"dcat:Distribution","title":"Einheiten 2023","dctModified":"2024-11-21T10:38:23+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2024-11-21T10:38:23+00:00","downloadURL