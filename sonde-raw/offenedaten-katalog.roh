-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2019-03-08T10:47:57+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20181116_LSA_Ko%25CC%2588ln.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Verkehrsmanagement Stadt K\u00f6ln","hasEmail":"mailto:verkehrsmanagement@stadt-koeln.de"}],"dctIssued":"2024-05-16T09:29:35+00:00","dctModified":"2025-11-27T15:02:48+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}]},{"type":"dcat:Dataset","title":"Ampelanlagen K\u00f6ln 2016","identifier":"1505ac80-69b3-4000-8f0e-41a47f275d12","description":"\u003Cp\u003EAmpelanlagen (Lichtsignalanlagen) in K\u00f6ln\u00a0(Standort, LSA-Nummer, Baulasttr\u00e4ger und Stadtbezirk).\u003C\/p\u003E\u003Cp\u003EErg\u00e4nzende Hinweise: Es handelt sich um die Standorte von Lichtsignalanlagen. Die Verortung gibt den ma\u00dfgeblichen Kreuzungspunkt von Verkehrsstr\u00f6men, der durch ein Steuerger\u00e4t einer Lichtsignalanlage geregelten \u00d6rtlichkeit wieder. Der Reglungsumfang einer Anlage kann einen gr\u00f6\u00dferen Bereich mit einem Abstand von bis zu 75 m von diesem Punkt umfassen.\u003C\/p\u003E\u003Cp\u003EQuelle der Daten ist die Bestandserfassung f\u00fcr Lichtsignalanlagen beim Amt f\u00fcr Verkehrsmanagement. Die Daten werden jeweils zum Jahresbeginn aktualisiert.\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"Ampelanlagen K\u00f6ln"},"keyword":["Geo","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dcatAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/TEMPORARY"},"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265