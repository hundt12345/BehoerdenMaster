pe\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 06 \/ 2020\u003C\/p\u003E\u003Cp\u003EShape Datei\u003C\/p\u003E","dctIssued":"2020-06-10T13:28:50+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20200610_Baumbestan_Koeln.zip","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Bestand Einzelbaeume Koeln CSV","dctModified":"2025-04-22T09:12:48+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 06 \/ 2020\u003C\/p\u003E","dctIssued":"2020-06-15T09:38:55+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Baumbestand_Koeln.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln","hasEmail":"mailto:gruenflaechenamt@stadt-koeln.de"}],"dctIssued":"2024-06-05T09:48:40+00:00","dctModified":"2025-11-27T15:03:20+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Landschaftspflege und Gr\u00fcnfl\u00e4chen Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-landschaftspflege-und-gruenflaechen"}]},{"identifier":"1d47d13c-8b4f-4986-81ca-e99312ece3ed","title":"Berufliche Schulen: Schulabg\u00e4nger\/-innen nach Abschluss, Geschlecht, Nationalit\u00e4t und Bildungsbereich","description":"\u003Cp\u003EBerufliche Schulen: Schulabg\u00e4nger\/-innen nach Abschluss, Geschlecht, Nationalit\u00e4t und Bildungsbereich.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=21121-152is\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=2...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Statistik der beruflichen Schulen gibt Auskunft \u00fcber das\u003Cbr \/\u003E\nSchulwesen an den beruflichen Schulen in NRW in der\u003Cbr \/\u003E\nbundesweit einheitlichen und vergleichbaren Zuordnung.\u003Cbr \/\u003E\nNeben den Daten zu Schulen, Sch\u00fclerinnen und Sch\u00fclern,\u003Cbr \/\u003E\nLehrkr\u00e4ften sowie Unterricht, die j\u00e4hrlich zu\u003Cbr \/\u003E\nSchuljahresbeginn erhoben werden, werden auch Indikatoren\u003Cbr \/\u003E\nund deren Berechnungsweise dargestellt. Die\u003Cbr \/\u003E\nDatenbereitstellung erfolgt \u00fcber die Schulen in NRW.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nGemeinden.\u003C\/p\u003E\n\u003Cp\u003ENach dem Schulformkonzept: Alle Bildungsg\u00e4nge werden unter\u003Cbr \/\u003E\nder Leitschulform der Schule berichtet, auch wenn sie vom\u003Cbr \/\u003E\nBildungsgang der Leitschulform abweichen (z. B. bei\u003Cbr \/\u003E\nVerbundschulen oder bei Sekundarschulen mit auslaufenden\u003Cbr \/\u003E\nHaupt- und Realschulbildungsg\u00e4ngen).\u003C\/p\u003E\n\u003Cp\u003ENach dem Stammschulkonzept: An mehreren Schulen t\u00e4tige\u003Cbr \/\u003E\nLehrkr\u00e4fte werden nur an der Stammschule gez\u00e4hlt, auch wenn\u003Cbr \/\u003E\ndiese ganz an einer anderen Schule t\u00e4tig sind.\u003C\/p\u003E\n\u003Cp\u003EGeschlecht: Beinhaltet Sch\u00fcler\/-innen mit den Geschlechtern\u003Cbr \/\u003E\nweiblich, m\u00e4nnlich, divers und ohne Angabe (im\u003Cbr \/\u003E\nGeburtenregister). Unter weiblich werden die tats\u00e4chlich\u003Cbr \/\u003E\nweiblichen Sch\u00fclerinnen ausgewiesen.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Bildung und Wissenschaft"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.d