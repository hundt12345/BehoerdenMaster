distribution\/2023_LSA_Koeln.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Verkehrsmanagement Stadt K\u00f6ln","hasEmail":"mailto:verkehrsmanagement@stadt-koeln.de"}],"dctIssued":"2024-05-16T09:37:01+00:00","dctModified":"2025-11-27T15:02:09+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}]},{"type":"dcat:Dataset","title":"Ampelanlagen K\u00f6ln 2019","identifier":"d9c6d3c3-19a4-4058-8dd0-57d2ecadf77a","description":"\u003Cp\u003EAmpelanlagen (Lichtsignalanlagen) in K\u00f6ln\u00a0(Standort, LSA-Nummer, Baulasttr\u00e4ger und Stadtbezirk).\u003C\/p\u003E\u003Cp\u003EErg\u00e4nzende Hinweise: Es handelt sich um die Standorte von Lichtsignalanlagen. Die Verortung gibt den ma\u00dfgeblichen Kreuzungspunkt von Verkehrsstr\u00f6men, der durch ein Steuerger\u00e4t einer Lichtsignalanlage geregelten \u00d6rtlichkeit wieder. Der Reglungsumfang einer Anlage kann einen gr\u00f6\u00dferen Bereich mit einem Abstand von bis zu 75 m von diesem Punkt umfassen.\u003C\/p\u003E\u003Cp\u003EQuelle der Daten ist die Bestandserfassung f\u00fcr Lichtsignalanlagen beim Amt f\u00fcr Verkehrsmanagement. Die Daten werden jeweils zum Jahresbeginn aktualisiert.\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"Ampelanlagen K\u00f6ln"},"keyword":["Geo","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[6.8529397319055,51.082056200978],[6.8529419374532,51.082003950333],[6.8529772029547,51.081524176405],[6.8530115297498,51.081287860856],[6.8530505830735,51.08105235972],[6.8531615393036,51.080583362115],[6.8531710881043,51.080549233766],[6.853184190258,51.080503211772],[6.8531978409653,51.080456813124],[6.8535870147001,51.079439656843],[6.8541319916778,51.078463517117],[6.8