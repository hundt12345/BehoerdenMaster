22:07+00:00","dctModified":"2025-11-19T10:23:52+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Karten, Kataster und Vermessung - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/karten-kataster\/"}],"dctContributor":[{"foaf_name":"Karten, Kataster und Vermessung - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/karten-kataster\/"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-liegenschaften-vermessung-und-kataster"}]},{"type":"dcat:Dataset","title":"Radverkehrsnetz","identifier":"f6e804e5-5d7a-4406-80ae-e6978355052a","description":"\u003Cp\u003EDas Radverkehrsnetz bildet eine Grundlage f\u00fcr alle zuk\u00fcnftigen Planungen im Stra\u00dfenraum. Das Grundprinzip im gr\u00fcnen Netz ist Mischverkehr (Tempo 30, Verkehrsberuhigte Bereiche, Fahrradstra\u00dfen, Fu\u00dfg\u00e4ngerzonen\/Fahrrad frei, Schutzstreifen oder Radwege im Gr\u00fcnen). Das Grundprinzip im gelben Netz ist die getrennte F\u00fchrung vom Kfz-Verkehr entlang der Hauptverkehrsstra\u00dfen (Radfahrstreifen, Schutzstreifen oder bauliche Radwege).\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resour