zug\u003Cbr \/\u003E\noder jede Aufgabe einer alleinigen Wohnung oder Hauptwohnung\u003Cbr \/\u003E\noder die \u00c4nderung des Wohnungsstatus (Umwandlung einer\u003Cbr \/\u003E\nNebenwohnung in eine Hauptwohnung oder umgekehrt). Somit\u003Cbr \/\u003E\nwerden in der Wanderungsstatistik die Zu- und Fortz\u00fcge von\u003Cbr \/\u003E\ndeutschen und nicht-deutschen Personen - darunter auch die\u003Cbr \/\u003E\nAn- und Abmeldungen von Schutzsuchenden - erfasst.\u003Cbr \/\u003E\nUnber\u00fccksichtigt bleiben die Umz\u00fcge innerhalb der Gemeinden\u003Cbr \/\u003E\n(Ortsumz\u00fcge). Die Ergebnisse werden bis auf Gemeindeebene\u003Cbr \/\u003E\nzur Verf\u00fcgung gestellt.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Zu-\/Fortgezogene \u00fcber die Kreisgrenzen nach Altersgruppen XML","dctModified":"2025-11-10T11:25:39+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-27T11:59:10+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12711-13i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Zu-\/Fortgezogene \u00fcber die Kreisgrenzen nach Altersgruppen CSV","dctModified":"2025-11-10T11:25:04+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/