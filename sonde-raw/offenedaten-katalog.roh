en und rechtlich verbindlichen Druckexemplars des Haushaltsplans kommen.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Haushalt und Steuern"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Haushalt Koeln Finanzrechnung 2018 Entwurf","dctModified":"2022-07-26T09:43:37+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-10-16T10:01:57+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Koeln_HH_Finanzrechnung_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Haushalt Koeln Massnahmen ueber Wertgrenze 2018 Entwurf","dctModified":"2022-07-26T09:43:39+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2017-10-16T10:08:20+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Koeln_HH_Ma%25C3%259Fnah