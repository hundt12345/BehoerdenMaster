003ENaturdenkmale werden aufgrund ihrer Seltenheit, Eigenart oder Sch\u00f6nheit oder auch aus wissenschaftlichen, naturgeschichtlichen, landeskundlichen oder erdgeschichtlichen Gr\u00fcnden ausgewiesen und gesch\u00fctzt.\u003C\/p\u003E\u003Cp\u003ESie werden im sogenannten baulichen Au\u00dfenbereich durch den Landschaftsplan der Stadt K\u00f6ln (LP) und dar\u00fcber hinaus durch die Ordnungsbeh\u00f6rdliche Verordnung \u00fcber Naturdenkmale (NDI-VO) festgesetzt. Die hier angebotenen Karten enthalten die\u00a0\u003Cstrong\u003Egesch\u00fctzten B\u00e4ume beider Satzungen\u003C\/strong\u003E.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Naturdenkmaeler Koeln","dctModified":"2022-07-26T10:38:19+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2019-02-26T15:14:41+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/Freizeit_Natur_Sport\/Naturdenkmal\/MapServer\/0\/query?where=bez+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;queryByDistance=\u0026amp;returnExtentsOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;f=geojson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"WMS Naturdenkmaeler Koeln","dctModified":"2022-08-10T08:39:18+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/WMS_SRVC","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2022-08-10T08:39:18+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/services\/freizeit_natur_sport\/naturdenkmal\/MapServer\/WMSServer?request=GetCapabilities\u0026amp;service=WMS","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Geoportal Stadt K\u00f6ln","hasEmail":"mailto:e-government@stadt-koeln.de"}],"dctIssued":"2019-02-26T15:13:59+00:00","dctModified":"2025-11-27T15:03:46+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dctContributor":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Geoportal Stadt K\u00f6ln ","foaf_homepage":"https:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/geoportal\/index.html"}]},{"type":"dcat:Dataset","title":"Luftbilder K\u00f6ln 2018","identifier":"d1bb8478-5233-4339-831f-e2804444eb1e","description":"\u003Cp\u003ELuftbildaufnahmen des K\u00f6lner Stadtgebietes aus dem Jahr 2018.\u003C\/p\u003E\u003Cp\u003ELuftbilder k\u00f6nnen \u00fcber die unten verlinkten Ressourcen abgefragt werden. \u00dcber die Anpassung der Bounding Box (Parameter bbox in der URL) k\u00f6nnen die einzelnen Ausschnitte ge\u00e4ndert und \u0022herangezoomt\u0022 werden. Die Bildgr\u00f6\u00dfe kann \u00fcber den Parameter size ge\u00e4ndert werden (Default ist 400,400). Die ebenfalls enthaltenen und gekennzeichneten Beispieldateien veranschaulichen hierbei die Nutzung.\u003C\/p\u003E\u003Cp\u003EGenutzt wird EPSG: 4326\u00a0\/ WGS84\u003C\/p\u003E\u003Cp\u003E\u00a9 Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":