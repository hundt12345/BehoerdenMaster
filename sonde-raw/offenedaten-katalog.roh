eln.de\/dataset\/strassenabschnitte-koeln"}],"dcatLandingPage":[],"foafPage":[],"dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/CONT"},"provWasGeneratedBy":[],"provQualifiedAttribution":[],"dcatQualifiedRelation":[],"dctIsReferencedBy":[],"dctReferences":[],"dcathasVersion":[],"admsSample":[],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"@type":"dcat:Dataset","title":"Strassenabschnitte K\u00f6ln","identifier":"3ec661b4-d846-4708-a740-3b44037fcee0","description":"\u003Cp\u003EEin Stra\u00dfenabschnitt ist Teil der Kommunalen Gebietsgliederung. Dieses hierarchische System gliedert das K\u00f6lner Stadtgebiet auf verschiedenen Ebenen in eine Stadtstruktur und Blockstruktur. Weitere Bestandteile sind eine Stra\u00dfenstruktur und Adressen.\u00a0Die gesamte Kommunale Gebietsgliederung wird in dieser \u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003EVer\u00f6ffentlichung\u003C\/a\u003E erl\u00e4utert.\u003Cbr \/\u003EDefinition: Ein Stra\u00dfenabschnitt definiert ein Teilst\u00fcck einer Stra\u00dfe von einer Kreuzung oder Einm\u00fcndung zur n\u00e4chsten. Stra\u00dfenabschnitte beginnen und enden an Stra\u00dfenknoten und werden in der Regel fortlaufend in Zehnerschritten nummeriert. Die Nummerierung startet an dem Teil der Stra\u00dfe, an der die Hausnummerierung beginnt. Bei Stra\u00dfen die keine Hausnummern haben, verl\u00e4uft die Nummerierung in der Regel vom Stadtzentrum in Richtung Stadtgrenze.\u003Cbr \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003C\/p\u003E\u003Cp\u003EDas\u00a0\u003Ca href=\u0022https:\/\/offenedaten-koeln.de\/dataset\/koelner-strassenverzeichnis\u0022\u003E\u003Cstrong\u003EK\u00f6lner Stra\u00dfenverzeichnis\u003C\/strong\u003E\u003C\/a\u003E\u00a0gibt einen \u00dcberblick \u00fcber alle geltenden Stra\u00dfennamen und Adressen. Es wird etwa halbj\u00e4hrig und vor jeder Wahl aktualisiert.\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der\u00a0der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten\u00a0und\u00a0weitere Gebietsgliederungen\u00a0enth\u00e4lt der Datensatz\u00a0\u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-koeln\u0022\u003ERaumbezugssystem Geopackage\u003C\/a\u003E.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource"