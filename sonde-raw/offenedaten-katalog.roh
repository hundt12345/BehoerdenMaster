dctModified":"2022-07-26T10:07:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EFallzahlen zu den allgemeinen Verst\u00f6\u00dfen, illegalem Handel und Schmuggel nach dem Bet\u00e4ubungsmittelgesetz (BtMG) bei verschiedenen Rauschmitteln.\u003C\/p\u003E\n","dctIssued":"2015-05-29T06:49:19+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Rauschgiftdelikte_Fallzahlen_Koeln_2013_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Rauschgiftdelikte Aufklaerungsquote 2005 2014","dctModified":"2022-07-26T10:07:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2015-05-29T06:51:06+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Rauschgiftdelikte_Aufklaerungsquote_2005_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Internet als Tatmittel Koeln 2005 2014","dctModified":"2022-07-26T10:07:49+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EIn der Polizeilichen Kriminalstatistik wird seit 2004 die Nutzung des \u201eInternet\u201c als Tatmittel erfasst.\u003Cbr \/\u003E\nDies erfolgt in den folgenden Deliktsbereichen: Straftaten gegen die sexuelle Selbstbestimmung, Nachstellung (Stalking), N\u00f6tigung, Bedrohung, Verm\u00f6gens- und F\u00e4lschungsdelikte, der Sonstigen Straftatbest\u00e4nde und der Strafrechtlichen Nebengesetze.\u003Cbr \/\u003E\nDer hohe Wert bei den unten ausgewiesenen anderen Delikten in den Jahren 2012 und 2013 resultiert aus Erfassungen im Bereich \u201eSonstige Straftatbest\u00e4nde (StGB)\u201c.\u003C\/p\u003E\n","dctIssued":"2015-05-29T07:23:32+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Internet_als_Tatmittel_Koeln_2005_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Aufklaerungsquote Tatmittel Internet 2005 2014","dctModified":"2022-07-26T10:07:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2015-05-29T07:25:26+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Aufklaerungsquote_Tatmittel_Internet_2005_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Wirtschaftskriminalitaet Fallzahlen Koeln 2005 2014","dctModified":"2022-07-26T10:07:53+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EIn der Polizeilichen Kriminalstatistik werden bestimmte Delikte unter dem Begriff \u201eWirtschaftskriminalit\u00e4t*\u0022 zusammengefasst. Zu diesen Delikten geh\u00f6ren Straftaten aus dem Betrugsbereich, Insolvenzstraftaten, Wirtschaftskriminalit\u00e4t im Anlage- und Finanzierungsbereich, Wettbewerbsdelikte, Wirtschaftskriminalit\u00e4t im Zusammenhang mit Arbeitsverh\u00e4ltnissen und Straftaten im Zusammenhang mit Beteiligungen und Kapitalanlagen.\u003C\/p\u003E\n\u003Cp\u003EF\u00fcr das Jahr 2014 wurde mit der Sonderkennung Wirtschaftkriminalit\u00e4t eine Schadenssumme von gerundet 217.300.000 Euro ausgewiesen.\u003Cbr \/\u003E\nDies ist ein Anteil von 67,46 Prozent an der Gesamtschadenssumme.\u003C\/p\u003E\n","dctI