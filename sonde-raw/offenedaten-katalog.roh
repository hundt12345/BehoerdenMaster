t:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Stadtbibliothek K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/stadtbibliothek\/index.html"}],"dctContributor":[{"foaf_name":"Stadtbibliothek K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/stadtbibliothek\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Stadtbibliothek K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/stadtbibliothek\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Stadtbibliothek K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/stadtbibliothek\/index.html"}]},{"type":"dcat:Dataset","title":"Kundenzentren K\u00f6ln Wartezeiten","identifier":"b80fdf26-2941-48e1-abb5-c998ec8f9d3e","description":"\u003Cp\u003EAuflistung der K\u00f6lner Kundenzentren inklusive der Darstellung der aktuellen Wartezeit.\u003C\/p\u003E\u003Cp\u003EFelder:\u003C\/p\u003E\u003Cp\u003E[title_anz] =\u0026gt; Name des Kundenzentrums z.B. Kundenzentrum Innenstadt\u003C\/p\u003E\u003Cp\u003E[timestamp] =\u0026gt; Datum und Uhrzeit der letzten Aktualisierung z.B. 2014-12-08 10:10:01\u003C\/p\u003E\u003Cp\u003E[link] =\u0026gt; Link zur Internetseite des Kundenzentrums z.B. \u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/service\/adressen\/00183\/index.html\u0022\u003Ehttp:\/\/www.stadt-koeln.de\/service\/adressen\/00183\/index.html\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E[status] =\u0026gt; 1 = offen | 2 = geschlossen | 3 = Sondertext vorhanden\u003C\/p\u003E\u003Cp\u003E[sondertext] =\u0026gt; Optional zus\u00e4tzlicher Erl\u00e4uterungstext zum aktuellen [status]\u003C\/p\u003E\u003Cp\u003E[wartezeit_minuten] =\u0026gt; Wartezeit in Minuten z.B. 12\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EInformation\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EWird status = 2 (geschlossen) angezeigt\u00a0und gleichzeitig die wartezeit_in_minuten (z.B. 12), so handelt es sich um den letzten Stand\u00a0der Wartezeit vor Schlie\u00dfung des Kundenzentrums.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Infrastruktur"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Wartezeiten Kundenzentren Koeln","dctModified":"2022-07-26T09:50:35+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2014-12-08T09:15:28+00:00","downloadURL":"http:\/\/www.stadt-koeln.de\/externe-dienste\/open-data\/waiting-od.php","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Presse- und \u00d6ffentlichkeitsarbeit","hasEmail":"mailto:presseamt@stadt-koeln.de"}],"dctIssued":"2014-12-10T09:14:40+00:00","dctModified":"2025-11-27T15:03:59+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Presse- und \u00d6ffentlichkeitsarbeit","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-presse-und-oeffentlichkeitsarbeit"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Presse- und \u00d6ffentlichkeitsarbeit","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-presse-und-oeffentlichkeitsarbeit"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Presse- und \u00d6ffentlichkeitsarbeit","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-presse-und-oeffentlichkeitsarbeit"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Presse- und \u00d6ffentlichkeitsarbeit","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-presse-und-oeffentlichkeitsarbeit"}]},{"type":"dcat:Dataset","title":"Park and Ride Anlagen in K\u00f6ln","identifier":"3575586d-9901-48c3-9870-f74b41e4724d","description":"\u003Cp\u003EP+R\u00a0Pl\u00e4tze sind eine gute Alternative, um staufrei und entspannt in die Innenstadt zu gelangen. Stellen Sie Ihr Fahrzeug schon am Stadtrand ab. Hier finden Sie eine Auflistung der Anlagen.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EFelder:\u003C\/strong\u003E\u003C\/p\u003E\u003Cul\u003E\u003Cli\u003EFID\u00a0\u003Cem\u003E(Type: esriFieldTypeOID, Alias: FID)\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003ESHAPE\u00a0\u003Cem\u003E(Type: esriFieldTypeGeometry, Alias: SHAPE)\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EName\u00a0\u003Cem\u003E(Type: esriFieldTypeString, Alias: Name, Length: 150 )\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EStrasse\u00a0\u003Cem\u003E(Type: esriFieldTypeString, Alias: Strasse, Length: 150 )\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EPLZ\u00a0\u003Cem\u003E(Type: esriFieldTypeInteger, Alias: PLZ)\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EStadt\u00a0\u003Cem\u003E(Type: esriFieldTypeString, Alias: Stadt, Length: 100 )\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EStellplaetze\u00a0\u003Cem\u003E(Type: esriFieldTypeInteger, Alias: Stellplaetze)\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EHyperlink\u00a0\u003Cem\u003E(Type: esriFieldTypeString, Alias: Hyperlink, Length: 200 )\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EPOINT_Y\u00a0\u003Cem\u003E(Type: esriFieldTypeDouble, Alias: POINT_Y)\u003C\/em\u003E\u003C\/li\u003E\u003Cli\u003EPOINT_X\u00a0\u003Cem\u003E(Type: esriFieldTypeDouble, Alias: POINT_X)\u003C\/em\u003E\u003C\/li\u003E\u003C\/ul\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EInformation:\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003ENeben den oben angegebenen X,Y Koordinaten mit dem Bezugssystem WGS_1984_UTM_Zone_32N, gibt es ein weiteres Feld \u0022geometry\u0022, welches die X\/Y Koordinaten im Bezugssystem WGS84 (EPSG:4326) ausgibt.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Park + Ride Anlagen in Koeln","dctModified":"2022-07-26T11:25:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2014-11-21T11:53:53+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/verkehr\/verkehrskalender\/MapServer\/8\/query?where=objectid+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryT