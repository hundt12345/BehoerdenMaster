lheim passiert. Die Karte wird immer weiter bef\u00fcllt. Auch den Stand der Umsetzung k\u00f6nnt ihr hier verfolgen.\u00a0\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/15\u0022\u003EHey M\u00fclheim |\u00a0100-Tage-Challenge | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Hey M\u00fclheim | 100-Tage-Challenge","dctModified":"2024-06-13T09:06:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T09:06:45+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/15\/export\/posts\/export_dialog_posts_15_hey_mulheim_100-tage-challenge.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T09:05:40+00:00","dctModified":"2025-11-27T14:54:40+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMainta