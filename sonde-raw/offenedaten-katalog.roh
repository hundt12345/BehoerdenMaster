s@stadt-koeln.de"}],"dctIssued":"2024-04-01T08:10:59+00:00","dctRelation":[{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/strassen-k%C3%B6ln"},{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/strassenabschnitte-k%C3%B6ln"}],"dctLanguage":[{"type":"dcterms:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctAccessRights":{"dct_RightsStatement":"http:\/\/publications.europa.eu\/resource\/authority\/access-right\/PUBLIC"},"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezugssystem Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL_2"},"dctCreator":[{"foaf_name":"Stadt K\u00f6ln - Amt f\u00fcr Stadtentwicklung und Statistik (Raumbezogene Statistik)","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Stadt K\u00f6ln - Amt f\u00fcr Stadtentwicklung und Statistik (Raumbezogene Statistik)","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}]},{"type":"dcat:Dataset","title":"K\u00f6lner Strassenverzeichnis Stand 4. Quartal 2023","identifier":"7307a13b-bdb5-49e8-a116-95fd554c36d2","description":"\u003Cp\u003EDie Stadt K\u00f6ln gibt auf Beschluss der Bezirksvertretungen allen Stra\u00dfen, Wegen und Pl\u00e4tzen einen amtlichen Stra\u00dfennamen. F\u00fcr diesen wird vom Amt f\u00fcr Stadtentwicklung und Statistik ein eindeutiger Stra\u00dfenschl\u00fcssel vergeben.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EEntsprechend der gesetzlichen Grundlage, wird seit dem 1.9.2022 bei einer amtlichen Stra\u00dfenumbenennung ein neuer Stra\u00dfenschl\u00fcssel vergeben. Ab den Stra\u00dfenverzeichnissen Stand 15.10.2023 werden alle hiervon betroffenen F\u00e4lle im Tabellenblatt \u0022Stra\u00dfenumbenennungen\u0022 aufgelistet. Der WFS Stra\u00dfenumbenennung zeigt alle durch eine Umbenennung g\u00fcltigen Stra\u00dfen und Adressen, sobald die Bezeichnung rechtkr\u00e4ftig ist. Weiterhin werden f\u00fcr die ung\u00fcltigen Stra\u00dfen und Adressen Tabellen zur Umschl\u00fcsselung bereitgestellt.\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDas K\u00f6lner Stra\u00dfenverzeichnis gibt einen \u00dcberblick \u00fcber alle geltenden Stra\u00dfennamen und -schl\u00fcssel. Durch verschiedene Phasen der Eingemeindung, wie die Kommunale Gebietsreform im Jahre 1975, erweiterte sich der K\u00f6lner Stra\u00dfenbestand um Stra\u00dfen, deren Namen im Stadtgebiet bereits vorhanden waren. Von einer Umbenennung wurde abgesehen, um der betroffenen Bev\u00f6lkerung die dadurch anfallenden Kosten zu ersparen. Doppelte Stra\u00dfennamen k\u00f6nnen anhand des eindeutigen Stra\u00dfenschl\u00fcssels unterschieden werden. Im Stra\u00dfenverzeichnis ist den eingemeindeten Stra\u00dfen der Stadtbezirk in Klammern angeh\u00e4ngt.\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Standard)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E und \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden ohne Hausnummernbereich angegeben. Das Stra\u00dfenverzeichnis wird etwa halbj\u00e4hrig aktualisiert (In der Regel zum Stichtag 1. April und 1. Oktober).\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Quartier)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E, \u003Cstrong\u003EStatistischem Quartier\u003C\/strong\u003E und \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden nicht angegeben. Das Stra\u00dfenverzeichnis wird etwa halbj\u00e4hrig aktualisiert.\u003C\/p\u003E\u003Cp\u003EDas \u003Cstrong\u003EStra\u00dfenverzeichnis (Wahlen)\u003C\/strong\u003E gibt die geraden und ungeraden Hausnummernbereiche einer Stra\u00dfe an, gegliedert nach \u003Cstrong\u003EStadtteil\u003C\/strong\u003E, \u003Cstrong\u003EPostleitzahl\u003C\/strong\u003E, \u003Cstrong\u003EStimmbezirk\u003C\/strong\u003E, \u003Cstrong\u003EKommunalwahlbezirk\u003C\/strong\u003E, \u003Cstrong\u003ELandtagswahlkreis\u003C\/strong\u003E, \u003Cstrong\u003EBundestagswahlkreis\u003C\/strong\u003E. Stra\u00dfen, an denen keine Adressen existieren werden nicht angegeben. Das Stra\u00dfenverzeichnis wird vor jeder Wahl aktualisiert.\u003C\/p\u003E\u003Cp\u003E\u00dcber das Portal Offene Daten K\u00f6ln werden alle dem Stra\u00dfenverzeichnis zugrunde liegenden Geodaten der Kommunalen Gebietsgliederung ver\u00f6ffentlicht, z. B. \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/strassen-k%C3%B6ln\u0022\u003E\u003Cstrong\u003EStrassen K\u00f6ln\u003C\/strong\u003E\u003C\/a\u003E. Die gesamte Kommunale Gebietsgliederung wird in dieser\u00a0\u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdfhttps:\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003E\u003Cstrong\u003EVer\u00f6ffentlichung\u00a0\u003C\/strong\u003E\u003C\/a\u003Eerl\u00e4utert.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"K\u00f6lner Strassenverzeichnis"},"keyword":["Geo","Infrastruktur"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dcatAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[6.8529397319055,51.082056200978],[6.8529419374532,51.082003950333],[6.8529772029547,51.081524176405],[6.8530115297498,51.081287860856],[6.8530505830735,51.08105235972],[6.8531615393036,51.080583362115],[6.8531710881043,51.080549233766],[6.853184190258,51.080503211772],[6.8531978409653,51.080456813124],[6.8535870147001,51.079439656843],[6.8541319916778,51.078463517117],[6.854737665366,51.077651616964],[6.8548329625448,51.077528258632],[6.8548868700139,51.07746070003],[6.8550266560839,51.077304602722],[6.8551769294369,51.0771381877],[6.8553144065849,51.076996408818],[6.8554638331548,51.076844307558],[6.8555062365002,51.076801250444],[6.8556190969