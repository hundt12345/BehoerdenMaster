\/ Einwohner\u003C\/p\u003E\n","dctIssued":"2015-05-29T06:01:00+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Haeufigkeitszahlen_Gesamtkriminalitaet_Stadtgebiet_Koeln_2013_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Straftaten Fallzahlen Stadtgebiet Koeln 2005 2014","dctModified":"2022-07-26T10:06:44+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EMit 157.113 erfassten Straftaten f\u00fcr das Jahr 2014 wurde der h\u00f6chste Wert in der unten dargestellten Zeitreihe f\u00fcr das Stadtgebiet K\u00f6ln erreicht.\u003Cbr \/\u003E\nDer Mittelwert der letzen zehn Jahre liegt bei 143.498 Delikten.\u003C\/p\u003E\n","dctIssued":"2015-05-29T06:04:35+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Straftaten_Fallzahlen_Stadtgebiet_Koeln_2005_2014.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"ty