GeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2050 nach Altersjahren und Geschlecht XML","dctModified":"2025-11-17T08:42:32+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T12:00:03+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-03i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2050 nach Altersjahren und Geschlecht CSV","dctModified":"2025-11-17T08:42:00+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T12:00:50+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-03i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerungsvorausberechnung 2021 - 2050 nach Altersjahren und Geschlecht XLSX","dctModified":"2025-11-17T08:42:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T12:01:59+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12421-03i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12421-03d"],"adms:Identifier":[{"title":"12421-03d"}],"dctIssued":"2024-05-14T13:59:03+02:00","dctModified":"2025-11-27T15:50:46+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"6a0b06a0-78a1-4798-b2ed-6e075f091740","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 18 Jahre) nach Geschlecht und mit Angaben zu K\u00f6rpergewicht und K\u00f6rpergr\u00f6\u00dfe","description":"\u003Cp\u003EZusatzprogramm des Mikrozensus: Bev\u00f6lkerung am Ort der\u003Cbr \/\u003E\nHauptwohnung (ab 18 Jahre) nach Geschlecht und mit Angaben\u003Cbr \/\u003E\nzu K\u00f6rpergewicht und K\u00f6rpergr\u00f6\u00dfe 2005 - 2017.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12212-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12212-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErgebnisse des Mikrozensus:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EBis 2011 basiert die Hochrechnung auf den fortgeschriebenen Ergebnissen der Volksz\u00e4hlung 1987. Ab 2011 basiert die Hochrechnung auf den fortgeschriebenen Ergebnissen des Zensus 2011. Ab 2016 ist die Vergleichbarkeit der Mikrozensusergebnisse mit den Vorjahren durch die Umstellung auf eine neue Stichprobengrundlage eingeschr\u00e4nkt. Ab 2017 ohne Personen in Gemeinschaftsunterk\u00fcnften. F\u00fcr diese Personengruppe werden im Rahmen des Mikrozensus ab dem Erhebungsjahr 2017 nur noch einige wenige soziodemografische Grunddaten erhoben.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 18 Jahre) nach Geschlecht und mit Angaben zu K\u00f6rpergewicht und K\u00f6rpergr\u00f6\u00dfe XML","dctModified":"2025-11-05T14:46:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T11:11:05+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 18 Jahre) nach Geschlecht und mit Angaben zu K\u00f6rpergewicht und K\u00f6rpergr\u00f6\u00dfe CSV","dctModified":"2025-11-05T14:45:43+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T11:11:40+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 18 Jahre) nach Geschlecht und mit Angaben zu K\u00f6rpergewicht und K\u00f6rpergr\u00f6\u00dfe XLSX","dctModified":"2025-11-05T14:46:03+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T11:12:14+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12212-02iz"],"adms:Identifier":[{"title":"12212-02iz"}],"dctIssued":"2024-05-14T13:09:29+02:00","dctModified":"2025-11-27T15:51:10+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"674c10ca-778a-479f-ad0e-e729d6414a58","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 15 Jahre) nach Geschlecht und mit Angaben zu Rauchgewohnheiten","description":"\u003Cp\u003EZusatzprogramm des Mikrozensus: Bev\u00f6lkerung am Ort der Hauptwohnung (ab 15 Jahre) nach Geschlecht und mit Angaben zu Rauchgewohnheiten von 2005 - 2017.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12212-01d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12212-01d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErgebnisse des Mikrozensus:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EBis 2011 basiert die Hochrechnung auf den fortgeschriebenen Ergebnissen der Volksz\u00e4hlung 1987. Ab 2011 basiert die Hochrechnung auf den fortgeschriebenen Ergebnissen des Zensus 2011. Ab 2016 ist die Vergleichbarkeit der Mikrozensusergebnisse mit den Vorjahren durch die Umstellung auf eine neue Stichprobengrundlage eingeschr\u00e4nkt. Ab 2017 ohne Personen in Gemeinschaftsunterk\u00fcnften. F\u00fcr diese Personengruppe werden im Rahmen des Mikrozensus ab dem Erhebungsjahr 2017 nur noch einige wenige soziodemografische Grunddaten erhoben.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 15 Jahre) nach Geschlecht und mit Angaben zu Rauchgewohnheiten XML","dctModified":"2025-11-04T13:18:31+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T10:20:17+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 15 Jahre) nach Geschlecht und mit Angaben zu Rauchgewohnheiten CSV","dctModified":"2025-11-04T13:26:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T10:20:53+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung am Ort der Hauptwohnung (ab 15 Jahre) nach Geschlecht und mit Angaben zu Rauchgewohnheiten XLSX","dctModified":"2025-11-04T13:26:45+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T10:21:36+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12212-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12212-01d"],"adms:Identifier":[{"title":"12212-01d"}],"dctIssued":"2024-05-14T12:19:13+02:00","dctModified":"2025-11-27T15:51:13+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"fab26083-b479-4f12-883b-4137e27fa36c","title":"Bev\u00f6lkerung nach Erwerbsstatus, Nationalit\u00e4t und Geschlecht","description":"\u003Cp\u003EBev\u00f6lkerung nach Erwerbsstatus, Nationalit\u00e4t und Geschlecht von 1997 - 2019.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12211-124i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp class=\u0022langtext\u0022\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErgebnisse des Mikrozensus\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erstellung von Ergebnissen f\u00fcr kreisfreie St\u00e4dte und\u003Cbr \/\u003E\nKreise erfolgt auf Basis einer gesonderten Hochrechnung.\u003Cbr \/\u003E\nBei Aufsummierungen k\u00f6nnen die Ergebnisse aufgrund von\u003Cbr \/\u003E\nRundungen \u0022in 1000\u0022 von den in der Tabelle einzeln\u003Cbr \/\u003E\ndargestellten Summenwerten abweichen. Die mit der\u003Cbr \/\u003E\ngesonderten Hochrechnung dargestellten Ergebnisse k\u00f6nnen\u003Cbr \/\u003E\nvon denen mit dem Standardhochrechnungsfaktor berechneten\u003Cbr \/\u003E\nErgebnissen abweichen.\u003C\/p\u003E\n\u003Cp\u003EAb 2017 ohne Personen in Gemeinschaftsunterk\u00fcnften; da ab\u003Cbr \/\u003E\n2017 f\u00fcr diese Personengruppe nur noch einige wenige\u003Cbr \/\u003E\nsoziodemografische Grunddaten erhoben werden.\u003C\/p\u003E\n\u003Cp\u003EErwerbst\u00e4tige nach dem Labour Force Konzept der ILO\u003Cbr \/\u003E\n(Internationale Arbeitsorganisation) am Ort der Hauptwohnung\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach Erwerbsstatus, Nationalit\u00e4t und Geschlecht XML","dctModified":"2024-07-31T11:16:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T09:44:53+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-124i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach Erwerbsstatus, Nationalit\u00e4t und Geschlecht CSV","dctModified":"2024-07-31T11:16:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T09:46:03+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-124i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach Erwerbsstatus, Nationalit\u00e4t und Geschlecht XLSX","dctModified":"2024-07-31T11:16:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T09:47:18+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-124i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12211-124i"],"adms:Identifier":[{"title":"12211-124i"}],"dctIssued":"2024-05-14T11:43:49+02:00","dctModified":"2025-11-27T15:51:53+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"e3e80429-16c6-415a-b223-26c4c5872278","title":"Bev\u00f6lkerung nach pers\u00f6nlichem Nettoeinkommen und Geschlecht","description":"\u003Cp\u003EBev\u00f6lkerung nach pers\u00f6nlichem Nettoeinkommen und Geschlecht\u00a0von 2005 - 2009.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12211-114i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErgebnisse des Mikrozensus\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erstellung von Ergebnissen f\u00fcr kreisfreie St\u00e4dte und\u003Cbr \/\u003E\nKreise erfolgt auf Basis einer gesonderten Hochrechnung.\u003Cbr \/\u003E\nBei Aufsummierungen k\u00f6nnen die Ergebnisse aufgrund von\u003Cbr \/\u003E\nRundungen \u0022in 1000\u0022 von den in der Tabelle einzeln\u003Cbr \/\u003E\ndargestellten Summenwerten abweichen. Die mit der\u003Cbr \/\u003E\ngesonderten Hochrechnung dargestellten Ergebnisse k\u00f6nnen\u003Cbr \/\u003E\nvon denen mit dem Standardhochrechnungsfaktor berechneten\u003Cbr \/\u003E\nErgebnissen abweichen.\u003C\/p\u003E\n\u003Cp\u003EAb 2017 ohne Personen in Gemeinschaftsunterk\u00fcnften; da ab\u003Cbr \/\u003E\n2017 f\u00fcr diese Personengruppe nur noch einige wenige\u003Cbr \/\u003E\nsoziodemografische Grunddaten erhoben werden.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach pers\u00f6nlichem Nettoeinkommen und Geschlecht XML","dctModified":"2024-07-31T11:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T09:29:11+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-114i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach pers\u00f6nlichem Nettoeinkommen und Geschlecht CSV","dctModified":"2024-07-31T11:16:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T09:29:46+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-114i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach pers\u00f6nlichem Nettoeinkommen und Geschlecht XLSX","dctModified":"2024-07-31T11:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T09:30:30+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-114i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12211-114i"],"adms:Identifier":[{"title":"12211-114i"}],"dctIssued":"2024-05-14T11:27:41+02:00","dctModified":"2025-11-27T15:51:51+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"39c53a0d-f0d7-48a1-9f4d-d7abbc90dd15","title":"Bev\u00f6lkerung nach h\u00f6chstem beruflichem Ausbildungsabschluss und Geschlecht","description":"\u003Cp\u003EBev\u00f6lkerung nach h\u00f6chstem\u003Cbr \/\u003E\nberuflichem Ausbildungsabschluss und Geschlecht von 2005 - 2009.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Cstrong\u003E\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12211-112i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp class=\u0022langtext\u0022\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErgebnisse des Mikrozensus\u003C\/strong\u003E\u003Cbr \/\u003E\nDie Erstellung von Ergebnissen f\u00fcr kreisfreie St\u00e4dte und\u003Cbr \/\u003E\nKreise erfolgt auf Basis einer gesonderten Hochrechnung.\u003Cbr \/\u003E\nBei Aufsummierungen k\u00f6nnen die Ergebnisse aufgrund von\u003Cbr \/\u003E\nRundungen \u0022in 1000\u0022 von den in der Tabelle einzeln\u003Cbr \/\u003E\ndargestellten Summenwerten abweichen. Die mit der\u003Cbr \/\u003E\ngesonderten Hochrechnung dargestellten Ergebnisse k\u00f6nnen\u003Cbr \/\u003E\nvon denen mit dem Standardhochrechnungsfaktor berechneten\u003Cbr \/\u003E\nErgebnissen abweichen.\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Lehre\/Berufsausbildung im dualen System\u0022:\u003Cbr \/\u003E\neinschlie\u00dflich Anlernausbildung und berufliches Praktikum\u003Cbr \/\u003E\nbis einschl. Geburtsjahr 1953, Vorbereitungsdienst f\u00fcr den\u003Cbr \/\u003E\nmittleren Dienst, einj\u00e4hrige Schule des Gesundheitswesens\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Fachschulabschluss \/ -abschluss in der ehem. DDR\u0022:\u003Cbr \/\u003E\neinschlie\u00dflich einer Meister-\/Technikerausbildung,\u003Cbr \/\u003E\nFachschule der DDR sowie Abschluss der 2-3 j\u00e4hrigen Schule\u003Cbr \/\u003E\ndes Gesundheitswesens\u003Cbr \/\u003E\nab 2011: einschl. Berufsakademie, Duale Hochschule\u003Cbr \/\u003E\n(Bachelor, Master oder Diplom)\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Fachhochschul- \/ Hochschulabschluss \/ Promotion\u0022:\u003Cbr \/\u003E\n2011-2015: einschl. Verwaltungsfachhochschule (Bachelor,\u003Cbr \/\u003E\nMaster oder Diplom)\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Akademischer Abschluss\u0022:\u003Cbr \/\u003E\nab 2016 werden die Abschl\u00fcsse Bachelor, Master, Diplom und\u003Cbr \/\u003E\nPromotion in der Kategorie Akademische Abschl\u00fcsse\u003Cbr \/\u003E\ndargestellt, unabh\u00e4ngig davon wo diese erworben wurden.\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Ohne beruflichen Bildungsabschluss\u0022:\u003Cbr \/\u003E\neinschlie\u00dflich Anlernausbildung und berufliches Praktikum ab\u003Cbr \/\u003E\nGeburtsjahr 1954, Berufsvorbereitungsjahr, Personen in\u003Cbr \/\u003E\nAusbildung bzw. Studium\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Ohne Angabe zum Abschluss\u0022:\u003Cbr \/\u003E\nwurde f\u00fcr die Jahre 2005 und 2006 nicht separat erfasst\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Bildung und Wissenschaft"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem beruflichem Ausbildungsabschluss und Geschlecht XML","dctModified":"2025-11-17T11:49:43+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T09:11:56+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-112i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem beruflichem Ausbildungsabschluss und Geschlecht CSV","dctModified":"2025-11-17T11:49:43+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T09:12:42+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-112i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem beruflichem Ausbildungsabschluss und Geschlecht XLSX","dctModified":"2025-11-17T11:49:43+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T09:13:42+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-112i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12211-112i"],"adms:Identifier":[{"title":"12211-112i"}],"dctIssued":"2024-05-14T11:10:53+02:00","dctModified":"2025-11-27T15:51:36+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"d8d6aca7-0568-4e11-b2da-819e319020ba","title":"Bev\u00f6lkerung nach h\u00f6chstem allgemeinbildendem Schulabschluss und Geschlecht","description":"\u003Cp\u003EBev\u00f6lkerung nach h\u00f6chstem allgemeinbildendem Schulabschluss und Geschlecht von 2005 - 2009\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=12211-110i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp class=\u0022langtext\u0022\u003EDer Mikrozensus gibt Aufschluss \u00fcber die\u003Cbr \/\u003E\nBev\u00f6lkerungsstruktur sowie die wirtschaftliche und soziale\u003Cbr \/\u003E\nLage der Bev\u00f6lkerung. Er liefert j\u00e4hrlich umfangreiche\u003Cbr \/\u003E\nInformationen zu den Themenbereichen Familie und\u003Cbr \/\u003E\nLebenspartnerschaft, Arbeitsmarkt und Erwerbst\u00e4tigkeit sowie\u003Cbr \/\u003E\nBeruf und Ausbildung. Die Datenbereitstellung erfolgt durch\u003Cbr \/\u003E\nBefragung von j\u00e4hrlich ca. einem Prozent der Bev\u00f6lkerung.\u003Cbr \/\u003E\nR\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003E\nKreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n\u003Cp\u003E\n\u003Cstrong\u003EErgebnisse des Mikrozensus\u003C\/strong\u003E\u003Cbr \/\u003E\nDie Erstellung von Ergebnissen f\u00fcr kreisfreie St\u00e4dte und\u003Cbr \/\u003E\nKreise erfolgt auf Basis einer gesonderten Hochrechnung.\u003Cbr \/\u003E\nBei Aufsummierungen k\u00f6nnen die Ergebnisse aufgrund von\u003Cbr \/\u003E\nRundungen \u0022in 1000\u0022 von den in der Tabelle einzeln\u003Cbr \/\u003E\ndargestellten Summenwerten abweichen. Die mit der\u003Cbr \/\u003E\ngesonderten Hochrechnung dargestellten Ergebnisse k\u00f6nnen\u003Cbr \/\u003E\nvon denen mit dem Standardhochrechnungsfaktor berechneten\u003Cbr \/\u003E\nErgebnissen abweichen.\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Haupt-(Volks-)schulabschluss\u0022:\u003Cbr \/\u003E\nab 2010: einschlie\u00dflich Polytechnische Oberschule der ehem.\u003Cbr \/\u003E\nDDR mit Abschluss der 8. oder 9. Klasse\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Realschul- oder gleichwertiger Abschluss\u0022:\u003Cbr \/\u003E\nbis 2009: einschlie\u00dflich Polytechnische Oberschule der ehem.\u003Cbr \/\u003E\nDDR\u003Cbr \/\u003E\nab 2010: einschlie\u00dflich Polytechnische Oberschule der ehem.\u003Cbr \/\u003E\nDDR mit Abschluss der 10. Klasse\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Ohne allgemeinen Schulabschluss\u0022:\u003Cbr \/\u003E\nab 2008: einschlie\u00dflich Abschluss nach h\u00f6chstens 7 Jahren\u003Cbr \/\u003E\nSchulbesuch\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Noch in schulischer Ausbildung\u0022:\u003Cbr \/\u003E\nSchulbesuch in den letzten 4 Wochen\u003C\/p\u003E\n\u003Cp\u003Ezu \u0022Ohne Angabe zum Abschluss\u0022:\u003Cbr \/\u003E\nwurde f\u00fcr die Jahre 2005 und 2006 nicht separat erfasst\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Bildung und Wissenschaft"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem allgemeinbildendem Schulabschluss und Geschlecht XML","dctModified":"2024-07-31T11:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-14T08:37:32+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-110i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem allgemeinbildendem Schulabschluss und Geschlecht CSV","dctModified":"2024-07-31T11:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-14T08:38:50+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-110i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bev\u00f6lkerung nach h\u00f6chstem allgemeinbildendem Schulabschluss und Geschlecht XLSX","dctModified":"2024-07-31T11:16:16+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-14T08:39:48+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-110i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12211-110i"],"adms:Identifier":[{"title":"12211-110i"}],"dctIssued":"2024-05-14T10:35:07+02:00","dctModified":"2025-11-27T15:50:14+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"type":"dcat:Dataset","title":"Parkscheinautomaten in Koeln","identifier":"f6ab30fd-09fd-4185-8ac4-6f7a32223c27","description":"\u003Cp\u003EAuflistung der K\u00f6lner Parkscheinautomaten, unter anderem mit Informationen zu Geb\u00fchren und H\u00f6chstparkdauer.\u00a0\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Infrastruktur","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Parkscheinautomaten in Koeln","dctModified":"2024-05-10T09:29:06+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand: 23.06.2016\u003C\/p\u003E","dctIssued":"2016-06-30T13:38:08+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/psa_2016.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Verkehrsmanagement Stadt K\u00f6ln","hasEmail":"mailto:verkehrsmanagement@stadt-koeln.de"}],"dctIssued":"2024-05-10T09:18:37+00:00","dctModified":"2025-11-27T15:02:09+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement  Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}]},{"identifier":"d20431db-d891-4fa4-98a7-913c95f25377","title":"Kunstrasenpl\u00e4tze K\u00f6ln Sportentwicklungsplan","description":"\u003Cp\u003EDurch die Sanierung und den Neubau von Freisportanlagen, stehen K\u00f6lns Fu\u00dfballer*innen nach und nach immer mehr Kunstrasenpl\u00e4tze zur Verf\u00fcgung. Die Vorteile vor allem gegen\u00fcber den alten Aschepl\u00e4tzen liegen auf der Hand:\u003C\/p\u003E\n\u003Cp\u003Ewitterungsunabh\u00e4ngige Bespielbarkeit des Kunstrasenbelages\u003Cbr \/\u003E\nweniger Verletzungen als auf Aschebelag; bessere Kraftabbauwerte\u003Cbr \/\u003E\nweniger Unterhaltungs- und Pflegeaufwand, so entf\u00e4llt das \u0022Linieren\u0022 vor Spielen zum Beispiel komplett, da die Spielfeldlinien in den Belag dauerhaft eingearbeitet sind\u003Cbr \/\u003E\nkeine Staubimmissionen bei trockenem Wetter\u003Cbr \/\u003E\nkeine durch den Sportbelag verschmutzten Schuhe und Bekleidung\u003Cbr \/\u003E\n\u00a0\u003Cbr \/\u003E\nWird ein alter Ascheplatz in einen modernen Kunstrasenplatz umgebaut, dann wird in der Regel die gesamte Sportanlage nachhaltig saniert. Einfriedung, Ballfangz\u00e4une, Barrieren, Trainingsbeleuchtungsanlage, Spielfeld- und Wegebel\u00e4ge, Be- und Entw\u00e4sserung und die Ausstattung werden nach heutigem Stand der Technik erneuert oder instandgesetzt.\u003C\/p\u003E\n\u003Cp\u003EDie Sportanlage kann somit wieder langfristig dem Sport zur Verf\u00fcgung stehen.\u00a0\u003C\/p\u003E\n\u003Cp\u003ENoch sind in K\u00f6ln viele Sportanlagen sanierungsbed\u00fcrftig und der Bedarf an Kunstrasenpl\u00e4tzen lange nicht gedeckt. Die Entscheidung, welche Pl\u00e4tze als n\u00e4chste umgebaut werden, h\u00e4ngt von verschiedenen Faktoren ab. Ma\u00dfgeblich ist dabei vor allem der derzeitigen Platzzustand, die Nutzungsintensit\u00e4t (Anzahl der Mannschaften) und nicht zuletzt auch die Lage der Sportanlage im Stadtgebiet.\u003C\/p\u003E\n\u003Cp\u003EDieser Datensatz enth\u00e4lt die Sportpl\u00e4tze gem\u00e4\u00df Sportentwicklungsplan Stand 09\/2020\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"contactPoint":[{"fn":"Sportamt Stadt K\u00f6ln","hasEmail":"sportamt@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Kunstrasenplaetze Koeln Sportentwicklungsplan","dctModified":"2025-11-18T08:12:20+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 09 \/ 2020\u003C\/p\u003E\n","dctIssued":"2020-09-28T07:55:49+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20200922_Kunstrasen_Sportentwicklungsplanung.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-05-10T10:53:59+02:00","dctModified":"2025-11-27T16:02:48+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dctContributor":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}]},{"identifier":"43c55aef-fbef-4ed1-8fc8-fba9ea915462","title":"Kunstrasenpl\u00e4tze K\u00f6ln Prioritaetenliste ","description":"\u003Cp\u003EDurch die Sanierung und den Neubau von Freisportanlagen, stehen K\u00f6lns Fu\u00dfballer*innen nach und nach immer mehr Kunstrasenpl\u00e4tze zur Verf\u00fcgung. Die Vorteile vor allem gegen\u00fcber den alten Aschepl\u00e4tzen liegen auf der Hand:\u003C\/p\u003E\n\u003Cp\u003Ewitterungsunabh\u00e4ngige Bespielbarkeit des Kunstrasenbelages\u003Cbr \/\u003E\nweniger Verletzungen als auf Aschebelag; bessere Kraftabbauwerte\u003Cbr \/\u003E\nweniger Unterhaltungs- und Pflegeaufwand, so entf\u00e4llt das \u0022Linieren\u0022 vor Spielen zum Beispiel komplett, da die Spielfeldlinien in den Belag dauerhaft eingearbeitet sind\u003Cbr \/\u003E\nkeine Staubimmissionen bei trockenem Wetter\u003Cbr \/\u003E\nkeine durch den Sportbelag verschmutzten Schuhe und Bekleidung\u003Cbr \/\u003E\n\u00a0\u003Cbr \/\u003E\nWird ein alter Ascheplatz in einen modernen Kunstrasenplatz umgebaut, dann wird in der Regel die gesamte Sportanlage nachhaltig saniert. Einfriedung, Ballfangz\u00e4une, Barrieren, Trainingsbeleuchtungsanlage, Spielfeld- und Wegebel\u00e4ge, Be- und Entw\u00e4sserung und die Ausstattung werden nach heutigem Stand der Technik erneuert oder instandgesetzt.\u003C\/p\u003E\n\u003Cp\u003EDie Sportanlage kann somit wieder langfristig dem Sport zur Verf\u00fcgung stehen.\u00a0\u003C\/p\u003E\n\u003Cp\u003ENoch sind in K\u00f6ln viele Sportanlagen sanierungsbed\u00fcrftig und der Bedarf an Kunstrasenpl\u00e4tzen lange nicht gedeckt. Die Entscheidung, welche Pl\u00e4tze als n\u00e4chste umgebaut werden, h\u00e4ngt von verschiedenen Faktoren ab. Ma\u00dfgeblich ist dabei vor allem der derzeitigen Platzzustand, die Nutzungsintensit\u00e4t (Anzahl der Mannschaften) und nicht zuletzt auch die Lage der Sportanlage im Stadtgebiet.\u003C\/p\u003E\n\u003Cp\u003EDieser Datensatz enth\u00e4lt die Priorit\u00e4tenliste, d.h. die Rangfolge der zu sanierenden Sportpl\u00e4tze\u00a0gem\u00e4\u00df der Bewertungsmatrix Stand 09\/2020\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"contactPoint":[{"fn":"Sportamt Stadt K\u00f6ln","hasEmail":"sportamt@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Kunstrasenplaetze Koeln Prioritaetenliste","dctModified":"2025-11-18T07:54:06+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 09\/2020\u003C\/p\u003E\n","dctIssued":"2020-09-28T07:53:10+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20200922_Kunstrasen_Prioritaetenliste.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-05-10T10:35:12+02:00","dctModified":"2025-11-27T16:02:17+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dctContributor":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}]},{"identifier":"3dcb5bc2-ba0d-4d1e-a634-a6992527ef4f","title":"Kunstrasenpl\u00e4tze K\u00f6ln Bau Planung","description":"\u003Cp\u003EDurch die Sanierung und den Neubau von Freisportanlagen, stehen K\u00f6lns Fu\u00dfballer*innen nach und nach immer mehr Kunstrasenpl\u00e4tze zur Verf\u00fcgung. Die Vorteile vor allem gegen\u00fcber den alten Aschepl\u00e4tzen liegen auf der Hand:\u003C\/p\u003E\n\u003Cp\u003Ewitterungsunabh\u00e4ngige Bespielbarkeit des Kunstrasenbelages\u003Cbr \/\u003E\nweniger Verletzungen als auf Aschebelag; bessere Kraftabbauwerte\u003Cbr \/\u003E\nweniger Unterhaltungs- und Pflegeaufwand, so entf\u00e4llt das \u0022Linieren\u0022 vor Spielen zum Beispiel komplett, da die Spielfeldlinien in den Belag dauerhaft eingearbeitet sind\u003Cbr \/\u003E\nkeine Staubimmissionen bei trockenem Wetter\u003Cbr \/\u003E\nkeine durch den Sportbelag verschmutzten Schuhe und Bekleidung\u003Cbr \/\u003E\n\u00a0\u003Cbr \/\u003E\nWird ein alter Ascheplatz in einen modernen Kunstrasenplatz umgebaut, dann wird in der Regel die gesamte Sportanlage nachhaltig saniert. Einfriedung, Ballfangz\u00e4une, Barrieren, Trainingsbeleuchtungsanlage, Spielfeld- und Wegebel\u00e4ge, Be- und Entw\u00e4sserung und die Ausstattung werden nach heutigem Stand der Technik erneuert oder instandgesetzt.\u003C\/p\u003E\n\u003Cp\u003EDie Sportanlage kann somit wieder langfristig dem Sport zur Verf\u00fcgung stehen.\u00a0\u003C\/p\u003E\n\u003Cp\u003ENoch sind in K\u00f6ln viele Sportanlagen sanierungsbed\u00fcrftig und der Bedarf an Kunstrasenpl\u00e4tzen lange nicht gedeckt. Die Entscheidung, welche Pl\u00e4tze als n\u00e4chste umgebaut werden, h\u00e4ngt von verschiedenen Faktoren ab. Ma\u00dfgeblich ist dabei vor allem der derzeitigen Platzzustand, die Nutzungsintensit\u00e4t (Anzahl der Mannschaften) und nicht zuletzt auch die Lage der Sportanlage im Stadtgebiet.\u003C\/p\u003E\n\u003Cp\u003EDieser Datensatz enth\u00e4lt die in Planung oder Bau befindlichen Sportpl\u00e4tze Stand 09\/2020\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"contactPoint":[{"fn":"Sportamt Stadt K\u00f6ln","hasEmail":"sportamt@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Kunstrasenplaetze Koeln Bau Planung","dctModified":"2025-11-18T07:52:27+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 09\/2020\u003C\/p\u003E\n","dctIssued":"2020-09-28T07:50:45+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20200922_Kunstrasen_Planung_Bau.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-05-10T10:29:39+02:00","dctModified":"2025-11-27T16:02:17+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dctContributor":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}]},{"identifier":"4d54c6e7-4048-42a4-b715-bc02c7be574b","title":"Kunstrasenpl\u00e4tze K\u00f6ln Bestand","description":"\u003Cp\u003EDurch die Sanierung und den Neubau von Freisportanlagen, stehen K\u00f6lns Fu\u00dfballer*innen nach und nach immer mehr Kunstrasenpl\u00e4tze zur Verf\u00fcgung. Die Vorteile vor allem gegen\u00fcber den alten Aschepl\u00e4tzen liegen auf der Hand:\u003C\/p\u003E\n\u003Cp\u003Ewitterungsunabh\u00e4ngige Bespielbarkeit des Kunstrasenbelages\u003Cbr \/\u003E\nweniger Verletzungen als auf Aschebelag; bessere Kraftabbauwerte\u003Cbr \/\u003E\nweniger Unterhaltungs- und Pflegeaufwand, so entf\u00e4llt das \u0022Linieren\u0022 vor Spielen zum Beispiel komplett, da die Spielfeldlinien in den Belag dauerhaft eingearbeitet sind\u003Cbr \/\u003E\nkeine Staubimmissionen bei trockenem Wetter\u003Cbr \/\u003E\nkeine durch den Sportbelag verschmutzten Schuhe und Bekleidung\u003Cbr \/\u003E\n\u00a0\u003Cbr \/\u003E\nWird ein alter Ascheplatz in einen modernen Kunstrasenplatz umgebaut, dann wird in der Regel die gesamte Sportanlage nachhaltig saniert. Einfriedung, Ballfangz\u00e4une, Barrieren, Trainingsbeleuchtungsanlage, Spielfeld- und Wegebel\u00e4ge, Be- und Entw\u00e4sserung und die Ausstattung werden nach heutigem Stand der Technik erneuert oder instandgesetzt.\u003C\/p\u003E\n\u003Cp\u003EDie Sportanlage kann somit wieder langfristig dem Sport zur Verf\u00fcgung stehen.\u00a0\u003C\/p\u003E\n\u003Cp\u003ENoch sind in K\u00f6ln viele Sportanlagen sanierungsbed\u00fcrftig und der Bedarf an Kunstrasenpl\u00e4tzen lange nicht gedeckt. Die Entscheidung, welche Pl\u00e4tze als n\u00e4chste umgebaut werden, h\u00e4ngt von verschiedenen Faktoren ab. Ma\u00dfgeblich ist dabei vor allem der derzeitigen Platzzustand, die Nutzungsintensit\u00e4t (Anzahl der Mannschaften) und nicht zuletzt auch die Lage der Sportanlage im Stadtgebiet.\u003C\/p\u003E\n\u003Cp\u003EDieser Datensatz enth\u00e4lt Bestandssportpl\u00e4tze\u00a0Stand 09\/2020\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"contactPoint":[{"fn":"Sportamt Stadt K\u00f6ln","hasEmail":"sportamt@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Kunstrasenplaetze Koeln Bestand","dctModified":"2025-11-18T07:55:46+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand 09\/2020\u003C\/p\u003E\n","dctIssued":"2020-09-28T07:48:14+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/20200922_Kunstrasen_Bestand.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2024-05-10T10:22:15+02:00","dctModified":"2025-11-27T16:02:17+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dctContributor":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Sportamt Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00307\/index.html"}]},{"type":"dcat:Dataset","title":"Fl\u00e4chennutzungsplan Web Aktuell ","identifier":"212a8213-c9f4-49f5-9a6d-ea62078d91cd","description":"\u003Cp\u003EDer Fl\u00e4chennutzungsplan stellt die Art der Bodennutzung f\u00fcr das gesamte Stadtgebiet in Grundz\u00fcgen dar. Er dient also der st\u00e4dtebaulichen Zielplanung der Stadt, indem er sowohl die bereits vorhandenen als auch die l\u00e4ngerfristig beabsichtigten Nutzungen von Grundst\u00fccken darstellt.\u003C\/p\u003E\u003Cp\u003EWelche Informationen enth\u00e4lt der Fl\u00e4chennutzungsplan?\u003Cbr \/\u003EAus unserem Fl\u00e4chennutzungsplan k\u00f6nnen Sie insbesondere ablesen, welche Fl\u00e4chen welchen Nutzen haben sollen. Hier einige Beispiele:\u00a0\u003C\/p\u003E\u003Cp\u003EWohnbaufl\u00e4chen\u003Cbr \/\u003Egemischte Baufl\u00e4chen\u003Cbr \/\u003EGewerbe- und Industriefl\u00e4chen\u003Cbr \/\u003EGemeinbedarfsfl\u00e4chen\u003Cbr \/\u003EGr\u00fcnfl\u00e4chen\u003Cbr \/\u003EFl\u00e4chen f\u00fcr die Landwirtschaft und Verkehrsfl\u00e4chen\u003Cbr \/\u003EDar\u00fcber hinaus k\u00f6nnen Sie sich geplante Einrichtungen und Zweckbestimmungen anzeigen lassen. Diese sind zum Beispiel:\u003C\/p\u003E\u003Cp\u003EAlteneinrichtungen\u003Cbr \/\u003EFeuerwehren\u003Cbr \/\u003EFriedh\u00f6fe\u003Cbr \/\u003ESpielpl\u00e4tze\u003Cbr \/\u003EMit dem Fl\u00e4chennutzungsplan treffen wir eine verbindliche Vorentscheidung f\u00fcr die zuk\u00fcnftige st\u00e4dtebauliche Entwicklung K\u00f6lns. Unmittelbare rechtliche Wirkungen f\u00fcr die B\u00fcrger*innen entfaltet der Fl\u00e4chennutzungsplan hingegen nicht. Allein aus den Darstellungen des Fl\u00e4chennutzungsplanes k\u00f6nnen Sie daher kein Baurecht f\u00fcr Ihr Grundst\u00fcck herleiten. Eine verbindliche Konkretisierung erfolgt erst durch die Aufstellung von nachfolgenden Bebauungspl\u00e4nen.\u003C\/p\u003E\u003Cp\u003EUnser derzeit geltender Fl\u00e4chennutzungsplan ist seit 1982 wirksam und wird stets aktualisiert.\u003C\/p\u003E\u003Cp\u003EDieser Datensatz zeigt\u00a0alle bestehenden und im Bauleitplanverfahren vorgesehenen Fl\u00e4chennutzungen sowie Einrichtungen und Zweckbestimmungen auf dem K\u00f6lner Stadtgebiet\u00a0\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EDie komplette Auflistung bzw. Visualisierung findet man hier: \u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechenn...%C2%A0\u0022\u003Ehttp:\/\/www.stadt-koeln.de\/leben-in-koeln\/planen-bauen\/suche-im-flaechenn...\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"Fl\u00e4chennutzungsplan K\u00f6ln"},"keyword":["Geo"],"politicalGeocodingL