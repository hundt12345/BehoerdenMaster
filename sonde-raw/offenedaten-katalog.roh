:"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"b7a70175-3e20-45a9-a2a3-2f03e953989d","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe und Besch\u00e4ftigte (Jahr ab 2008)","description":"\u003Cp\u003EBergbau und Verarbeitendes Gewerbe: Betriebe und\u003Cbr \/\u003E\nBesch\u00e4ftigte.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=42111B-4d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Statistik im Bergbau und Verarbeitenden Gewerbe gibt\u003Cbr \/\u003E\nAuskunft \u00fcber die Struktur der nordrhein-westf\u00e4lischen\u003Cbr \/\u003E\nIndustrie. Die Merkmale Anzahl Betriebe, Besch\u00e4ftigte,\u003Cbr \/\u003E\nEntgelte, Umsatz (Gesamt-, Inlands- und Auslandsumsatz)\u003Cbr \/\u003E\nwerden j\u00e4hrlich bei den Betrieben im Bergbau und\u003Cbr \/\u003E\nVerarbeitenden Gewerbe, untergliedert nach\u003Cbr \/\u003E\nWirtschaftszweigen, erhoben. Die r\u00e4umliche Differenzierung\u003Cbr \/\u003E\nerfolgt bis auf die Ebene der Gemeinden.\u003C\/p\u003E\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe und Besch\u00e4ftigte XML","dctModified":"2025-11-17T12:01:22+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-17T09:15:29+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42111B-4i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe und Besch\u00e4ftigte CSV","dctModified":"2025-11-17T12:00:50+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-17T09:15:51+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42111B-4i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Bergbau und Verarbeitendes Gewerbe: Betriebe und Besch\u00e4ftigte XLSX","dctModified":"2025-11-17T12:01:07+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-17T09:16:14+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=42111B-4i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["42111B-4d"],"adms:Identifier":[{"title":"42111B-4d"}],"dctIssued":"2024-06-17T11:13:33+02:00","dctModified":"2025-11-27T15:50:33+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"60eb3686-45db-48ab-8133-2d1ed7b2fe52","title":"Landwirtschaftliche Haltungen mit Rindern und Rinderbest\u00e4nde","description":"\u003Cp\u003ELandwirtschaftliche Haltungen mit Rindern und Rinderbest\u00e4nde.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n    \u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41312-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erhebung der Rinderbest\u00e4nde erfolgt als\u003Cbr \/\u003E\nsekund\u00e4rstatistische Auswertung des \u201eHerkunftssicherungs-\u003Cbr \/\u003E\nund Informationssystems Tier\u201c (HIT). Alle Rinderhalter in\u003Cbr \/\u003E\nDeutschland sind gesetzlich verpflichtet, ihren\u003Cbr \/\u003E\nRinderbestand in HIT anzugeben. In dieser Datenbank sind\u003Cbr \/\u003E\ndie Rindermerkmale auf Einzeltierbasis gespeichert. Die\u003Cbr \/\u003E\nHIT-Rinderdatenbank war nach der BSE-Krise eingerichtet\u003Cbr \/\u003E\nworden; sie dient vor allem der l\u00fcckenlosen\u003Cbr \/\u003E\nR\u00fcckverfolgbarkeit von Rindfleisch vom Verkaufstresen bis\u003Cbr \/\u003E\nzum Erzeugerbetrieb und der Bek\u00e4mpfung von Tierseuchen. In\u003Cbr \/\u003E\nder HIT-Rinderdatenbank werden keine landwirtschaftlichen\u003Cbr \/\u003E\nBetriebe, sondern viehseuchenrechtliche Einheiten\u003Cbr \/\u003E\nverwaltet. Das bedeutet, dass zum Beispiel ein\u003Cbr \/\u003E\nlandwirtschaftlicher Betrieb mehrere St\u00e4lle f\u00fcr seine\u003Cbr \/\u003E\nRinder bewirtschaften kann, die in der HIT-Rinderdatenbank\u003Cbr \/\u003E\nunter Umst\u00e4nden einzeln als Haltungen gef\u00fchrt werden. Somit\u003Cbr \/\u003E\ngibt es mehr landwirtschaftliche Haltungen mit Rindern als\u003Cbr \/\u003E\nlandwirtschaftliche Betriebe mit Rindern.\u003C\/p\u003E\n\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Landwirtschaftliche Haltungen mit Rindern und Rinderbest\u00e4nde XML","dctModified":"2025-11-17T11:59:17+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-17T08:54:27+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41312-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Haltungen mit Rindern und Rinderbest\u00e4nde CSV","dctModified":"2025-11-17T11:58:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-17T08:54:47+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41312-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Haltungen mit Rindern und Rinderbest\u00e4nde XLSX","dctModified":"2025-11-17T11:59:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-17T08:55:13+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41312-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["41312-01i"],"adms:Identifier":[{"title":"41312-01i"}],"dctIssued":"2024-06-17T10:54:00+02:00","dctModified":"2025-11-27T15:53:25+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"47c6859f-b7bc-4fc6-aa67-484437b389f4","title":"Anzahl der Betriebe mit Investitionen, darunter f\u00fcr Umwelt, deren Besch\u00e4ftigte so wie Investitionen insgesamt u. f\u00fcr den Umweltschutz nach Bereichen","description":"\u003Cp\u003EAnzahl der Betriebe mit Investitionen, darunter f\u00fcr Umwelt,\u003Cbr \/\u003E\nderen Besch\u00e4ftigte so wie Investitionen insgesamt u. f\u00fcr den\u003Cbr \/\u003E\nUmweltschutz nach Bereichen.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=32511-02d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=3...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Erhebung der Investitionen f\u00fcr den Umweltschutz gibt\u003Cbr \/\u003E\nAuskunft \u00fcber den Umfang, die Struktur und die Entwicklung\u003Cbr \/\u003E\nder Investitionst\u00e4tigkeit f\u00fcr den Umweltschutz in der\u003Cbr \/\u003E\ngewerblichen Wirtschaft. Die Investitionen und der Wert der\u003Cbr \/\u003E\nzus\u00e4tzlich neu gemieteten und gepachteten neuen Sachanlagen\u003Cbr \/\u003E\nf\u00fcr den Umweltschutz sind Kernmerkmale, die j\u00e4hrlich erhoben\u003Cbr \/\u003E\nwerden. Die Datenerhebung erfolgt bei Unternehmen und\u003Cbr \/\u003E\nBetrieben des Bergbaus und der Gewinnung von Steinen und\u003Cbr \/\u003E\nErden, sowie bei Unternehmen und Betrieben des\u003Cbr \/\u003E\nVerarbeitenden Gewerbes, der Energie- und Wasserversorgung\u003Cbr \/\u003E\nund der Abfallbeseitigung nach speziellen\u003Cbr \/\u003E\nAbgrenzungskriterien. R\u00e4umlich differenziert sind die Daten\u003Cbr \/\u003E\nbis auf die Ebene der kreisfreien St\u00e4dte und Kreise.\u003C\/p\u003E\n","keyword":["Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Anzahl der Betriebe mit Investitionen, darunter f\u00fcr Umwelt, deren Besch\u00e4ftigte so wie Investitionen insgesamt u. f\u00fcr den Umweltschutz nach Bereichen  XML","dctModified":"2025-11-17T11:30:31+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-17T08:44:19+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32511-02i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Anzahl der Betriebe mit Investitionen, darunter f\u00fcr Umwelt, deren Besch\u00e4ftigte so wie Investitionen insgesamt u. f\u00fcr den Umweltschutz nach Bereichen  CSV","dctModified":"2025-11-17T11:30:00+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-17T08:44:46+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32511-02i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Anzahl der Betriebe mit Investitionen, darunter f\u00fcr Umwelt, deren Besch\u00e4ftigte so wie Investitionen insgesamt u. f\u00fcr den Umweltschutz nach Bereichen  XLSX","dctModified":"2025-11-17T11:30:14+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-17T08:45:16+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=32511-02i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["32511-02d"],"adms:Identifier":[{"title":"32511-02d"}],"dctIssued":"2024-06-17T10:40:30+02:00","dctModified":"2025-11-27T15:51:29+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"4101528c-9ce9-458c-850d-1e8a2f928505","title":"Betriebsfl\u00e4che der landwirtschaftlichen Betriebe nach landwirtschaftlich genutzten und sonstigen Fl\u00e4chen sowie Hauptnutzungs- und Kulturarten","description":"\u003Cp\u003EBetriebsfl\u00e4che der landwirtschaftlichen Betriebe nach\u003Cbr \/\u003E\n    landwirtschaftlich genutzten und sonstigen Fl\u00e4chen sowie\u003Cbr \/\u003E\n    Hauptnutzungs- und Kulturarten.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n    \u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41271-03d\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErl\u00e4uterung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Bodennutzungshaupterhebung\u00a0zielt in erster Linie auf die\u003Cbr \/\u003E\n    Differenzierung der landwirtschaftlich genutzten Fl\u00e4che nach\u003Cbr \/\u003E\n    Hauptnutzungsarten, Kulturarten und Fruchtarten ab.\u003C\/p\u003E\n\n","keyword":["Infrastruktur","Bauen und Wohnen","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Betriebsfl\u00e4che der landwirtschaftlichen Betriebe nach landwirtschaftlich genutzten und sonstigen Fl\u00e4chen sowie Hauptnutzungs- und Kulturarten XML","dctModified":"2025-11-17T11:55:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-14T14:56:53+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41271-03i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebsfl\u00e4che der landwirtschaftlichen Betriebe nach landwirtschaftlich genutzten und sonstigen Fl\u00e4chen sowie Hauptnutzungs- und Kulturarten CSV","dctModified":"2025-11-17T11:54:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-14T14:57:20+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41271-03i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebsfl\u00e4che der landwirtschaftlichen Betriebe nach landwirtschaftlich genutzten und sonstigen Fl\u00e4chen sowie Hauptnutzungs- und Kulturarten XLSX","dctModified":"2025-11-17T11:55:10+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-14T14:57:46+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41271-03i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["41271-03d"],"adms:Identifier":[{"title":"41271-03d"}],"dctIssued":"2024-06-14T16:56:24+02:00","dctModified":"2025-11-27T15:51:34+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"8be9325f-0f1d-4fac-ac89-c37a47cf2e0c","title":"Landwirtschaftliche Betriebe und deren Fl\u00e4che nach der Betriebswirtschaftlichen Ausrichtung.","description":"\u003Cp\u003ELandwirtschaftliche Betriebe und deren Fl\u00e4che nach der\u003Cbr \/\u003E\n    Betriebswirtschaftlichen Ausrichtung.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n    \u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41141-206i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErl\u00e4uterung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Landwirtschaftsz\u00e4hlung (LZ) und die\u003Cbr \/\u003E\n    Agrarstrukturerhebung (ASE) liefern eine Vielzahl an Daten\u003Cbr \/\u003E\n    \u00fcber Viehbest\u00e4nde, Bodennutzung, Arbeitskr\u00e4fte und weitere\u003Cbr \/\u003E\n    Strukturdaten. In Jahren einer Landwirtschaftsz\u00e4hlung ist\u003Cbr \/\u003E\n    die Agrarstrukturerhebung ein Bestandteil davon.\u003Cbr \/\u003E\n    Die LZ enth\u00e4lt einen umfangreichen Merkmalskatalog und wird\u003Cbr \/\u003E\n    seit 1949 etwa alle zehn Jahre (zuletzt 2010 und aktuell\u003Cbr \/\u003E\n    2020) durchgef\u00fchrt. Die ASE wird dagegen seit 2010 in den\u003Cbr \/\u003E\n    Jahren erhoben, die mit einer 3 oder einer 6 enden (bspw.\u003Cbr \/\u003E\n    2013, 2016), jedoch mit einem reduzierten Merkmalskatalog.\u003Cbr \/\u003E\n    Vor 2010 fand die ASE alle zwei Jahre statt.\u003Cbr \/\u003E\n    Die ASE 2016 stellt eine Kombination einer allgemeinen\u003Cbr \/\u003E\n    Erhebung (Totalerhebung mit Abschneidegrenzen) mit einer\u003Cbr \/\u003E\n    repr\u00e4sentativen Erhebung (Stichprobenerhebung) dar. Vor der\u003Cbr \/\u003E\n    Agrarstrukturerhebung 2016 fand die letzte\u003Cbr \/\u003E\n    Agrarstrukturerhebung im Jahr 2013 als reine\u003Cbr \/\u003E\n    Stichprobenerhebung statt.\u003Cbr \/\u003E\n    Die forstwirtschaftlichen Betriebe bilden einen Sonderfall \u2013\u003Cbr \/\u003E\n    diese wurden zuletzt im Rahmen der Landwirtschaftsz\u00e4hlung\u003Cbr \/\u003E\n    2010 und der Agrarstrukturerhebung 2016 einbezogen. Ab 2022\u003Cbr \/\u003E\n    wird es eine eigenst\u00e4ndige Forststrukturerhebung geben\u003C\/p\u003E\n\n","keyword":["Infrastruktur","Bauen und Wohnen","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und deren Fl\u00e4che nach der Betriebswirtschaftlichen Ausrichtung XML","dctModified":"2024-06-14T14:40:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-14T14:40:26+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-206i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und deren Fl\u00e4che nach der Betriebswirtschaftlichen Ausrichtung CSV","dctModified":"2024-06-14T14:40:52+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-14T14:40:52+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-206i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und deren Fl\u00e4che nach der Betriebswirtschaftlichen Ausrichtung XLSX","dctModified":"2024-06-14T14:42:31+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-14T14:42:31+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-206i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"dctIssued":"2024-06-14T16:39:54+02:00","dctModified":"2025-11-27T15:54:24+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"199f0ec6-3bee-4b6e-80e0-b00ead1cecb0","title":"Landwirtschaftliche Betriebe mit Viehhaltung und Zahl der Tiere nach Tierarten (ab 2010)","description":"\u003Cp\u003ELandwirtschaftliche Betriebe mit Viehhaltung und Zahl der Tiere nach Tierarten (ab 2010).\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41141-04i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EErl\u00e4uterung:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Landwirtschaftsz\u00e4hlung (LZ) und die\u003Cbr \/\u003E\nAgrarstrukturerhebung (ASE) liefern eine Vielzahl an Daten\u003Cbr \/\u003E\n\u00fcber Viehbest\u00e4nde, Bodennutzung, Arbeitskr\u00e4fte und weitere\u003Cbr \/\u003E\nStrukturdaten. In Jahren einer Landwirtschaftsz\u00e4hlung ist\u003Cbr \/\u003E\ndie Agrarstrukturerhebung ein Bestandteil davon.\u003Cbr \/\u003E\nDie LZ enth\u00e4lt einen umfangreichen Merkmalskatalog und wird\u003Cbr \/\u003E\nseit 1949 etwa alle zehn Jahre (zuletzt 2010 und aktuell\u003Cbr \/\u003E\n2020) durchgef\u00fchrt. Die ASE wird dagegen seit 2010 in den\u003Cbr \/\u003E\nJahren erhoben, die mit einer 3 oder einer 6 enden (bspw.\u003Cbr \/\u003E\n2013, 2016), jedoch mit einem reduzierten Merkmalskatalog.\u003Cbr \/\u003E\nVor 2010 fand die ASE alle zwei Jahre statt.\u003Cbr \/\u003E\nDie ASE 2016 stellt eine Kombination einer allgemeinen\u003Cbr \/\u003E\nErhebung (Totalerhebung mit Abschneidegrenzen) mit einer\u003Cbr \/\u003E\nrepr\u00e4sentativen Erhebung (Stichprobenerhebung) dar. Vor der\u003Cbr \/\u003E\nAgrarstrukturerhebung 2016 fand die letzte\u003Cbr \/\u003E\nAgrarstrukturerhebung im Jahr 2013 als reine\u003Cbr \/\u003E\nStichprobenerhebung statt.\u003Cbr \/\u003E\nDie forstwirtschaftlichen Betriebe bilden einen Sonderfall \u2013\u003Cbr \/\u003E\ndiese wurden zuletzt im Rahmen der Landwirtschaftsz\u00e4hlung\u003Cbr \/\u003E\n2010 und der Agrarstrukturerhebung 2016 einbezogen. Ab 2022\u003Cbr \/\u003E\nwird es eine eigenst\u00e4ndige Forststrukturerhebung geben\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und Zahl der Tiere nach Tierarten XML","dctModified":"2025-11-17T11:47:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-14T14:26:47+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-04i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und Zahl der Tiere nach Tierarten CSV","dctModified":"2025-11-17T11:46:59+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-14T14:27:16+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-04i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und Zahl der Tiere nach Tierarten XLSX","dctModified":"2025-11-17T11:47:11+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-14T14:27:45+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41141-04i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["41141-04i"],"adms:Identifier":[{"title":"41141-04i"}],"dctIssued":"2024-06-14T16:25:14+02:00","dctModified":"2025-11-27T15:53:55+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"141bdc7d-2f72-444c-bb45-dfa29ece098e","title":"Landwirtschaftliche Betriebe mit Viehhaltung und deren Tierbestand (bis 2007)","description":"\u003Cp\u003ELandwirtschaftliche Betriebe mit Viehhaltung und deren\u003Cbr \/\u003E\nTierbestand.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41121-37i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Agrarstrukturerhebung gibt Auskunft \u00fcber die\u003Cbr \/\u003E\nProduktionsstrukturen und -kapazit\u00e4ten der\u003Cbr \/\u003E\nlandwirtschaftlichen Betriebe sowie \u00fcber deren\u003Cbr \/\u003E\nBetriebsstrukturen und die wirtschaftlichen und\u003Cbr \/\u003E\nsozialen Verh\u00e4ltnisse der Betriebsinhaber(innen)\u003Cbr \/\u003E\nund\/oder -leiter(innen). Wesentliche Inhalte der\u003Cbr \/\u003E\nAgrarstrukturerhebung sind die Angaben zur\u003Cbr \/\u003E\nBodennutzung, den Viehbest\u00e4nden und den\u003Cbr \/\u003E\nArbeitskr\u00e4ften zuz\u00fcglich weitererausgew\u00e4hlter\u003Cbr \/\u003E\nStrukturmerkmale. Die Agrarstrukturerhebung\u003Cbr \/\u003E\n(fr\u00fcher \u0022Agrarberichterstattung\u0022) wurde in\u003Cbr \/\u003E\nDeutschland von 1975 bis einschlie\u00dflich 2007 alle\u003Cbr \/\u003E\nzwei Jahre durchgef\u00fchrt, wobei in jeder zweiten\u003Cbr \/\u003E\nErhebung, d.h. alle vier Jahre, ein Teil der\u003Cbr \/\u003E\nMerkmale total erhoben wurde. In den Jahren einer\u003Cbr \/\u003E\nLandwirtschaftsz\u00e4hlung (1979, 1991, 1999 und 2010)\u003Cbr \/\u003E\nwar die Agrarstrukturerhebung Bestandteil der\u003Cbr \/\u003E\nLandwirtschaftsz\u00e4hlung. Auskunftspflichtig sind\u003Cbr \/\u003E\nInhaber\/-innen oder Leiter\/-innen von Betrieben\u003Cbr \/\u003E\ngem\u00e4\u00df der Erfassungsgrenzen. R\u00e4umlich\u003Cbr \/\u003E\ndifferenziert sind die Daten bis auf Ebene der\u003Cbr \/\u003E\nkreisfreien St\u00e4dte und Kreise (Totalerhebung) bzw.\u003Cbr \/\u003E\nbis auf Regierungsbezirksebene (repr\u00e4sentative\u003Cbr \/\u003E\nErhebung).\u003C\/p\u003E\n","keyword":["Infrastruktur","Bauen und Wohnen","Umwelt und Klima","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und deren Tierbestand XML","dctModified":"2025-11-17T11:45:58+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-14T14:15:33+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-37i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und deren Tierbestand CSV","dctModified":"2025-11-17T11:45:23+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-14T14:16:08+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-37i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe mit Viehhaltung und deren Tierbestand XLSX","dctModified":"2025-11-17T11:45:39+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-14T14:16:37+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-37i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["41121-37i"],"adms:Identifier":[{"title":"41121-37i"}],"dctIssued":"2024-06-14T16:15:08+02:00","dctModified":"2025-11-27T15:53:58+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"a804866f-1ff9-4d84-b35c-7f81ce09417e","title":"Landwirtschaftliche Betriebe und landwirtschaftlich genutzte Fl\u00e4che (LF) n. Kulturarten (bis 2007)","description":"\u003Cp\u003ELandwirtschaftliche Betriebe und landwirtschaftlich genutzte Fl\u00e4che (LF) n. Kulturarten.\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank:\u003Cbr \/\u003E\n    \u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=41121-01i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=4...\u003C\/a\u003E\u003Cbr \/\u003E\n    \u00a0\u003C\/p\u003E\n\u003Cp\u003E    \u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003E    Die Agrarstrukturerhebung gibt Auskunft \u00fcber die\u003Cbr \/\u003E\n    Produktionsstrukturen und -kapazit\u00e4ten der\u003Cbr \/\u003E\n    landwirtschaftlichen Betriebe sowie \u00fcber deren\u003Cbr \/\u003E\n    Betriebsstrukturen und die wirtschaftlichen und\u003Cbr \/\u003E\n    sozialen Verh\u00e4ltnisse der Betriebsinhaber(innen)\u003Cbr \/\u003E\n    und\/oder -leiter(innen). Wesentliche Inhalte der\u003Cbr \/\u003E\n    Agrarstrukturerhebung sind die Angaben zur\u003Cbr \/\u003E\n    Bodennutzung, den Viehbest\u00e4nden und den\u003Cbr \/\u003E\n    Arbeitskr\u00e4ften zuz\u00fcglich weitererausgew\u00e4hlter\u003Cbr \/\u003E\n    Strukturmerkmale. Die Agrarstrukturerhebung\u003Cbr \/\u003E\n    (fr\u00fcher \u0022Agrarberichterstattung\u0022) wurde in\u003Cbr \/\u003E\n    Deutschland von 1975 bis einschlie\u00dflich 2007 alle\u003Cbr \/\u003E\n    zwei Jahre durchgef\u00fchrt, wobei in jeder zweiten\u003Cbr \/\u003E\n    Erhebung, d.h. alle vier Jahre, ein Teil der\u003Cbr \/\u003E\n    Merkmale total erhoben wurde. In den Jahren einer\u003Cbr \/\u003E\n    Landwirtschaftsz\u00e4hlung (1979, 1991, 1999 und 2010)\u003Cbr \/\u003E\n    war die Agrarstrukturerhebung Bestandteil der\u003Cbr \/\u003E\n    Landwirtschaftsz\u00e4hlung. Auskunftspflichtig sind\u003Cbr \/\u003E\n    Inhaber\/-innen oder Leiter\/-innen von Betrieben\u003Cbr \/\u003E\n    gem\u00e4\u00df der Erfassungsgrenzen. R\u00e4umlich\u003Cbr \/\u003E\n    differenziert sind die Daten bis auf Ebene der\u003Cbr \/\u003E\n    kreisfreien St\u00e4dte und Kreise (Totalerhebung) bzw.\u003Cbr \/\u003E\n    bis auf Regierungsbezirksebene (repr\u00e4sentative\u003Cbr \/\u003E\n    Erhebung).\u003C\/p\u003E\n\n","keyword":["Infrastruktur","Bauen und Wohnen","Umwelt und Klima","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und landwirtschaftlich genutzte Fl\u00e4che (LF) n. Kulturarten XML","dctModified":"2025-11-17T11:42:36+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-14T13:38:42+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und landwirtschaftlich genutzte Fl\u00e4che (LF) n. Kulturarten CSV","dctModified":"2025-11-17T11:42:10+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-14T13:39:04+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Landwirtschaftliche Betriebe und landwirtschaftlich genutzte Fl\u00e4che (LF) n. Kulturarten XLSX","dctModified":"2025-11-17T11:42:24+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-14T13:39:27+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=41121-01i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["41121-01i"],"adms:Identifier":[{"title":"41121-01i"}],"dctIssued":"2024-06-14T15:37:38+02:00","dctModified":"2025-11-27T15:52:52+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"548ca0e1-7fe6-46da-9b7c-74243666d82d","title":"\u00dcbersicht der Beteiligungsprojekte","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003EHier finden Sie die Projekte die hier auf dem Portal seit 2019 durchgef\u00fchrt wurden.\u00a0\u003C\/p\u003E\n\u003Cp\u003EDie Projekte sind in drei Kategorien unterteilt:\u003C\/p\u003E\n\u003Cp\u003ELaufende Projekte\u00a0\u003C\/p\u003E\n\u003Cp\u003EAbgeschlossene Projekte\u00a0\u003C\/p\u003E\n\u003Cp\u003Eund Projekte bei denen zwar keine Beteiligung mehr m\u00f6glich ist, die aber noch nicht umgesetzt sind.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/74\u0022\u003E\u00dcbersicht der Projekte | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"\u00dcbersicht der Projekte","dctModified":"2024-06-13T10:37:50+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T10:37:50+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/74\/export\/posts\/export_dialog_posts_74_ubersicht_der_projekte.csv?destination=\/daten"}],"dctIssued":"2024-06-13T12:35:57+02:00","dctModified":"2025-11-27T15:55:04+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: SportPark in Weidenpesch","identifier":"6780da9b-9eb1-41d6-aeff-e78807be7e6b","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EEin neuer\u00a0SportPark\u00a0in\u00a0Weidenpesch\u00a0entsteht!\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EIhre Anregungen, Ideen und W\u00fcnsche sind gefragt!\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EHerzlich willkommen zum Online-Dialog zur Gestaltung des\u00a0\u201e\u003Cstrong\u003ESportPark\u003C\/strong\u003E\u201c in\u00a0Weidenpesch. Er wird ein Teilbereich\u00a0der Bezirkssportanlage Scheibenstra\u00dfe in\u00a0K\u00f6ln-Weidenpesch, den wir f\u00fcr Sie im Luftbild gekennzeichnet haben.\u003C\/p\u003E\u003Cp\u003EWir laden Sie ein, Ihre Anregungen und Hinweise zur Gestaltung sowie erste Ideen zur Entwicklung diverser Sportbereiche und Bewegungsr\u00e4ume sowie Erholungsfl\u00e4chen einzubringen\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/group\/Sportpark-Weidenpesch\/Anregungen-Sportpark-Weidenpesch\u0022\u003ESportPark in Weidenpesch | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Gesundheit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"SportPark in Weidenpesch","dctModified":"2024-06-13T10:33:57+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T10:33:57+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/20\/export\/posts\/export_dialog_posts_20_sportpark_in_weidenpesch.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T10:33:34+00:00","dctModified":"2025-11-27T14:54:44+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"type":"dcat:Dataset","title":"Beteiligungsprojekt: Neugestaltung der Fu\u00dfg\u00e4ngerzone der Bahnhofstra\u00dfe in K\u00f6ln-Porz","identifier":"ff52fcda-4398-436f-a023-d41b1c52ae3a","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\u003Cp\u003EDie Fu\u00dfg\u00e4ngerzone der Bahnhofstra\u00dfe in Porz soll erneuert werden, da sie den heutigen Anforderungen nicht\u00a0mehr gerecht wird. Die Neue Mitte Porz wurde bereits mit drei\u00a0neuen Geb\u00e4uden gestaltet. Die Umgestaltung der Freianlagen\u00a0in Porz-Mitte soll zeitnah folgen. Ein weiterer Schritt zur\u00a0Verbesserung\u00a0der Innenstadt von Porz ist die Neugestaltung der\u00a0Bahnhofstra\u00dfe. Dies geschieht zusammen mit der Parkanlage Glash\u00fcttenstra\u00dfe, der Umgestaltung des Rheinboulevards Porz\u00a0und der\u00a0 Fu\u00dfg\u00e4ngerbr\u00fccke \u00fcber die Hauptstra\u00dfe.\u003C\/p\u003E\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/168\u0022\u003ENeugestaltung der Fu\u00dfg\u00e4ngerzone der Bahnhofstra\u00dfe in K\u00f6ln-Porz | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"keyword":["Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Neugestaltung der Fu\u00dfg\u00e4ngerzone der Bahnhofstra\u00dfe in K\u00f6ln-Porz","dctModified":"2024-06-13T10:27:00+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T10:27:00+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/168\/export\/posts\/export_dialog_posts_168_neugestaltung_der_fussgangerzo.csv?destination=\/daten","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"mailto:oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"dctIssued":"2024-06-13T10:26:42+00:00","dctModified":"2025-11-27T14:55:01+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"identifier":"14fe6de4-0b84-4e33-9025-32fbd2362afc","title":"Programm Ehrenfeld - Ihre digitale Karte","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\n\u003Cp\u003EEs wurde ganz konkret: In den Karten konnten Sie Ihre Vorschl\u00e4ge f\u00fcr Ehrenfeld und Kalk genau verorten. Sie konnten Adressen eingeben oder direkt Ihren Standort teilen.\u003Cbr \/\u003E\n\u00a0\u003C\/p\u003E\n\u003Cp\u003EDazu konnten Sie folgende Kriterien nutzen:\u003C\/p\u003E\n\u003Col\u003E\n\u003Cli\u003E\u003Cstrong\u003EMehr Gr\u00fcn\u003C\/strong\u003E\u003Cbr \/\u003E\n    Wo k\u00f6nnen Sie sich mehr Gr\u00fcn in Ehrenfeld vorstellen?\u003Cbr \/\u003E\n    Beispiele: Neue B\u00e4ume, neue Gr\u00fcnfl\u00e4chen, Gr\u00fcn statt Grau, Dachbegr\u00fcnung Fassadenbegr\u00fcnung, gr\u00fcne Stra\u00dfen,\u00a0Essbare Stadt - urbanes g\u00e4rtnern.\u003C\/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EMehr Vielfalt\u003C\/strong\u003E\u003Cbr \/\u003E\n    Was fehlt Ihnen noch vor Ort? Wovon muss es mehr geben?\u003Cbr \/\u003E\n    Beispiele:\u003Cstrong\u003E\u00a0\u003C\/strong\u003EToiletten, Sport-\u0026amp; Spielger\u00e4te, Angebote zum Aufenthalt, Trinkbrunnen, Bewegungsangebote, Spielfl\u00e4chen, Hundefl\u00e4chen, Ruhefl\u00e4chen, artenreiche Wiesen, Streuobstwiesen, Feuchtbiotope, Wildnis.\u003C\/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EWeniger Konflikte\u003C\/strong\u003E\u003Cbr \/\u003E\n    Wo gibt es Handlungsbedarf? Wie k\u00f6nnen aus ihrer Sicht Konflikte vermieden werden?\u003Cbr \/\u003E\n    Beispiele: Zug\u00e4nge zum Park schaffen,\u00a0Bewusstsein f\u00fcr andere Nutzer*innen schaffen, mehr Beteiligung der Nutzer*innen,\u00a0Parkranger\/Knigge,\u00a0Sauberkeit verbessern,\u00a0Sicherheit erh\u00f6hen.\u003C\/li\u003E\n\u003C\/ol\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/93\u0022\u003EMasterplan Stadtgr\u00fcn f\u00fcr Ehrenfeld | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen","Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Programm Ehrenfeld - Ihre digitale Karte","dctModified":"2024-06-13T10:23:42+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T10:23:42+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/93\/export\/posts\/export_dialog_posts_93_masterplan_stadtgrun_fur_ehren.csv?destination=\/daten"}],"dctIssued":"2024-06-13T12:23:08+02:00","dctModified":"2025-11-27T15:55:06+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dctContributor":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeOriginator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dcatdeMaintainer":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}]},{"identifier":"7592e5ee-feac-414c-b169-4632ab8d61df","title":"Programm Kalk - Ihre digitale Karte","description":"\u003Cp\u003EZu Verf\u00fcgung stehen die Beteiligungsbeitr\u00e4ge im CSV\u00a0Format.\u003C\/p\u003E\n\u003Cp\u003E.\u003C\/p\u003E\n\u003Cp\u003EEs wurde ganz konkret: In den Karten konnten Sie Ihre Vorschl\u00e4ge f\u00fcr Ehrenfeld und Kalk genau verorten. Sie konnten Adressen eingeben oder direkt Ihren Standort teilen.\u003C\/p\u003E\n\u003Cp\u003E\u00a0\u003C\/p\u003E\n\u003Cp\u003ESie konnten dazu folgende Kriterien nutzen:\u00a0\u003C\/p\u003E\n\u003Col\u003E\n\u003Cli\u003E\u003Cstrong\u003EMehr Gr\u00fcn\u003C\/strong\u003E\n\u003Cp\u003EWo k\u00f6nnen Sie sich mehr Gr\u00fcn in Kalk\u00a0vorstellen?\u003Cbr \/\u003E\n    Beispiele: Neue B\u00e4ume, neue Gr\u00fcnfl\u00e4chen, Gr\u00fcn statt Grau, Dachbegr\u00fcnung Fassadenbegr\u00fcnung, gr\u00fcne Stra\u00dfen,\u00a0Essbare Stadt - urbanes g\u00e4rtnern.\u003C\/p\u003E\n\u003C\/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EMehr Vielfalt\u003C\/strong\u003E\u003Cbr \/\u003E\n    Was fehlt Ihnen noch vor Ort? Wovon muss es mehr geben?\u003Cbr \/\u003E\n    Beispiele:\u003Cstrong\u003E\u00a0\u003C\/strong\u003EToiletten, Sport-\u0026amp; Spielger\u00e4te, Angebote zum Aufenthalt, Trinkbrunnen, Bewegungsangebote, Spielfl\u00e4chen, Hundefl\u00e4chen, Ruhefl\u00e4chen,\u00a0artenreiche Wiesen, Streuobstwiesen, Feuchtbiotope, Wildnis.\u003C\/li\u003E\n\u003Cli\u003E\u003Cstrong\u003EWeniger Konflikte\u003C\/strong\u003E\u003Cbr \/\u003E\n    Wo gibt es Handlungsbedarf? Wie k\u00f6nnen aus ihrer Sicht Konflikte vermieden werden?\u003Cbr \/\u003E\n    Beispiele: Zug\u00e4nge zum Park schaffen,\u00a0Bewusstsein f\u00fcr andere Nutzer*innen schaffen,\u00a0Mehr Beteiligung der Nutzer*innen,\u00a0Parkranger\/Knigge,\u00a0Sauberkeit verbessern,\u00a0Sicherheit erh\u00f6hen.\u00a0\u003C\/li\u003E\n\u003C\/ol\u003E\n\u003Cp\u003EMehr Infos unter:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/meinungfuer.koeln\/dialog\/133\u0022\u003EMasterplan Stadtgr\u00fcn - Programm Kalk | Beteiligungsportal der Stadt K\u00f6ln (meinungfuer.koeln)\u003C\/a\u003E\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Infrastruktur","Bauen und Wohnen","Umwelt und Klima"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Meinung f\u00fcr K\u00f6ln","hasEmail":"oeffentlichkeitsbeteiligung@stadt-koeln.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Meinung f\u00fcr K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Programm Kalk - Ihre digitale Karte","dctModified":"2024-06-13T10:21:47+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-13T10:21:47+00:00","downloadURL":"https:\/\/meinungfuer.koeln\/dz-dialog\/133\/export\/posts\/export_dialog_posts_133_masterplan_stadtgrun_-_program.csv?destination=\/daten"}],"dctIssued":"2024-06-13T12:20:16+02:00","dctModified":"2025-11-27T15:55:03+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Meinung f\u00fcr K\u00f6ln","foaf_homepage":"https:\/\/meinungfuer.koeln"}],"dc