eator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"@type":"dcat:Dataset","title":"Stimmbezirke K\u00f6ln","identifier":"fb5baa02-b0bf-4685-a850-ff5c4e24aeeb","description":"\u003Cp\u003EEin Stimmbezirk ist die kleinr\u00e4umigste Einheit zur Wahlorganisation. Diesem wird bei einer Wahl ein Wahlraum zur Stimmabgabe an der Urne zugeteilt. Aufgrund von Bev\u00f6lkerungswachstum und -wanderungen m\u00fcssen die Stimmbezirke in einer Kommune regelm\u00e4\u00dfig \u00fcberpr\u00fcft und gegebenenfalls neu eingeteilt werden. Die aktuell g\u00fcltige Einteilung umfasst 503 Stimmbezirke.\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003ENeu seit 2024: \u003C\/strong\u003EEs besteht eine 1:1-Beziehung zwischen Stimmbezirken und Briefwahlbezirken. Die Zuordnung ist der CSV-Datei Briefwahlbezirk zu entnehmen.\u003C\/p\u003E\u003Cp\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003Cbr \/\u003EKoordinatensystem