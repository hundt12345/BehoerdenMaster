_2009.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Wahlamt der Stadt K\u00f6ln","hasEmail":"mailto:wahlamt@stadt-koeln.de"}],"dctIssued":"2014-05-19T13:05:54+00:00","dctModified":"2025-11-19T10:27:19+00:00","dctRelation":[{"rdf_resource":"https:\/\/www.offenedaten-koeln.de\/dataset\/datensaetze-neuauszaehlung-verbundwahl-2014"}],"dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctCreator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dctContributor":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeOriginator":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Wahlamt Stadt  K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00319\/index.html"}]},{"@type":"dcat:Dataset","title":"Kommunalwahlbezirke K\u00f6ln","identifier":"4d668216-8a7e-4381-a8a2-c2891f716dbc","description":"\u003Cp\u003EEin Kommunalwahlbezirk ist die wahlorganisatorische Einheit, in der bei einer Kommunalwahl die Direktkandidaten gew\u00e4hlt werden. Zur Wahlorganisation werden diese weiter in Stimmbezirke eingeteilt, welchen bei einer Wahl ein Wahlraum zur Stimmabgabe an der Urne zugeteilt wird. Das Stadtgebiet von K\u00f6ln war ist in 45 Kommunalwahlbezirke aufgeteilt.\u003Cbr \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003Cbr \/\u003EKoordinatensystem\u00a0KMZ \u0026amp; JSON:\u00a0WGS 1984\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der\u00a0der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten\u00a0und\u00a0weitere Gebietsgliederungen\u00a0enth\u00e4lt der Datensatz\u00a0\u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-koeln\u0022\u003ERaumbezugssystem Geopackage\u003C\/a\u003E.\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Politik und Wahlen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/GOVE"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531615073402,51.083833406489],[6.853138701943,51.08374865003],[6.8530192616144,51.083191576022],[6.8530127925561,51.083136647774],[6.8529633120137,51.082718995879],[6.8529528497236,51.082630945111],[