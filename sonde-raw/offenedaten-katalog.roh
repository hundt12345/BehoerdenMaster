stribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"2013_2014_teilfinanzplan","dctModified":"2022-07-26T09:52:29+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EDer Rat hat die Haushaltssatzung und den Haushaltsplan der Stadt K\u00f6ln f\u00fcr die Jahre 2013\/2014 am 30. April 2013 beschlossen. Der Haushalt wurde am 9. September 2013 durch die Bezirksregierung genehmigt. Die hier abgebildeteten Werte k\u00f6nnen aufgrund von Rundungen geringf\u00fcgige Abweichungen zu den von der Stadt K\u00f6ln herausgebebenen Druckexemplaren des Haushaltsplans aufweisen. Eine rechtlich bindende Wirkung haben nur die Angaben in den Druckexemplaren.\u003C\/p\u003E","dctIssued":"2014-01-09T09:56:35+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/teilfinanzplan_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"K\u00e4mmerei Stadt K\u00f6ln","hasEmail":"mailto:kaemmerei@stadt-koeln.de"}],"dctIssued":"2012-09-25T12:09:08+00:00","dctModified":"2025-11-27T15:05:13+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00