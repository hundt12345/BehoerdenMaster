r \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003Cbr \/\u003EDas\u00a0\u003Ca href=\u0022https:\/\/offenedaten-koeln.de\/dataset\/koelner-strassenverzeichnis\u0022\u003E\u003Cstrong\u003EK\u00f6lner Stra\u00dfenverzeichnis\u003C\/strong\u003E\u003C\/a\u003E\u00a0gibt einen \u00dcberblick \u00fcber alle geltenden Stra\u00dfennamen und Adressen. Es wird etwa halbj\u00e4hrig und vor jeder Wahl aktualisiert\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der\u00a0der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten\u00a0und\u00a0weitere Gebietsgliederungen\u00a0enth\u00e4lt der Datensatz\u00a0\u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-koeln\u0022\u003ERaumbezugssystem Geopackage\u003C\/a\u003E..\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Transport und Verkehr"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084499590726],[6.8505460452948,51.084507508726],[6.8506453230344,51.0845239585],[6.853257265159,51.084176617619],[6.8532419471878,51.084121159895],[6.8532240779241,51.084059897535],[6.853199318367,51.08397379661],[6.8531908144781,51.083943284861],[6.8531