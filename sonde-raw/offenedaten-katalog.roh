03E\u003Cli\u003Est_length(shape)\u00a0( type: esriFieldTypeDouble, alias: st_length(shape))\u003C\/li\u003E\u003C\/ul\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/TRAN"}],"distribution":[{"type":"dcat:Distribution","title":"Gefahrgutstrecken K\u00f6ln","dctModified":"2022-07-26T11:23:57+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2021-09-08T10:49:38+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/verkehr\/gefahrgutstrecken\/MapServer\/1\/query?where=objectid+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=pjson","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Gefahrgutstrecken K\u00f6ln","dctModified":"2022-07-26T11:23:59+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/KMZ","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2021-09-08T10:50:43+00:00","downloadURL":"https:\/\/geoportal.stadt-koeln.de\/arcgis\/rest\/services\/verkehr\/gefahrgutstrecken\/MapServer\/1\/query?where=objectid+is+not+null\u0026amp;text=\u0026amp;objectIds=\u0026amp;time=\u0026amp;geometry=\u0026amp;geometryType=esriGeometryEnvelope\u0026amp;inSR=\u0026amp;spatialRel=esriSpatialRelIntersects\u0026amp;distance=\u0026amp;units=esriSRUnit_Foot\u0026amp;relationParam=\u0026amp;outFields=*\u0026amp;returnGeometry=true\u0026amp;returnTrueCurves=false\u0026amp;maxAllowableOffset=\u0026amp;geometryPrecision=\u0026amp;outSR=4326\u0026amp;havingClause=\u0026amp;returnIdsOnly=false\u0026amp;returnCountOnly=false\u0026amp;orderByFields=\u0026amp;groupByFieldsForStatistics=\u0026amp;outStatistics=\u0026amp;returnZ=false\u0026amp;returnM=false\u0026amp;gdbVersion=\u0026amp;historicMoment=\u0026amp;returnDistinctValues=false\u0026amp;resultOffset=\u0026amp;resultRecordCount=\u0026amp;returnExtentOnly=false\u0026amp;datumTransformation=\u0026amp;parameterValues=\u0026amp;rangeValues=\u0026amp;quantizationParameters=\u0026amp;featureEncoding=esriDefault\u0026amp;f=kmz","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Verkehrsmanagement","hasEmail":"mailto:verkehrsmanagement@stadt-koeln.de"}],"dctIssued":"2021-09-08T10:48:35+00:00","dctModified":"2025-11-19T10:31:00+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Verkehrsmanagement erstellt"}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Verkehrsmanagement","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr nachhaltige Mobilit\u00e4tsentwicklung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-verkehrsmanagement"}]},{"type":"dcat:Dataset","title":"Pappmache-Figuren aus Myanmar","identifier":"eed90338-35ba-4ea6-8447-81ae93918bf6","description":"\u003Cp\u003E\u201eDer Ruf der Eule\u201c \u2013 Pappmach\u00e9-Figuren aus Myanmar aus dem Rautenstrauch-Joest-Museum\u003C\/p\u003E\u003Cp\u003EDas Datenset besteht aus 10 Pappmach\u00e9-Figuren und 4 Holzmodel zur Herstellung von Pappmach\u00e9-Figuren aus der Sammlung des Rautenstrauch-Joest-Museum - Kulturen der Welt. Die Figuren wurden von St\u00e4nden rund um die Shwedagon-Pagode, Yangon (Myanmar), 2016 erworben.\u003Cbr \/\u003EDie Holzmodel stammen zwar aus einem anderen Sammlungskontext, geben aber eine Vorstellung, wie diese Figuren hergestellt werden.\u00a0\u003C\/p\u003E\u003Cp\u003EAn den vier Aufg\u00e4ngen zur Shwedagon-Pagode befinden sich zahlreiche H\u00e4ndler, die den Pilgern Essen und Erfrischungen anbieten und Andenken verkaufen:\u003C\/p\u003E\u003Cp\u003EDas Kunsthandwerk der Papiermach\u00e9-Hersteller in Pilgerorten lebt in gro\u00dfem Ma\u00dfe von der Souvenirproduktion. So finden sich an den meisten Pagoden in Myanmar H\u00e4ndler, die neben Opfergaben wie Blumen und R\u00e4ucherst\u00e4bchen auch Andenken verkaufen. Neben den traditionell aus Pappmach\u00e9 hergestellten und bemalten Spielzeugartikeln und Gl\u00fccksfiguren findet man immer h\u00e4ufiger Plastikimitate.\u003C\/p\u003E\u003Cp\u003EEulen sind besonders beliebt, denn der Ruf der Eule soll nicht nur Gl\u00fcck, sondern auch Wohlstand bringen. Sie werden zu Hause auf den Hausaltar gestellt \u2013 gerne eine weibliche und eine m\u00e4nnliche Eule als Paar. Bei der weiblichen Eule ist zumeist noch ein Kind mit angedeutet. Man kann auch nur eine Eule aufstellen, aber zwei sollen noch mehr Gl\u00fcck bringen.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"Pappmache-Figuren aus Myanmar","dctModified":"2025-09-24T09:46:41+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa\/4.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JPEG","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003ERautenstrauch-Joest-Museum, K\u00f6ln\u003C\/p\u003E\r\n","description":"\u003Cp\u003E\u201eDer Ruf der Eule\u201c \u2013 Pappmach\u00e9-Figuren aus Myanmar aus dem Rautenstrauch-Joest-Museum\u003C\/p\u003E","dctIssued":"2021-08-23T12:15:51+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/rrPZjYBzqgFT7Xo","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by-sa\/4.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Rautenstrauch-Joest-Museum K\u00f6ln","hasEmail":"mailto:rjm@stadt-koeln.de"}],"dctIssued":"2021-08-23T12:13:10+00:00","dctModified":"2025-11-09T10:53:51+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":" Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von dem Rautenstrauch-Joest-Museum K\u00f6ln erstellt"}],"dctCreator":[{"foaf_name":"Rautenstrauch-Joest-Museum K\u00f6ln","foaf_homepage":"https:\/\/museenkoeln.de\/rautenstrauch-joest-museum\/Startseite"}],"dctContributor":[{"foaf_name":"Rautenstrauch-Joest-Museum K\u00f6ln","foaf_homepage":"https:\/\/museenkoeln.de\/rautenstrauch-joest-museum\/Startseite"}],"dcatdeMaintainer":[{"foaf_name":"Rautenstrauch-Joest-Museum K\u00f6ln","foaf_homepage":"https:\/\/museenkoeln.de\/rautenstrauch-joest-museum\/Startseite"}]},{"type":"dcat:Dataset","title":"Joseph Johann Knippenberg Touristische Highlights des Mittelrheingebiets","identifier":"440ea34c-662a-49e3-9004-f4df8a9c3a9f","description":"\u003Cp\u003EJoseph Johann Knippenberg \u2013 Touristische Highlights des Mittelrheingebiets in den 1930er Jahren aus dem Rheinisches Bildarchiv der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003EDas Konvolut Joseph Johann Knippenberg umfasst 346 Glasnegative im Format 18 x 24 Zentimeter und circa 50 gro\u00dfformatige Abz\u00fcge mit Motiven vom Mittel- und Niederrhein. Der Nachlass gelangte 2018 als Schenkung seines Enkels Hans-Joseph Madest in den Besitz des Rheinischen Bildarchivs K\u00f6ln. Die Positive wurden leihweise zur Verf\u00fcgung gestellt und digitalisiert, um gemeinsam mit den Negativen der Nutzung und Erforschung dieses Fotografenbestands zur Verf\u00fcgung zu stehen.\u003C\/p\u003E\u003Cp\u003EIn Knippenbergs Heimatstadt Rees entstand neben klassischen Stadtansichten und Aufnahmen des Rheinufers auch eine Serie \u00fcber die Salmfischerei am Niederrhein. Reproduziert sind sie in dem 1988 in Kleve erschienen Buch von Werner B\u00f6cking: \u0022So fischte man am Niederrhein\u0022.\u003C\/p\u003E\u003Cp\u003ENach seinem Umzug nach Bacharach im Jahr 1935 entstanden Aufnahmen der touristischen Highlights des Mittelrheingebiets, doch die Gegend hatte Knippenberg schon zuvor erkundet: Von Burg Stahleck in Bacharach hat Knippenberg bereits um 1920 Aufnahmen gemacht, als die Burg noch eine Ruine war, dann hat er den Wiederaufbau in den 30er Jahren umfangreich dokumentiert. Klassiker der Rheinromantik, romantisierende Aufnahmen der Loreley und aus R\u00fcdesheim, Weinberge oder die fotogene Zollburg Pfalzgrafenstein, aber auch Bilder von Weinfesten erwiesen sich als erfolgreiche Postkartenmotive.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"Joseph Johann Knippenberg Touristische Highlights des Mittelrheingebiets ","dctModified":"2025-09-24T09:47:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa-de\/3.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JPEG","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003EFoto: Stadt K\u00f6ln, Rheinisches Bildarchiv, Johann Joseph Knippenberg, RBA-Nummer\u003C\/p\u003E\r\n","description":"\u003Cp\u003EJoseph Johann Knippenberg \u2013 Touristische Highlights des Mittelrheingebiets in den 1930er Jahren aus dem Rheinisches Bildarchiv der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E","dctIssued":"2021-08-23T12:11:08+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/Q3DiwZstwpWd8s8","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by-sa\/3.0\/de\/"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Metadaten Joseph Johann Knippenberg Touristische Highlights des Mittelrheingebiets","dctModified":"2021-08-27T08:57:24+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-zero","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"description":"\u003Cp\u003EMetadaten zu den Bilddatein\u003C\/p\u003E","dctIssued":"2021-08-27T08:57:24+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/idzk6wCjK76BYY3","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/publicdomain\/zero\/1.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Rheinisches Bildarchiv der Stadt K\u00f6ln","hasEmail":"mailto:rba@rbakoeln.de"}],"dctIssued":"2021-08-23T12:09:49+00:00","dctModified":"2025-11-19T10:15:39+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von dem Rheinisches Bildarchiv der Stadt K\u00f6ln erstellt"}],"dctCreator":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}],"dctContributor":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}]},{"type":"dcat:Dataset","title":" Fritz Zapp Stadtbildfotografien K\u00f6ln","identifier":"6211a723-c7f8-44ac-b3a2-8640fe18b9e6","description":"\u003Cp\u003EFritz Zapp Professionelle Architektur- und Stadtbildfotografien von K\u00f6ln 1910-1915 aus dem Rheinisches Bildarchiv der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003E\u00a0\u003C\/p\u003E\u003Cp\u003EFritz Zapp Professionelle Architektur- und Stadtbildfotografien von K\u00f6ln 1910-1915 aus dem Rheinisches Bildarchiv der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003EFritz Zapp wurde am 13. M\u00e4rz 1882 in Kleinbliersbach im Bergischen Land geboren. Er lernte und arbeitete zun\u00e4chst als Maler und Anstreicher, bevor er 1910 ins nahe gelegene Hoffnungsthal umzog. Dort er\u00f6ffnete er ein modernes Atelier f\u00fcr Fotografie und Malerei. Als er am 11. Februar 1960 verstarb, hinterlie\u00df er einen umfangreichen Komplex historischer Aufnahmen seiner unmittelbaren Umgebung. Etwa 8.000 Glasplatten, diverse Einzelbilder sowie Planfilme gelangten an den Geschichtsverein R\u00f6srath und wurden unter anderem 2007 unter dem Titel \u0022Vor 100 Jahren... R\u00f6srath, Hoffnungsthal und Forsbach im Blick des Fotografen Fritz Zapp, mit Ausfl\u00fcgen nach K\u00f6ln und ins Bergische Land\u0022 publiziert.\u003C\/p\u003E\u003Cp\u003EIm gleichen Jahr erwarb das Rheinische Bildarchiv ein kleines Konvolut von 164 Glasnegativen in den Formaten 13 mal 18 Zentimeter und 18 mal 24 Zentimeter samt deren Rechte. Die Aufnahmen entstanden zwischen 1910 und 1915 und dokumentieren vor allem die im Bombenhagel des Zweiten Weltkriegs untergegangenen Gr\u00fcnderzeitarchitekturen der Rheinmetropole K\u00f6ln.\u003C\/p\u003E\u003Cp\u003EStra\u00dfenansichten, Wohn- und Gesch\u00e4ftsbauten entlang der neu angelegten Ringe und aus den neu erbauten Vorst\u00e4dten wie Neuehrenfeld geh\u00f6rten zu den bevorzugten Motiven des Autodidakten Zapp. Doch auch repr\u00e4sentative Kirchenbauten der Altstadt wurden von ihm fotografiert.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"Fritz Zapp Stadtbildfotografien von K\u00f6ln","dctModified":"2025-09-24T09:48:37+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa-de\/3.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JPEG","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003EFoto: Stadt K\u00f6ln, Rheinisches Bildarchiv, Fritz Zapp, RBA-Nummer\u003C\/p\u003E\r\n","description":"\u003Cp\u003EFritz Zapp Professionelle Architektur- und Stadtbildfotografien von K\u00f6ln 1910-1915 aus dem Rheinisches Bildarchiv der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003E\u0026nbsp;\u003C\/p\u003E","dctIssued":"2021-08-23T12:07:23+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/bdNBnPFKgkXdJpp","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by-sa\/3.0\/de\/"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Metadaten Fritz Zapp Stadtbildfotografien von K\u00f6ln","dctModified":"2021-08-27T08:56:09+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-zero","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JSON","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"description":"\u003Cp\u003EMetadaten zu den Bilddatein\u0026nbsp;\u003C\/p\u003E","dctIssued":"2021-08-27T08:56:09+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/idzk6wCjK76BYY3","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/publicdomain\/zero\/1.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Rheinisches Bildarchiv der Stadt K\u00f6ln","hasEmail":"mailto:rba@rbakoeln.de"}],"dctIssued":"2021-08-23T12:05:14+00:00","dctModified":"2025-11-19T10:19:08+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von dem Rheinisches Bildarchiv der Stadt K\u00f6ln erstellt"}],"dctCreator":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}],"dctContributor":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Rheinisches Bildarchiv der Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/leben-in-koeln\/kultur\/rheinisches-bildarchiv\/index.html"}]},{"type":"dcat:Dataset","title":"Mosaik Stadtvilla des r\u00f6mischen K\u00f6ln","identifier":"791848d0-531f-4123-b40a-702f7ad280a9","description":"\u003Cp\u003EDas Mosaik in einer luxuri\u00f6sen Stadtvilla des r\u00f6mischen K\u00f6ln aus dem R\u00f6misch-Germanisches Museum der Stadt K\u00f6ln\u003C\/p\u003E\u003Cp\u003EIm Schatten des Domes, im Herzen K\u00f6lns, unter den Augen von Millionen Besuchern, am originalen Standort liegt es \u2013 das Dionysos-Mosaik. Dieser 70m\u00b2 gro\u00dfe, prachtvolle Fu\u00dfboden schm\u00fcckte den Festsaal einer Villa im r\u00f6mischen K\u00f6ln.\u003C\/p\u003E\u003Cp\u003EDer Weingott Dionysos feiert hier mit seinem Gefolge: Satyrn und M\u00e4naden spielen Musik \u2013 Fl\u00f6te, Tambourin oder die Leier \u2013 und sie tanzen ausgelassen dazu. Auch Tiere, wie Enten, Papageien und ein Pfau begleiten das festliche Treiben. Wohlschmeckende Austern liegen bereit und die K\u00f6rbe biegen sich unter den Kirschen.\u003C\/p\u003E\u003Cp\u003EMan w\u00fcrde zu gerne wissen, was sich hier vor 2000 Jahren alles abgespielt hat \u2013 die Figuren vom Mosaik k\u00f6nnten da bestimmt einiges\u00a0erz\u00e4hlen. Wenn man sie doch nur zum Leben erwecken k\u00f6nnte.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"Mosaik Stadtvilla des r\u00f6mischen K\u00f6ln ","dctModified":"2025-09-24T09:49:41+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa-de\/3.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JPEG","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003ERheinisches Bildarchiv K\u00f6ln \/ R\u00f6misch Germanisches Museum K\u00f6ln \/ [Fotograf*in] (CC BY-SA 3.0)\u003C\/p\u003E\r\n","dctIssued":"2021-08-23T12:01:52+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/7oHgapDbriFBXXW","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by-sa\/3.0\/de\/"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"R\u00f6misch Germanisches Museum K\u00f6ln","hasEmail":"mailto:roemisch-germanisches-museum@stadt-koeln.de"}],"dctIssued":"2021-08-23T11:58:36+00:00","dctModified":"2025-11-19T10:21:44+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom R\u00f6misch Germanisches Museum K\u00f6ln erstellt"}],"dctCreator":[{"foaf_name":"R\u00f6misch Germanisches Museum K\u00f6ln","foaf_homepage":"https:\/\/roemisch-germanisches-museum.de\/Startseite"}],"dctContributor":[{"foaf_name":"R\u00f6misch Germanisches Museum K\u00f6ln","foaf_homepage":"https:\/\/roemisch-germanisches-museum.de\/Startseite"}],"dcatdeMaintainer":[{"foaf_name":"R\u00f6misch Germanisches Museum K\u00f6ln","foaf_homepage":"https:\/\/roemisch-germanisches-museum.de\/Startseite"}]},{"type":"dcat:Dataset","title":"Historische K\u00f6lner Stadtkarte Arch\u00e4ologische Zone K\u00f6ln","identifier":"8d8b9fd2-dd2d-4e7a-98bd-9daaa6209d57","description":"\u003Cp\u003EDie Arch\u00e4ologische Zone gr\u00e4bt und forscht seit Jahrzehnten im Herzen der Stadt K\u00f6ln. Unsere Forschungen werden zumeist von historischen Karten begleitet, wobei wir mit diversen Institutionen zusammen arbeiten, wie zum Beispiel mit dem Katasteramt und dem Historischen Archiv der Stadt K\u00f6ln.\u00a0\u003C\/p\u003E\u003Cp\u003EHier pr\u00e4sentieren wir eine digitalisierte historische Kartensammlung, die eine Zeitreise vom 17. Jahrhundert bis in die 1960er-Jahre bietet. Das Dataset besteht aus 30 georeferenzierten K\u00f6lner Stadtkarten und beinhaltet Kataster-, Flur- und \u00dcbersichtskarten. Alle Materialien sind georeferenziert und als GeoTiff bereitgestellt.\u003C\/p\u003E\u003Cp\u003EAusf\u00fchrliche Informationen zu den Kartenmaterialien, wie Hersteller, Datum, Farbe, Ma\u00dfst\u00e4be etc., befinden sich in den Metadaten.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"Historische K\u00f6lner Stadtkarte Arch\u00e4ologische Zone K\u00f6ln","dctModified":"2022-07-13T07:59:44+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa\/4.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/TIFF","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003E\u0026lt;p\u0026gt;\u00a9\u0026amp;nbsp; Stadt K\u00f6ln \u2502 Druck: Amt f\u00fcr Liegenschaften, Vermessung und Kataster \u2502 Historisches Archiv: ....\u0026lt;\/p\u0026gt;\u003C\/p\u003E\r\n","dctIssued":"2021-08-23T11:53:28+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/9GP4CBcpsnERtg9","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/creativecommons.org\/licenses\/by-sa\/4.0\/deed.de"},"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster Stadt K\u00f6ln, Arch\u00e4ologischen Zone K\u00f6ln","hasEmail":"mailto:liegenschaften-vermessung-kataster@stadt-koeln.de"}],"dctIssued":"2021-08-23T11:48:10+00:00","dctModified":"2025-11-19T10:23:35+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Arch\u00e4ologischen Zone - J\u00fcdisches Museum K\u00f6ln erstellt"}],"dctCreator":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00070\/index.html"},{"foaf_name":"Arch\u00e4ologischen Zone - J\u00fcdisches Museum K\u00f6ln","foaf_homepage":"http:\/\/www.museenkoeln.de\/archaeologische-zone\/"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00070\/index.html"},{"foaf_name":"Arch\u00e4ologischen Zone - J\u00fcdisches Museum K\u00f6ln","foaf_homepage":"http:\/\/www.museenkoeln.de\/archaeologische-zone\/"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00070\/index.html"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Liegenschaften, Vermessung und Kataster","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/00070\/index.html"},{"foaf_name":"Arch\u00e4ologischen Zone - J\u00fcdisches Museum K\u00f6ln","foaf_homepage":"http:\/\/www.museenkoeln.de\/archaeologische-zone\/"}]},{"type":"dcat:Dataset","title":"Schmuckobjekte Museum f\u00fcr Angewandte Kunst K\u00f6ln","identifier":"008ed2c2-9694-4347-9399-d9be32217740","description":"\u003Cp\u003EDas MAKK bewahrt eine \u00fcberaus reiche Schmucksammlung, die mehr als 1.500 Objekte von der Antike bis zur Gegenwart umfasst und nicht nur inhaltlich ein breites Spektrum abdeckt, sondern auch Werke von zum Teil sehr hoher k\u00fcnstlerischer sowie handwerklicher Qualit\u00e4t enth\u00e4lt.\u003Cbr \/\u003EDie Sammlung ist zu gro\u00dfen Teilen das Ergebnis gro\u00dfz\u00fcgiger privater Stiftungen und hat ihre Schwerpunkte in der Zeit des Mittelalters, der Renaissance und des 19. Jahrhunderts. Aber auch bedeutende Werke des 20. und 21. Jahrhunderts sind vertreten.\u003C\/p\u003E\u003Cp\u003EDas Datenset umfasst zu 53 Objekten aus der Schmucksammlung die Metadaten\/Objektinformationen in Excel und csv sowie zugeh\u00f6riges Bildmaterial (jpg) welches im Rahmen des Coding da Vinci Hackathons Nieder.Rhein.Land 2021 als Open Data zur Verf\u00fcgung gestellt wird.\u00a0\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Kultur","Freizeit","Sport und Tourismus"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/EDUC"}],"distribution":[{"type":"dcat:Distribution","title":"MAKK - Schmuckobjekte","dctModified":"2025-09-24T09:49:03+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/cc-by-sa\/4.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/JPEG","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/AVAILABLE"},"dcatde_licenseAttributionByText":"\u003Cp\u003EDetlefSchumacher.com \/ CC BY-SA 4.0\u003C\/p\u003E\r\n","description":"\u003Cp\u003EDas Datenset umfasst zu 53 Objekten aus der Schmucksammlung die Metadaten\/Objektinformationen in Excel und csv sowie zugeh\u00f6riges Bildmaterial (jpg).\u0026nbsp;\u003C\/p\u003E","dctIssued":"2021-08-23T11:40:29+00:00","downloadURL":"https:\/\/download.codingdavinci.de\/s\/KKtEgejYF3AsykM","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPa