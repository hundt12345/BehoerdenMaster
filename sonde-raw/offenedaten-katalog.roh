unentbehrliche\u003Cbr \/\u003E\nGrundlage f\u00fcr zahlreiche Entscheidungen auf dem Gebiet der\u003Cbr \/\u003E\ngesamten Wirtschaftspolitik, insbesondere der Baupolitik.\u003C\/p\u003E\n","keyword":["Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Betriebe, Besch\u00e4ftigte, geleistete Arbeitsstunden, Entgelte und Ausbaugewerblicher Umsatz XML","dctModified":"2025-11-17T12:57:33+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-18T08:27:57+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=44131-01i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebe, Besch\u00e4ftigte, geleistete Arbeitsstunden, Entgelte und Ausbaugewerblicher Umsatz CSV","dctModified":"2025-11-17T12:57:02+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-18T08:28:26+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=44131-01i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Betriebe, Besch\u00e4ftigte, geleistete Arbeitsstunden, Entgelte und Ausbaugewerblicher Umsatz XLSX","dctModified":"2025-11-17T12:57:17+00:00","dct_license":"http:\/