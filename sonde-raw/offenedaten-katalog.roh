27+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2025-11-25T11:13:27+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-0110i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Abh\u00e4ngig Erwerbst\u00e4tige nach Art des Arbeitsvertrages, Grund der Befristung, Geschlecht und Alter XLSX","dctModified":"2025-11-25T11:44:51+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2025-11-25T11:14:43+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-0110i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Abh\u00e4ngig Erwerbst\u00e4tige nach Art des Arbeitsvertrages, Grund der Befristung, Geschlecht und Alter XML","dctModified":"2025-11-25T11:15:58+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2025-11-25T11:15:58+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=12211-0110i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["12211-0110i"],"adms:Identifier":[{"title":"12211-0110i"}],"dctIssued":"2025-11-25T12:10:16+01:00","dctModified":"2025-11-27T15:52:15+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"fdb34c9a-cf87-43a8-818f-2c9539d3d2c3","title":"Meldeeimer - un:box Zyklus 1 ","description":"\u003Cp\u003EGemeldete M\u00fclleimer im Projekt Meldeeimer, welches durch un:box cologne gef\u00f6rdert wurde. Bot die M\u00f6glichkeit volle M\u00fclleimer mittels eines QR-Codes zu melden, sodass diese zeitnah geleert werden k\u00f6nnen.\u003Cbr \/\u003E\nDaten werden im folgenden Format dargestellt: Timestamp; M\u00fclleimer_id; Longitude; Latitude; F\u00fcr weitere Informationen siehe \u003Ca href=\u0022https:\/\/meinungfuer.koeln\/node\/18705\u0022\u003Ehttps:\/\/meinungfuer.koeln\/node\/18705\u003C\/a\u003E\u003C\/p\u003E\n","keyword":["Geo"],"temporalmigrate":{"type":"dct:PeriodOfTime"},"distribution":[{"type":"dcat:Distribution","title":"Meldeeimer - Meldungen im Projektzeitraum 2024","dctModified":"2025-11-10T08:38:14+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2025-10-28T11:20:35+00:00","dcatde_licenseAttributionByText":"\u003Cp\u003EMeldeeimer.de\u003C\/p\u003E\n","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/meldeeimer_meldungen.csv","dctLanguage":{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/by-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"dctIssued":"2025-10-28T12:00:00+01:00","dctModified":"2025-11-17T12:52:57+01:00"},{"type":"dcat:Dataset","title":"Zentrale Versorgungsbereiche K\u00f6ln","identifier":"1a282484-c65d-466b-bae8-a1720cc9084e","description":"\u003Cp\u003EDer Datensatz enth\u00e4lt Informationen zu den zentralen Versorgungsbereichen (ZVB) der Stadt K\u00f6ln zum Stichtag 09.02.2023, die gem\u00e4\u00df des Einzelhandels- und Zentrenkonzepts K\u00f6ln (EHZK) vom Rat der Stadt K\u00f6ln festgelegt wurden. Die ZVB sind r\u00e4umlich abgegrenzte Bereiche, die sich durch die Konzentration von Einzelhandelsnutzungen auszeichnen und meist durch Dienstleistungen und gastronomische Angebote erg\u00e4nzt werden. Insgesamt gibt es 80 ZVB in K\u00f6ln, diese sind in einer vierstufigen Zentrenstruktur kategorisiert: City, Bezirks(teil)zentren, Stadtteilzentren und Nahversorgungszentren. Abh\u00e4ngig von der Kategorisierung \u00fcbernimmt ein ZVB die Versorgungsfunktion f\u00fcr die Gesamtstadt bis hin zum Stadtviertel. Neben den bereits vorhandenen (faktischen) ZVB gibt es noch geplante ZVB. Dabei handelt es sich um ZVB, die in neu entstehenden Stadtquartieren wie dem Deutzer Hafen, Kreuzfeld oder der Parkstadt S\u00fcd von vorne herein mitgeplant werden.\u003Cbr \/\u003EUm die ZVB werden 700 m-Radien gezogen, die schematisch den Einzugsbereich der ZVB darstellen, in dem eine fu\u00dfl\u00e4ufige Versorgung der Wohnbev\u00f6lkerung durch den jeweiligen ZVB sichergestellt werden kann. Bei den Nahversorgungslagen und den Sonderstandorten handelt es sich nicht um ZVB, daher sind dort keine Radien dargestellt.\u003Cbr \/\u003EWeitere Informationen zum EHZK und zu den ZVB finden sich hier: \u003Ca href=\u0022http:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/stadtentwicklung\/einzelhandel-geschaeftszentren\/fortschreibung-des-einzelhandels-zentrenkonzeptes\u0022\u003Ehttps:\/\/www.stadt-koeln.de\/politik-und-verwaltung\/stadtentwicklung\/einzelhandel-geschaeftszentren\/fortschreibung-des-einzelhandels-zentrenkonzeptes\u003C\/a\u003E\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Bev\u00f6lkerung","Geo","Infrastruktur","Bauen und Wohnen","Wirtschaft und Arbeit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/SOCI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/ECON"}],"distribution":[{"type":"dcat:Distribution","title":"Zentrale Versorgungsbereiche Shapefile","dctModified":"2025-10-14T14:14:56+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/ZIP","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"description":"\u003Cp\u003EStand: 21.07.2025\u003C\/p\u003E","dctIssued":"2025-07-21T08:16:56+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/Zentrale_Versorgungsbereiche.zip","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"700 m Radien um ZVB Shapefile","dctModified":"2025-10-14T14:15:55+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/public