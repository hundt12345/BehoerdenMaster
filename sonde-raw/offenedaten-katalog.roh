ms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Standorttabelle k03","dctModified":"2023-07-19T12:11:31+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2023-06-22T11:22:22+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/k-loc-03_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"},{"type":"dcat:Distribution","title":"Standorttabelle k04","dctModified":"2023-07-19T12:13:40+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-zero-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dcatapAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctIssued":"2023-06-22T11:24:03+00:00","downloadURL":"https:\/\/www.offenedaten-koeln.de\/sites\/default\/files\/distribution\/k-loc-04_0.csv","dctLanguage":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"},"foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement","rdf_resource":"https:\/\/www.govdata.de\/dl-de\/zero-2-0"},"dctConformsTo":[{"dct_Standard":"https:\/\/www.dcat-ap.de\/def\/dcatde\/1.1\/spec\/specification.pdf"}],"adms_status":"http:\/\/publications.europa.eu\/resource\/authority\/distribution-status\/COMPLETED"}],"contactPoint":[{"type":"vcard:Contact","fn":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","hasEmail":"mailto:ordnungsamt@stadt-koeln.de"}],"dctIssued":"2022-08-12T10:05:37+00:00","dctModified":"2025-11-19T10:18:19+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde von der Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/ANNUAL"},"dctCreator":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr \u00f6ffentliche Ordnung Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-oeffentliche-ordnung"}]},{"type":"dcat:Dataset","title":"Planungshinweiskarte Hitze K\u00f6ln","identifier":"ea47662e-444e-470d-b9a0-ff50e4493864","description":"\u003Cp\u003EDie Planungshinweiskarte Hitze ist eine Klimaanalysekarte, welche die zuk\u00fcnftig zu erwartenden stadtklimatischen Gegebenheiten in K\u00f6ln als fl\u00e4chenhafte \u00dcbersicht darstellt.\u003C\/p\u003E\u003Cp\u003EDie Ausweisung der klimatisch aktiven Fl\u00e4chen ist nicht parzellenscharf und es bedarf bei gro\u00dfma\u00dfst\u00e4bigen Planungen (z.B. Bebauungspl\u00e4nen) einer zus\u00e4tzlichen Auswertung der Grundlagendaten auf Detailebene.\u003C\/p\u003E\u003Cp\u003EGrundlage f\u00fcr die Karte sind die Berechnungen der Anzahl der hei\u00dfen Tage f\u00fcr die Periode 2021 bis 2050, die der Deutsche Wetterdienst mit dem Stadtklimamodell MUKLIMO_3 simuliert hat. Zur Erstellung der Karte wurde die MUKLIMO-3 Simulation basierend auf dem Regionalmodell CLM mit dem Emissionsszenario A1B ausgew\u00e4hlt. F\u00fcr den Zeitraum 2021 bis 2050 zeigt sich im Vergleich mit dem Referenzzeitraum (1971 bis 2000) eine deutliche Zunahme der Hitzebelastung. F\u00fcr die Stadt K\u00f6ln bedeutet dies, dass l\u00e4ngere Hitzeperioden mit Temperaturen \u00fcber 25\u00b0C (Sommertage) und \u00fcber 30\u00b0C (hei\u00dfe Tage) vermehrt auftreten. Die Trinkbrunnen sind als Punktmarkierungen in der Karte dargestellt, die interaktiv angeklickt oder unten in der Detailansicht angeschaut werden k\u00f6nnen.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"datasetseries":{"title":"Planungshinweiskarten"},"keyword":["Geo","Gesundheit"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/HEAL"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"},{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/ENVI"}],"dcatAvailability":{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/planned-availability\/STABLE"},"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.084262631884],[6.8497309347004,51.084372846592],[6.8502763386469,51.084463078724],[6.8504970547784,51.084