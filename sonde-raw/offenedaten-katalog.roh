t\/adressen-koeln"}],"dcatLandingPage":[],"foafPage":[],"dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctConformsTo":[],"dctProvenance":[{"dct_ProvenanceStatement":"Die Zusammenstellung und Erstbeschreibung dieses Datensatzes wurde vom Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln erstellt."}],"dctAccrualPeriodicity":{"dct_Frequency":"http:\/\/publications.europa.eu\/resource\/authority\/frequency\/IRREG"},"provWasGeneratedBy":[],"provQualifiedAttribution":[],"dcatQualifiedRelation":[],"dctIsReferencedBy":[],"dctReferences":[],"dcathasVersion":[],"admsSample":[],"dctCreator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"@type":"dcat:Dataset","title":"Blockseiten K\u00f6ln","identifier":"0ac5d9f4-0d56-4cef-a0d0-f520666c4ace","description":"\u003Cp\u003EEine Blockseite ist Teil der Kommunalen Gebietsgliederung. Dieses hierarchische System gliedert das K\u00f6lner Stadtgebiet auf verschiedenen Ebenen in eine Stadtstruktur und Blockstruktur. Weitere Bestandteile sind eine Stra\u00dfenstruktur und Adressen.\u00a0Die gesamte Kommunale Gebietsgliederung wird in dieser \u003Ca href=\u0022https:\/\/www.stadt-koeln.de\/mediaasset\/content\/pdf15\/statistiksonstige\/die_kommunale_gebietsgliederung.pdf\u0022\u003EVer\u00f6ffentlichung\u003C\/a\u003E erl\u00e4utert.\u003Cbr \/\u003EDefinition: Eine Blockseite ist Teil eines Blocks und eindeutig einem Stra\u00dfenabschnitt zugeordnet. Sie bezeichnet das Gebiet, in dem sich bebaute Grundst\u00fccke mit Adressen zu diesem Stra\u00dfenabschnitt befinden oder unbebaute Grundst\u00fccke, von denen zu erwarten ist, dass Neubauten dieser Stra\u00dfe zugeordnet werden. Die Blockseite hat immer mindestens einen Blockabschnitt.\u003Cbr \/\u003EErl\u00e4uterung der Attribute ist dem Shapefile als CSV beigef\u00fcgt.\u003Cbr \/\u003EKoordinatensystem Shapefile: ETRS 1989 UTM Zone 32N\u003C\/p\u003E\u003Cp\u003EAlle Geodaten der der Kommunalen Gebietsgliederung, wahlorganisatorische Einheiten und weitere Gebietsgliederungen enth\u00e4lt der Datensatz \u003Ca href=\u0022https:\/\/www.offenedaten-koeln.de\/dataset\/geopackage-raumbezugssystem-k%C3%B6ln\u0022\u003ERaumbezugssystem Geopackage\u003C\/a\u003E.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Stadt K\u00f6ln"},"keyword":["Geo","Infrastruktur","Bauen und Wohnen"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"dcattheme":[{"rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/data-theme\/REGI"}],"dctSpatial":["{\u0022type\u0022:\u0022Polygon\u0022,\u0022coordinates\u0022:[[[6.8486623512073,51.084446701176],[6.8487255830128,51.084198891684],[6.8488410005665,51.084220389694],[6.8489472868403,51.08424053054],[6.8490641744889,51.0842626318