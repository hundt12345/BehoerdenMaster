:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"type":"dcat:Dataset","title":"Allgemeinbildende Schulen: Klassenwiederholerinnen und Klassenwiederholer nach Jahrgang, Schulform, Geschlecht und Nationalit\u00e4t","identifier":"f4218095-1b54-4b70-999b-e16520fcbf2a","description":"\u003Cp\u003EAllgemeinbildende Schulen: Klassenwiederholerinnen und Klassenwiederholer nach Jahrgang, Schulform, Geschlecht und Nationalit\u00e4t.\u003C\/p\u003E\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=21111-131is\u0026amp;zeitscheiben=10\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=2...\u003C\/a\u003E\u003C\/p\u003E\u003Cp\u003E\u003Cstrong\u003EKurzbeschreibung\u003C\/strong\u003E\u003C\/p\u003E\u003Cp\u003EDie Statistik der allgemeinbildenden Schulen gibt Auskunft\u003Cbr \/\u003E\u00fcber das Schulwesen an den allgemeinbildenden Schulen in\u003Cbr \/\u003ENRW in der bundesweit einheitlichen und vergleichbaren\u003Cbr \/\u003EZuordnung. Neben den Daten zu Schulen, Sch\u00fclerinnen und\u003Cbr \/\u003ESch\u00fclern, Lehrkr\u00e4ften sowie Unterricht, die j\u00e4hrlich zu\u003Cbr \/\u003ESchuljahresbeginn erhoben werden, werden auch Indikatoren\u003Cbr \/\u003Eund deren Berechnungsweise dargestellt. Die Datenbereit-\u003Cbr \/\u003Estellung erfolgt \u00fcber die Schulen in NRW.\u003Cbr \/\u003ER\u00e4umlich differenziert sind die Daten bis auf die Ebene der\u003Cbr \/\u003EGemeinden.\u003C\/p\u003E\u003Cp\u003ENach dem Schulformkonzept: Alle Bildungsg\u00e4nge werden unter\u003Cbr \/\u003Eder Leitschulform der Schule berichtet, auch wenn sie vom\u003Cbr \/\u003EBildungsgang der Leitschulform abweichen (z. B. bei\u003C\/p\u003E\u003Cp\u003EVerbundschulen oder bei Sekundarschulen mit auslaufenden\u003Cbr \/\u003EHaupt- und Realschulbildungsg\u00e4ngen).\u003C\/p\u003E\u003Cp\u003ENach dem Stammschulkonzept: An mehreren Schulen t\u00e4tige\u003Cbr \/\u003ELehrkr\u00e4fte werden nur an der Stammschule gez\u00e4hlt, auch wenn\u003Cbr \/\u003Ediese ganz an einer anderen Schule t\u00e4tig sind.\u003C\/p\u003E\u003Cp\u003EGeschlecht: Beinhaltet Sch\u00fcler\/-innen mit den Geschlechtern\u003Cbr \/\u003Eweiblich, m\u00e4nnlich, divers und ohne Angabe (im\u003Cbr \/\u003EGeburtenregister). Unter weiblich werden die tats\u00e4chlich\u003Cbr \/\u003Eweiblichen Sch\u00fclerinnen ausgewiesen.\u003C\/p\u003E","publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"keyword":["Bev\u00f6lkerung","Bildung und Wissenschaft"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"distribution":[{"type":"dcat:Distribution","title":"Klassenwiederholerinnen und Klassenwiederholer nach Jahrgang, Schulform, Geschlecht und Nationalit\u00e4t XML","dctModified":"2025-11-12T13:01:30+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-06-04T08:45:40+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=21111-131i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}},{"type":"dcat:Distribution","title":"Klassenwiederholerinnen und Klassenwiederholer nach Jahrgang, Schulform, Geschlecht und Nationalit\u00e4t CSV","dctModified":"2025-11-12T13:00:06+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-06-04T08:46:10+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=21111-131i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}},{"type":"dcat:Distribution","title":"Klassenwiederholerinnen und Klassenwiederholer nach Jahrgang, Schulform, Geschlecht und Nationalit\u00e4t XLSX","dctModified":"2025-11-12T13:00:28+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-06-04T08:46:41+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=21111-131i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*","foafPage":{"type":"foaf:page"},"dct_rights":{"type":"dct:RightsStatement"}}],"contactPoint":[{"type":"vcard:Contact","fn":"Landesdatenbank NRW","hasEmail":"mailto:statistik-info@it.nrw.de"}],"admsIdentifier":["21111-131is"],"dctIssued":"2024-06-04T08:45:03+00:00","dctModified":"2025-11-27T14:51:57+00:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"ea6ba021-6708-4e1a-8351-e57184b8af32","title":"Tag- und Nachtbev\u00f6lkerung (Bev\u00f6lkerung, Erwerbst\u00e4tige, Einpendler, innergemeindliche Pendler, Auspendler) - Stichtag (2020)","description":"\u003Cp\u003ETag- und Nachtbev\u00f6lkerung (Bev\u00f6lkerung, Erwerbst\u00e4tige, Einpendler, innergemeindliche Pendler, Auspendler) - Stichtag (2020).\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=19321-051i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EBeschreibung der Statistik:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Pendlerrechnung der L\u00e4nder ermittelt die erwerbsbedingte\u003Cbr \/\u003E\npotentielle Mobilit\u00e4t von Personen, die im Bundesgebiet\u003Cbr \/\u003E\narbeiten und\/oder wohnen. Dargestellt werden die\u003Cbr \/\u003E\nerwerbsbedingten potentiellen Mobilit\u00e4tsstr\u00f6me,\u003Cbr \/\u003E\nverschiedene soziodemografische Merkmale (Alter, Stellung\u003Cbr \/\u003E\nim Beruf, Arbeitsumfang, Wirtschaftsbereiche) der\u003Cbr \/\u003E\nPendelnden und allgemeine Informationen wie Pendelquoten\u003Cbr \/\u003E\nund -salden.\u003C\/p\u003E\n\u003Cp\u003EDie Pendlerrechnung der L\u00e4nder basiert auf Auswertungen von\u003Cbr \/\u003E\nAngaben des Wohn- und Arbeitsorts und stellt daher die\u003Cbr \/\u003E\npotentielle Mobilit\u00e4t dar. Der Weg vom Wohn- zum\u003Cbr \/\u003E\nArbeitsort muss nicht zwangsl\u00e4ufig t\u00e4glich, sondern k\u00f6nnte\u003Cbr \/\u003E\nbeispielsweise an einzelnen Wochentagen oder nur\u003Cbr \/\u003E\nwochenweise zur\u00fcckgelegt werden.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Tag- und Nachtbev\u00f6lkerung (Bev\u00f6lkerung, Erwerbst\u00e4tige, Einpendler, innergemeindliche Pendler, Auspendler) XML","dctModified":"2025-11-10T13:58:26+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-31T12:08:34+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=19321-051i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Tag- und Nachtbev\u00f6lkerung (Bev\u00f6lkerung, Erwerbst\u00e4tige, Einpendler, innergemeindliche Pendler, Auspendler) CSV","dctModified":"2025-11-10T13:57:56+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/CSV","dctIssued":"2024-05-31T12:09:27+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=19321-051i\u0026amp;option=csv\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Tag- und Nachtbev\u00f6lkerung (Bev\u00f6lkerung, Erwerbst\u00e4tige, Einpendler, innergemeindliche Pendler, Auspendler) XLSX","dctModified":"2025-11-10T13:58:13+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XLSX","dctIssued":"2024-05-31T12:09:56+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=19321-051i\u0026amp;option=xlsx\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"}],"admsIdentifier":["19321-051i"],"adms:Identifier":[{"title":"19321-051i"}],"dctIssued":"2024-05-31T14:07:16+02:00","dctModified":"2025-11-27T15:54:15+01:00","dctLanguage":[{"type":"dct:LinguisticSystem","rdf_resource":"http:\/\/publications.europa.eu\/resource\/authority\/language\/DEU"}],"dctCreator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dctContributor":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeOriginator":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}],"dcatdeMaintainer":[{"foaf_name":"Landesdatenbank NRW","foaf_homepage":"https:\/\/www.landesdatenbank.nrw.de"}]},{"identifier":"b29291fe-107a-4bc5-a0fd-4286c3f3695e","title":"Innergemeindliche Berufspendler nach Geschlecht und Entfernung - Stichtag (2020)","description":"\u003Cp\u003EInnergemeindliche Berufspendler nach Geschlecht und Entfernung - Stichtag (2020).\u003C\/p\u003E\n\u003Cp\u003EAbruf der Tabelle von der Landesdatenbank Nordrhein-Westfalen:\u003Cbr \/\u003E\n\u003Ca href=\u0022https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=19321-050i\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*\u0022\u003Ehttps:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=result\u0026amp;code=1...\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EBeschreibung der Statistik:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EDie Pendlerrechnung der L\u00e4nder ermittelt die erwerbsbedingte\u003Cbr \/\u003E\npotentielle Mobilit\u00e4t von Personen, die im Bundesgebiet\u003Cbr \/\u003E\narbeiten und\/oder wohnen. Dargestellt werden die\u003Cbr \/\u003E\nerwerbsbedingten potentiellen Mobilit\u00e4tsstr\u00f6me,\u003Cbr \/\u003E\nverschiedene soziodemografische Merkmale (Alter, Stellung\u003Cbr \/\u003E\nim Beruf, Arbeitsumfang, Wirtschaftsbereiche) der\u003Cbr \/\u003E\nPendelnden und allgemeine Informationen wie Pendelquoten\u003Cbr \/\u003E\nund -salden.\u003C\/p\u003E\n\u003Cp\u003EDie Pendlerrechnung der L\u00e4nder basiert auf Auswertungen von\u003Cbr \/\u003E\nAngaben des Wohn- und Arbeitsorts und stellt daher die\u003Cbr \/\u003E\npotentielle Mobilit\u00e4t dar. Der Weg vom Wohn- zum\u003Cbr \/\u003E\nArbeitsort muss nicht zwangsl\u00e4ufig t\u00e4glich, sondern k\u00f6nnte\u003Cbr \/\u003E\nbeispielsweise an einzelnen Wochentagen oder nur\u003Cbr \/\u003E\nwochenweise zur\u00fcckgelegt werden.\u003C\/p\u003E\n","keyword":["Bev\u00f6lkerung","Bildung und Wissenschaft"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Landesdatenbank NRW","hasEmail":"statistik-info@it.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Landesdatenbank NRW"},"distribution":[{"type":"dcat:Distribution","title":"Innergemeindliche Berufspendler nach Geschlecht und Entfernung XML","dctModified":"2025-11-10T13:48:08+00:00","dct_license":"http:\/\/dcat-ap.de\/def\/licenses\/dl-by-de\/2.0","dct_format":"http:\/\/publications.europa.eu\/resource\/authority\/file-type\/XML","dctIssued":"2024-05-31T11:46:18+00:00","downloadURL":"https:\/\/www.landesdatenbank.nrw.de\/ldbnrw\/online?operation=download\u0026amp;code=19321-050i\u0026amp;option=xml\u0026amp;zeitscheiben=50\u0026amp;regionalschluessel=05315*"},{"type":"dcat:Distribution","title":"Innergemeindliche Berufspendler nach Geschlecht und Entfernung CSV","dctModified":"2025-11-10T13:46:21+00:00","dct_license":"http: