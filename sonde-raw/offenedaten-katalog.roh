w.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dctContributor":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Raumbezogene Statistik Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeOriginator":[{"foaf_name":"Stabsstelle Sozialplanung","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/stabsstelle-sozialplanung"},{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatdeMaintainer":[{"foaf_name":"Amt f\u00fcr Stadtentwicklung und Statistik - Stadt K\u00f6ln","foaf_homepage":"https:\/\/www.stadt-koeln.de\/service\/adressen\/amt-fuer-stadtentwicklung-und-statistik"}],"dcatapapplicablelegislation":[{"rdf_resource":"http:\/\/data.europa.eu\/eli\/reg_impl\/2023\/138\/oj"}],"dcataphvdcategory":[{"rdf_resource":"http:\/\/data.europa.eu\/bna\/c_ac64a52d"}]},{"identifier":"5e9810de-68a6-4dd6-a25c-d4b213ca095c","title":"Kriminalstatistik Stadtgebiet K\u00f6ln 2014","description":"\u003Cp\u003EAuf dieser Seite stellt Ihnen die Polizei K\u00f6ln die Zahlen zur Polizeilichen Kriminalstatistik 2014 f\u00fcr das Stadtgebiet K\u00f6ln als Rohdatenbestand zur Verf\u00fcgung.\u003C\/p\u003E\n\u003Cp\u003EEine grafische Aufbereitung und weitere Statistiken k\u00f6nnen Sie hier abrufen:\u003Cbr \/\u003E\u003Ca href=\u0022http:\/\/www.polizei.nrw.de\/koeln\/kategorie__60.html\u0022\u003Ehttp:\/\/www.polizei.nrw.de\/koeln\/kategorie__60.html\u003C\/a\u003E\u00a0\u003Cbr \/\u003E\u003Ca href=\u0022http:\/\/www.koeln.polizei.nrw.de\u0022\u003Ewww.koeln.polizei.nrw.de\u003C\/a\u003E\u003Cbr \/\u003E\n\u00a0\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EInformation:\u003C\/strong\u003E\u003Cbr \/\u003E\nDie gelisteten Rohdaten entstammen folgender Datei:\u00a0\u003Ca href=\u0022https:\/\/www.polizei.nrw.de\/media\/Dokumente\/Behoerden\/Koeln\/pks-2015-koeln.pdf\u0022\u003Ehttps:\/\/www.polizei.nrw.de\/media\/Dokumente\/Behoerden\/Koeln\/pks-2015-koeln.pdf\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EQuelle: Polizei Nordrhein-Westfalen\u003C\/strong\u003E\u00a0\u003Ca href=\u0022http:\/\/www.polizei.nrw.de\/koeln\/index.html\u0022\u003Ehttp:\/\/www.polizei.nrw.de\/koeln\/index.html\u003C\/a\u003E\u003C\/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EAltersstruktur:\u003C\/strong\u003E\u003C\/p\u003E\n\u003Cp\u003EKinder \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 bis zur Vollendung des 14. Lebensjahres (es z\u00e4hlt als Stichtag f\u00fcr die Strafm\u00fcndigkeit der 14. Geburtstag)\u003C\/p\u003E\n\u003Cp\u003EJugendliche\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 15 bis unter 18 Jahre\u003C\/p\u003E\n\u003Cp\u003EHeranwachsende \u00a0\u00a0\u00a0\u00a0\u00a0 18 bis unter 21 Jahre\u003C\/p\u003E\n\u003Cp\u003EErwachsene\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 21 bis unter 60 Jahre\u003C\/p\u003E\n\u003Cp\u003ESenioren\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 60+\u003C\/p\u003E\n","keyword":["Gesetze und Justiz"],"politicalGeocodingLevelURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/Level\/municipality"}],"politicalGeocodingURI":[{"rdf_resource":"http:\/\/dcat-ap.de\/def\/politicalGeocoding\/districtKey\/05315"}],"contactPoint":[{"fn":"Polizei K\u00f6ln","hasEmail":"poststelle.koeln@polizei.nrw.de"}],"temporalmigrate":{"type":"dct:PeriodOfTime"},"publisher":{"@type":"org:Organization","foaf_name":"Polizei K\u00f6ln"},"distribution":[{"type":"dcat:Distribution","title":"Fallzahlen Gesamtkriminalitaet Stadtgebiet Koeln 2013 2014","dctModified":"2022-07-26T10:06:38+00:00","dct_lice